unit sprite_layer(
    input   uint10  pix_x,
    input   uint10  pix_x1,
    input   uint9   pix_y,
    input   uint1   pix_active,
    input   uint1   pix_end,

    output! uint8   pixel,
    output! uint1   sprite_layer_display,


    input   uint1   collision_layer_1,                                                                                          // BITMAP, EITHER, PIXEL?
    input   uint1   collision_layer_2,                                                                                          // LOWER TILEMAP PIXEL?
    input   uint1   collision_layer_3,                                                                                          // UPPER TILEMAP PIXEL?
    input   uint1   collision_layer_4,                                                                                          // OTHER SPRITE LAYER PIXEL?
    input   uint1   collision_bitmap_0,                                                                                         // BITMAP 0 PIXEL, IF DETECTING BETWEEN BITMAPS
    input   uint1   collision_bitmap_1,                                                                                         // BITMAP 1 PIXEL, IF DETECTING BETWEEN BITMAPS

    $$for i=0,31 do
        input   uint1   sprite_read_active_$i$,                                                                                 // SPRITE   ACTIVE?
        input   uint6   sprite_read_actions_$i$,                                                                                //          SIZE, ROTATE/REFLECT FLAGS
        input   int11   sprite_read_x_$i$,                                                                                      //          X COORDINATE
        input   int10   sprite_read_y_$i$,                                                                                      //          Y COORDINATE
        input   uint3   sprite_read_tile_$i$,                                                                                   //          TILE NUMBER, 0 - 7

        output uint32 collision_$i$,                                                                                            // SPRITE TO SPRITE COLLISION
        output uint6  layer_collision_$i$,                                                                                      // SPRITE TO LAYER COLLISION
    $$end

    input   uint11  writerpixel,                                                                                                // FOR WRITING SPRITE TILEMAPS
    input   uint8   writeData,
    input   uint16  wenable1
) <reginputs> {
    $$for i=0,15 do
    dualport_bram uint8 tiles_$i$[2048] = uninitialised;                                                                        // Sprite Tiles - 16 x 16 x 8 in RRGGGBBM colour

    sprite_generator SPRITE_$i$(                                                                                                // SPRITE GENERATORS, 0 - 15, USING TILE0
        tiles <:> tiles_$i$,

        pix_x <: pix_x,
        pix_x1 <: pix_x1,
        pix_y <: pix_y,

        sprite_active <: sprite_read_active_$i$,
        sprite_actions <: sprite_read_actions_$i$,
        sprite_x <: sprite_read_x_$i$,
        sprite_y <: sprite_read_y_$i$,
        sprite_tile_number <: sprite_read_tile_$i$,
    );
    sprite1_generator SPRITE_$i+16$(                                                                                            // SPRITE GENERATORS, 16 - 31, USING TILE1
        tiles <:> tiles_$i$,

        pix_x <: pix_x,
        pix_x1 <: pix_x1,
        pix_y <: pix_y,

        sprite_active <: sprite_read_active_$i+16$,
        sprite_actions <: sprite_read_actions_$i+16$,
        sprite_x <: sprite_read_x_$i+16$,
        sprite_y <: sprite_read_y_$i+16$,
        sprite_tile_number <: sprite_read_tile_$i+16$,

        writerpixel <: writerpixel,
        writeData <: writeData,
        wenable1 <: wenable1[$i$,1]
    );
    uint32  detect_collision_$i$ = uninitialised;                                                                               // Collision detection flag sprite to sprite
    uint6   detect_layer_$i$ = uninitialised;                                                                                   // Collision detection flag sprite to other layers
    uint32  detect_collision_$i+16$ = uninitialised;                                                                            // Collision detection flag sprite to sprite
    uint6   detect_layer_$i+16$ = uninitialised;                                                                                // Collision detection flag sprite to other layers
    $$end

    algorithm <autorun> {
        uint1   dooutput = 0;
        uint32  sprite_visible <: {                                                                                             // SPRITE VISIBLE FLAGS AT EACH PIXEL
                                    SPRITE_31.pix_visible, SPRITE_30.pix_visible, SPRITE_29.pix_visible,
                                    SPRITE_28.pix_visible, SPRITE_27.pix_visible, SPRITE_26.pix_visible,
                                    SPRITE_25.pix_visible, SPRITE_24.pix_visible, SPRITE_23.pix_visible,
                                    SPRITE_22.pix_visible, SPRITE_21.pix_visible, SPRITE_20.pix_visible,
                                    SPRITE_19.pix_visible, SPRITE_18.pix_visible, SPRITE_17.pix_visible,
                                    SPRITE_16.pix_visible, SPRITE_15.pix_visible, SPRITE_14.pix_visible,
                                    SPRITE_13.pix_visible, SPRITE_12.pix_visible, SPRITE_11.pix_visible,
                                    SPRITE_10.pix_visible, SPRITE_9.pix_visible,  SPRITE_8.pix_visible,
                                    SPRITE_7.pix_visible,  SPRITE_6.pix_visible,  SPRITE_5.pix_visible,
                                    SPRITE_4.pix_visible,  SPRITE_3.pix_visible,  SPRITE_2.pix_visible,
                                    SPRITE_1.pix_visible, SPRITE_0.pix_visible
                                  };
        uint6   layer_visible <: {
                                    collision_bitmap_1, collision_bitmap_0,                                                     // BITMAP 1 AND BITMAP 0 VISIBLE AT PIXEL
                                    collision_layer_1, collision_layer_2, collision_layer_3, collision_layer_4                  // BITMAP, TILEMAP L, TILEMAP U, OTHER SPRITE VISIBLE AT PIXEL
                                 };
        while(1) {
            sprite_layer_display = pix_active & |sprite_visible;

            if( dooutput ) {
                $$for i=0,31 do
                    collision_$i$ = detect_collision_$i$; layer_collision_$i$ = detect_layer_$i$;                               // REACHED VBLANK, OUTPUT AND RESET COLLISION FLAGS
                    detect_collision_$i$ = 0; detect_layer_$i$ = 0;
                $$end
            } else {
                if( pix_active ) {
                    $$for i=0,31 do
                    if( SPRITE_$i$.pix_visible ) {                                                                              // IS SPRITE 0 TO 31 VISIBLE?
                        sprite_layer_display = 1; pixel = SPRITE_$i$.pixel;                                                     //  SET DISPLAY

                        detect_collision_$i$ = detect_collision_$i$ | sprite_visible;
                        detect_layer_$i$ = detect_layer_$i$ | layer_visible;
                    }
                    $$end
                }
            }

            dooutput = pix_end;
        }
    }
}

unit sprite_generator(
    input   uint10  pix_x,
    input   uint10  pix_x1,
    input   uint9   pix_y,
    input   uint1   sprite_active,
    input   uint6   sprite_actions,
    input   int11   sprite_x,
    input   int10   sprite_y,
    input   uint3   sprite_tile_number,
    dualport_bram_port0 tiles,
    output! uint1   pix_visible,
    output! uint8   pixel
) <reginputs> {
    int11   x <: { 1b0, pix_x };                                                                                                // X COORDINATE
    int11   xspritex <: ( { 1b0, pix_x1 } - sprite_x );                                                                         // X PIXEL IN THE SPRITE TILE
    int10   y <: { 1b0, pix_y };
    int10   yspritey <: ( y - sprite_y );                                                                                       // Y CORRDINATE
    int11   xspriteshift <: sprite_actions[5,1] ? ( xspritex << sprite_actions[3,2] ) : ( xspritex >>> sprite_actions[3,2] );   // SCALE X PIXEL
    int10   yspriteshift <: sprite_actions[5,1] ? ( yspritey << sprite_actions[3,2] ) : ( yspritey >>> sprite_actions[3,2] );   // SCALE Y PIXEL
    uint4   revx <: ~xspriteshift;
    uint4   revy <: ~yspriteshift;
    uint1   action00 <: ( ~|sprite_actions[0,2] );                                                                              // CHECK ACTION FLAGS FOR ROTATION
    uint1   action01 <: ( sprite_actions[0,2] == 2b01 );
    uint1   action10 <: ( sprite_actions[0,2] == 2b10 );

    uint4 xinsprite <: sprite_actions[2,1] ? action00 ? xspriteshift : action01 ? yspriteshift : action10 ? revx : revy :       // Calculate position in sprite, handling rotation/reflection
                       sprite_actions[0,1] ? revx : xspriteshift;
    uint4 yinsprite <: sprite_actions[2,1] ? action00 ? yspriteshift : action01 ? revx : action10 ? revy : xspriteshift :
                       sprite_actions[1,1] ? revy : yspriteshift;

    uint7 spritesize <: sprite_actions[5,1] ? ( 16 >> sprite_actions[3,2] ) : ( 16 << sprite_actions[3,2] );                    // SIZE OF SPRITE 16,8,4,2 or 16,32,64,128  PIXELS
    uint1 xinrange <: ( __signed(x) >= __signed(sprite_x) ) & ( __signed(x) < __signed( sprite_x + spritesize ) );              // IS ON SCREEN X?
    uint1 yinrange <: ( __signed(y) >= __signed(sprite_y) ) & ( __signed(y) < __signed( sprite_y + spritesize ) );              // IS ON SCREEN Y?

    tiles.addr0 := { sprite_tile_number, yinsprite, xinsprite };                                                                // READ ADDRESS FOR SPRITE TILE
    pixel := tiles.rdata0;                                                                                                      // OUTPUT PIXEL COLOUR
    pix_visible := sprite_active & xinrange & yinrange & ( tiles.rdata0 != 64 );                                                // Determine if pixel is visible
}

unit sprite1_generator(
    input   uint10  pix_x,
    input   uint10  pix_x1,
    input   uint9   pix_y,
    input   uint1   sprite_active,
    input   uint6   sprite_actions,
    input   int11   sprite_x,
    input   int10   sprite_y,
    input   uint3   sprite_tile_number,
    dualport_bram_port1 tiles,
    output! uint1   pix_visible,
    output! uint8   pixel,

    input   uint11  writerpixel,
    input   uint8   writeData,
    input   uint1   wenable1
) <reginputs> {
    int11   x <: { 1b0, pix_x };                                                                                                // X COORDINATE
    int11   xspritex <: ( { 1b0, pix_x1 } - sprite_x );                                                                                      // X PIXEL IN THE SPRITE TILE
    int10   y <: { 1b0, pix_y };
    int10   yspritey <: ( y - sprite_y );                                                                                       // Y CORRDINATE
    int11   xspriteshift <: sprite_actions[5,1] ? ( xspritex << sprite_actions[3,2] ) : ( xspritex >>> sprite_actions[3,2] );   // SCALE X PIXEL
    int10   yspriteshift <: sprite_actions[5,1] ? ( yspritey << sprite_actions[3,2] ) : ( yspritey >>> sprite_actions[3,2] );   // SCALE Y PIXEL
    uint4   revx <: ~xspriteshift;
    uint4   revy <: ~yspriteshift;
    uint1   action00 <: ( ~|sprite_actions[0,2] );                                                                              // CHECK ACTION FLAGS FOR ROTATION
    uint1   action01 <: ( sprite_actions[0,2] == 2b01 );
    uint1   action10 <: ( sprite_actions[0,2] == 2b10 );

    uint4 xinsprite <: sprite_actions[2,1] ? action00 ? xspriteshift : action01 ? yspriteshift : action10 ? revx : revy :       // Calculate position in sprite, handling rotation/reflection
                       sprite_actions[0,1] ? revx : xspriteshift;
    uint4 yinsprite <: sprite_actions[2,1] ? action00 ? yspriteshift : action01 ? revx : action10 ? revy : xspriteshift :
                       sprite_actions[1,1] ? revy : yspriteshift;

    uint7 spritesize <: sprite_actions[5,1] ? ( 16 >> sprite_actions[3,2] ) : ( 16 << sprite_actions[3,2] );                    // SIZE OF SPRITE 16,8,4,2 or 16,32,64,128  PIXELS
    uint1 xinrange <: ( __signed(x) >= __signed(sprite_x) ) & ( __signed(x) < __signed( sprite_x + spritesize ) );              // IS ON SCREEN X?
    uint1 yinrange <: ( __signed(y) >= __signed(sprite_y) ) & ( __signed(y) < __signed( sprite_y + spritesize ) );              // IS ON SCREEN Y?

    tiles.addr1 := wenable1 ? writerpixel : { sprite_tile_number, yinsprite, xinsprite };
    tiles.wdata1 := writeData;
    tiles.wenable1 := wenable1;

    pixel := tiles.rdata1;                                                                                                      // OUTPUT PIXEL COLOUR
    pix_visible := sprite_active & xinrange & yinrange & ( tiles.rdata1 != 64 );                                   // Determine if pixel is visible
}

unit sprite_layer_writer(
    // For setting sprite characteristics
    input   uint5   sprite_set_number,
    input   uint13  sprite_write_value,
    input   uint3   sprite_layer_write,

    // For reading sprite characteristics
    $$for i=0,31 do
        output  uint1   sprite_read_active_$i$,
        output  uint6   sprite_read_actions_$i$,
        output  int11   sprite_read_x_$i$,
        output  int10   sprite_read_y_$i$,
        output  uint3   sprite_read_tile_$i$,
    $$end
) <reginputs> {
    uint1   sprite_active[32] = uninitialised;                                                                                  // SPRITE ACTIVE FLAG
    uint6   sprite_actions[32] = uninitialised;                                                                                 // SPRITE ROTATION/REFLECTION/SIZE FLAGS
    int11   sprite_x[32] = uninitialised;                                                                                       // SPRITE X COORDINATES
    int10   sprite_y[32] = uninitialised;                                                                                       // SPRITE Y COORDINATES

    int11   sprite_offscreen_negative <:: sprite_actions[ sprite_set_number ][5,1] ?                                            // CALCULATE NEGATIVE VALUE FOR SPRITE TO BE OFFSCREEN
                                                                    ( -16 >>> sprite_actions[ sprite_set_number ][3,2] ) :
                                                                    ( -16 << sprite_actions[ sprite_set_number ][3,2] );

    uint1   sprite_off_left <:: ( __signed( sprite_x[ sprite_set_number ] ) < __signed( sprite_offscreen_negative ) );          // IS SPRITE OFFSCREEN LEFT?
    uint1   sprite_off_top <:: ( __signed( sprite_y[ sprite_set_number ] ) < __signed( sprite_offscreen_negative ) );           // IS SPRITE OFFSCREEN TOP
    uint1   sprite_offscreen_x <:: sprite_off_left | ( __signed( sprite_x[ sprite_set_number  ] ) > __signed(640) );            // IS SPRITE OFFSCREEN X
    uint1   sprite_offscreen_y <:: sprite_off_top | ( __signed( sprite_y[ sprite_set_number ] ) > __signed(480) );              // IS SPRITE OFFSCREEN Y

    uint3   sprite_tile_number[32] = uninitialised;                                                                             // SPRITE DISPLAY TILE NUMBER

    $$for i=0,31 do
        sprite_read_active_$i$ := sprite_active[$i$];
        sprite_read_actions_$i$ := sprite_actions[$i$];
        sprite_read_x_$i$ := sprite_x[$i$];
        sprite_read_y_$i$ := sprite_y[$i$];
        sprite_read_tile_$i$ := sprite_tile_number[$i$];
    $$end

    algorithm <autorun> { while(1) {
        // SET ATTRIBUTES + PERFORM UPDATE
        switch( sprite_layer_write ) {
            case 0: {}
            case 1: { sprite_active[ sprite_set_number ] = sprite_write_value[0,1]; }                                           // SET ACTIVE
            case 2: { sprite_actions[ sprite_set_number ] = sprite_write_value[0,6]; }                                          // SET ROTATION/REFLECTION/SIZE FLAGS
            case 4: { sprite_x[ sprite_set_number ] = sprite_write_value[0,11]; }                                               // SET X COORDINATE
            case 5: { sprite_y[ sprite_set_number ] = sprite_write_value[0,10]; }                                               // SET Y COORDINATE
            case 6: { sprite_tile_number[ sprite_set_number ] = sprite_write_value[0,3]; }                                      // SET TILE NUMBER
            case 7: {                                                                                                           // PERFORM SPRITE UPDATE
                sprite_active[ sprite_set_number ] = ( ( sprite_write_value[12,1] & sprite_offscreen_y ) |                      // IF OFFSCREEN Y AND NOT WRAP
                                                     ( sprite_write_value[11,1] & sprite_offscreen_x ) ) ? 0 :                  //  OR OFFSCREEN X AND NOT WRAP -> INACTIVE
                                                     sprite_active[ sprite_set_number ];                                        //  ELSE PRESENT ACTIVE STATE
                sprite_tile_number[ sprite_set_number ] = sprite_tile_number[ sprite_set_number ] +                             // INCREMENT TILE NUMBER?
                                                          sprite_write_value[10,1];
                sprite_x[ sprite_set_number ] = sprite_offscreen_x ? ( sprite_off_left ? __signed(640) :                        // UPDATE X COORDINATE
                                                                                          sprite_offscreen_negative | 1 ) :
                                                sprite_x[ sprite_set_number ] + { {7{spriteupdate( sprite_write_value ).dxsign}}, spriteupdate( sprite_write_value ).dx };
                sprite_y[ sprite_set_number ] = sprite_offscreen_y ? ( sprite_off_top ? __signed(480) :                         // UPDATE Y COORDINATE
                                                                                        sprite_offscreen_negative | 1 ) :
                                                sprite_y[ sprite_set_number ] + { {6{spriteupdate( sprite_write_value ).dysign}}, spriteupdate( sprite_write_value ).dy };
            }
        }
    } }
}

