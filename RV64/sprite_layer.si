unit sprite_layer(
    input   uint10  pix_x,                                                                                                      // DISPLAY INPUTS   X
    input   uint10  pix_x1,                                                                                                     //                  X+1 FOR PRE-FETCHING
    input   uint9   pix_y,                                                                                                      //                  Y
    input   uint1   pix_active,                                                                                                 //                  ACTIVE
    input   uint1   pix_end,                                                                                                    //                  ( 639, 479 )

    output! uint8   pixel,                                                                                                      // DISPLAY OUTPUTS  SELECTED PIXEL FOR SPRITE LAYER
    output! uint1   sprite_layer_display,                                                                                       //                  PIXEL TO DISPLAY?

    input   uint1   collision_layer_1,                                                                                          // BITMAP, EITHER, PIXEL?
    input   uint1   collision_layer_2,                                                                                          // LOWER TILEMAP PIXEL?
    input   uint1   collision_layer_3,                                                                                          // UPPER TILEMAP PIXEL?
    input   uint1   collision_layer_4,                                                                                          // OTHER SPRITE LAYER PIXEL?
    input   uint1   collision_bitmap_0,                                                                                         // BITMAP 0 PIXEL, IF DETECTING BETWEEN BITMAPS
    input   uint1   collision_bitmap_1,                                                                                         // BITMAP 1 PIXEL, IF DETECTING BETWEEN BITMAPS

    $$for i=0,31 do
        input   uint1   sprite_active_$i$,                                                                                      // SPRITE   ACTIVE?
        input   uint6   sprite_actions_$i$,                                                                                     //          SIZE, ROTATE/REFLECT FLAGS
        input   uint7   sprite_size_$i$,                                                                                        //          SIZE IN PIXELS
        input   int11   sprite_x_$i$,                                                                                           //          X COORDINATE
        input   int10   sprite_y_$i$,                                                                                           //          Y COORDINATE
        input   uint3   sprite_tile_$i$,                                                                                        //          TILE NUMBER, 0 - 7

        output uint32 collision_$i$,                                                                                            // SPRITE TO SPRITE COLLISION
        output uint6  layer_collision_$i$,                                                                                      // SPRITE TO LAYER COLLISION
    $$end

    input   uint11  writerpixel,                                                                                                // FOR WRITING SPRITE TILEMAPS  PIXEL NUMBER
    input   uint8   writeData,                                                                                                  //                              PIXEL
    input   uint16  wenable1                                                                                                    //                              WRITE ENDABLE FLAGS
) <reginputs> {
    int11   x <: { 1b0, pix_x };                                                                                                // SIGN EXTEND  X
    int11   x1 <: { 1b0, pix_x1 };                                                                                              //              X+1
    int10   y <: { 1b0, pix_y };                                                                                                //              Y

    $$for i=0,15 do
    dualport_bram uint8 tiles_$i$[2048] = uninitialised;                                                                        // Sprite Tiles - 16 x 16 x 8 in RRGGGBBM colour

    sprite_generator SPRITE_$i*2$(                                                                                                // SPRITE GENERATORS, 0 - 15, USING TILE0
        tiles <:> tiles_$i$,

        x <: x,
        x1 <: x1,
        y <: y,

        sprite_active <: sprite_active_$i*2$,
        sprite_actions <: sprite_actions_$i*2$,
        sprite_size <: sprite_size_$i*2$,
        sprite_x <: sprite_x_$i*2$,
        sprite_y <: sprite_y_$i*2$,
        sprite_tile_number <: sprite_tile_$i*2$,
    );
    sprite1_generator SPRITE_$i*2+1$(                                                                                            // SPRITE GENERATORS, 16 - 31, USING TILE1
        tiles <:> tiles_$i$,

        x <: x,
        x1 <: x1,
        y <: y,

        sprite_active <: sprite_active_$i*2+1$,
        sprite_actions <: sprite_actions_$i*2+1$,
        sprite_size <: sprite_size_$i*2+1$,
        sprite_x <: sprite_x_$i*2+1$,
        sprite_y <: sprite_y_$i*2+1$,
        sprite_tile_number <: sprite_tile_$i*2+1$,

        writerpixel <: writerpixel,
        writeData <: writeData,
        wenable1 <: wenable1[$i$,1]
    );
    uint32  detect_collision_$i*2$ = uninitialised;                                                                               // Collision detection flag sprite to sprite (0-15)
    uint32  detect_collision_$i*2+1$ = uninitialised;                                                                            // Collision detection flag sprite to sprite (16-31)
    uint6   detect_layer_$i*2$ = uninitialised;                                                                                   // Collision detection flag sprite to other layers (0-15)
    uint6   detect_layer_$i*2+1$ = uninitialised;                                                                                // Collision detection flag sprite to other layers (16-31)
    $$end

    algorithm <autorun> {
        uint1   dooutput = uninitialised;                                                                                                       // START OF VBLANK? OUTPUT FRAME COLLISIONS
        uint32  sprite_visible <: {                                                                                                 // SPRITE VISIBLE FLAGS AT EACH PIXEL
                                    SPRITE_31.pix_visible, SPRITE_30.pix_visible, SPRITE_29.pix_visible,
                                    SPRITE_28.pix_visible, SPRITE_27.pix_visible, SPRITE_26.pix_visible,
                                    SPRITE_25.pix_visible, SPRITE_24.pix_visible, SPRITE_23.pix_visible,
                                    SPRITE_22.pix_visible, SPRITE_21.pix_visible, SPRITE_20.pix_visible,
                                    SPRITE_19.pix_visible, SPRITE_18.pix_visible, SPRITE_17.pix_visible,
                                    SPRITE_16.pix_visible, SPRITE_15.pix_visible, SPRITE_14.pix_visible,
                                    SPRITE_13.pix_visible, SPRITE_12.pix_visible, SPRITE_11.pix_visible,
                                    SPRITE_10.pix_visible, SPRITE_9.pix_visible,  SPRITE_8.pix_visible,
                                    SPRITE_7.pix_visible,  SPRITE_6.pix_visible,  SPRITE_5.pix_visible,
                                    SPRITE_4.pix_visible,  SPRITE_3.pix_visible,  SPRITE_2.pix_visible,
                                    SPRITE_1.pix_visible, SPRITE_0.pix_visible
                                    };
        uint6   layer_visible <: {
                                    collision_bitmap_1, collision_bitmap_0,                                                         // BITMAP 1 AND BITMAP 0 VISIBLE AT PIXEL
                                    collision_layer_1, collision_layer_2, collision_layer_3, collision_layer_4                      // BITMAP, TILEMAP L, TILEMAP U, OTHER SPRITE VISIBLE AT PIXEL
                                };

        while(1) {
            sprite_layer_display = pix_active & |sprite_visible;                                                                    // PIXEL TO DISPLAY?

            if( dooutput ) {
                $$for i=0,31 do
                    collision_$i$ = detect_collision_$i$; layer_collision_$i$ = detect_layer_$i$;                                   // REACHED VBLANK, OUTPUT COLLISION FLAGS
                    detect_collision_$i$ = 0; detect_layer_$i$ = 0;                                                                 //  RESET COLLISION FLAGS
                $$end
            } else {
                $$for i=0,31 do
                if( SPRITE_$i$.pix_visible ) {                                                                                      // IS SPRITE 0 TO 31 VISIBLE?
                    pixel = SPRITE_$i$.pixel;                                                                                       //  SET DISPLAY PIXEL

                    detect_collision_$i$ = detect_collision_$i$ | ( pix_active ? sprite_visible : 0 );                              //  UPDATE SPRITE TO SPRITE COLLISIONS
                    detect_layer_$i$ = detect_layer_$i$ | ( pix_active ? layer_visible : 0 );                                       //  UPDATE SPRITE TO LAYER COLLISIONS
                }
                $$end
            }

            dooutput = pix_end;                                                                                                     // CHECK FOR START OF VBLANK
        }
    }
}

unit sprite_transform(                                                                                                          // TRANSFORM X,Y FOR REFLECTION/ROTATION IN SPRITE TILE
    input   uint4   xspriteshift,                                                                                               // X COORDINATE IN SPRITE TILE
    input   uint4   yspriteshift,                                                                                               // Y COORDINATE IN SPRITE TILE
    input   uint3   actions,                                                                                                    // REFLECTION/ROTATION FLAGS
    output! uint4   x,                                                                                                          // TRANSFORMED X COORDINATE
    output! uint4   y                                                                                                           // TRANSFORMED Y COORDINATE
) {
    uint4   revx <: ~xspriteshift;                                                                                              // X REVERSE FOR REFLECTION/ROTATION
    uint4   revy <: ~yspriteshift;                                                                                              // Y REVERSE FOR REFLECTION/ROTATION
    uint1   action00 <:: ( ~|actions[0,2] );                                                                                    // CHECK ACTION FLAGS FOR REFLECTION/ROTATION
    uint1   action01 <:: ( actions[0,2] == 2b01 );
    uint1   action10 <:: ( actions[0,2] == 2b10 );

    x := actions[2,1] ? action00 ? xspriteshift : action01 ? yspriteshift : action10 ? revx : revy :                         // CALCULATE X IN TILE FOR  ROTATION
                        actions[0,1] ? revx : xspriteshift;                                                                  //                          REFLECTION
    y := actions[2,1] ? action00 ? yspriteshift : action01 ? revx : action10 ? revy : xspriteshift :                         // CALCULATE Y IN TILE FOR  ROTATION
                        actions[1,1] ? revy : yspriteshift;                                                                  //                          REFLECTION
}

unit sprite_generator(
    input   uint11  x,
    input   uint11  x1,
    input   uint10  y,
    input   uint1   sprite_active,
    input   uint6   sprite_actions,
    input   uint7   sprite_size,
    input   int11   sprite_x,
    input   int10   sprite_y,
    input   uint3   sprite_tile_number,
    dualport_bram_port0 tiles,
    output! uint1   pix_visible,
    output! uint8   pixel
) <reginputs> {
    int11   xspritex <: ( x1 - sprite_x );                                                                                      // X PIXEL IN THE SPRITE TILE
    int10   yspritey <: ( y - sprite_y );                                                                                       // Y PIXEL IN THE SPRITE TILE
    uint1   xinrange <: ( __signed(x) >= __signed(sprite_x) ) & ( __signed(x) < __signed( sprite_x + sprite_size ) );           // IS ON SCREEN X?
    uint1   yinrange <: ( __signed(y) >= __signed(sprite_y) ) & ( __signed(y) < __signed( sprite_y + sprite_size ) );           // IS ON SCREEN Y?

    sprite_transform TRANSFORM( actions <: sprite_actions );                                                                    // PERFORM ROTATION/REFLECTION
    TRANSFORM.xspriteshift := sprite_actions[5,1] ? ( xspritex << sprite_actions[3,2] ) : ( xspritex >>> sprite_actions[3,2] ); // SCALE X PIXEL
    TRANSFORM.yspriteshift := sprite_actions[5,1] ? ( yspritey << sprite_actions[3,2] ) : ( yspritey >>> sprite_actions[3,2] ); // SCALE Y PIXEL

    tiles.addr0 := { sprite_tile_number, TRANSFORM.y, TRANSFORM.x };                                                            // READ ADDRESS FOR SPRITE TILE
    pixel := tiles.rdata0;                                                                                                      // OUTPUT PIXEL COLOUR
    pix_visible := sprite_active & xinrange & yinrange & ( tiles.rdata0 != 64 );                                                // Determine if pixel is visible
}

unit sprite1_generator(
    input   uint11  x,
    input   uint11  x1,
    input   uint10  y,
    input   uint1   sprite_active,
    input   uint6   sprite_actions,
    input   uint7   sprite_size,
    input   int11   sprite_x,
    input   int10   sprite_y,
    input   uint3   sprite_tile_number,
    dualport_bram_port1 tiles,
    output! uint1   pix_visible,
    output! uint8   pixel,

    input   uint11  writerpixel,
    input   uint8   writeData,
    input   uint1   wenable1
) <reginputs> {
    int11   xspritex <: ( x1 - sprite_x );                                                                                      // X PIXEL IN THE SPRITE TILE
    int10   yspritey <: ( y - sprite_y );                                                                                       // Y PIXEL IN THE SPRITE TILE
    uint1   xinrange <: ( __signed(x) >= __signed(sprite_x) ) & ( __signed(x) < __signed( sprite_x + sprite_size ) );           // IS ON SCREEN X?
    uint1   yinrange <: ( __signed(y) >= __signed(sprite_y) ) & ( __signed(y) < __signed( sprite_y + sprite_size ) );           // IS ON SCREEN Y?

    sprite_transform TRANSFORM( actions <: sprite_actions );                                                                    // PERFORM ROTATION/REFLECTION
    TRANSFORM.xspriteshift := sprite_actions[5,1] ? ( xspritex << sprite_actions[3,2] ) : ( xspritex >>> sprite_actions[3,2] ); // SCALE X PIXEL
    TRANSFORM.yspriteshift := sprite_actions[5,1] ? ( yspritey << sprite_actions[3,2] ) : ( yspritey >>> sprite_actions[3,2] ); // SCALE Y PIXEL

    tiles.addr1 := wenable1 ? writerpixel : { sprite_tile_number, TRANSFORM.y, TRANSFORM.x };                                   // WRITE/READ ADDRESS FOR SPRITE TILE
    tiles.wdata1 := writeData;                                                                                                  // PIXEL TO WRITE
    tiles.wenable1 := wenable1;                                                                                                 // PIXEL WRITE ENABLE

    pixel := tiles.rdata1;                                                                                                      // OUTPUT PIXEL COLOUR
    pix_visible := sprite_active & xinrange & yinrange & ( tiles.rdata1 != 64 );                                                // Determine if pixel is visible
}

unit sprite_layer_writer(
    // For setting sprite characteristics
    input   uint5   sprite_set_number,
    input   uint13  sprite_write_value,
    input   uint3   sprite_layer_write,

    // For reading sprite characteristics
    $$for i=0,31 do
        output  uint1   sprite_read_active_$i$,
        output  uint6   sprite_read_actions_$i$,
        output  uint7   sprite_size_$i$,
        output  int11   sprite_read_x_$i$,
        output  int10   sprite_read_y_$i$,
        output  uint3   sprite_read_tile_$i$,
    $$end
) <reginputs> {
    algorithm <autorun> {
        uint7   sprite_sizes[8] = { 16, 32, 64, 128, 16, 8, 4, 2 };                                                             // POSSIBLE SIZES OF SPRITES

        uint1   sprite_active[32] = uninitialised;                                                                              // SPRITE ACTIVE FLAG
        uint6   sprite_actions[32] = uninitialised;                                                                             // SPRITE ROTATION/REFLECTION/SIZE FLAGS
        int11   sprite_x[32] = uninitialised;                                                                                   // SPRITE X COORDINATES
        int10   sprite_y[32] = uninitialised;                                                                                   // SPRITE Y COORDINATES
        uint3   sprite_tile_number[32] = uninitialised;                                                                         // SPRITE DISPLAY TILE NUMBER

        while(1) {
            $$for i=0,31 do
                sprite_read_active_$i$ = sprite_active[$i$];
                sprite_read_actions_$i$ = sprite_actions[$i$];
                sprite_size_$i$ = sprite_sizes[ sprite_actions[$i$][3,3] ];
                sprite_read_x_$i$ = sprite_x[$i$];
                sprite_read_y_$i$ = sprite_y[$i$];
                sprite_read_tile_$i$ = sprite_tile_number[$i$];
            $$end

            switch( sprite_layer_write ) {
                default: {}
                case 1: { sprite_active[ sprite_set_number ] = sprite_write_value[0,1]; }                                       // SET ACTIVE
                case 2: { sprite_actions[ sprite_set_number ] = sprite_write_value[0,6]; }                                      // SET ROTATION/REFLECTION/SIZE FLAGS
                case 4: { sprite_x[ sprite_set_number ] = sprite_write_value[0,11]; }                                           // SET X COORDINATE
                case 5: { sprite_y[ sprite_set_number ] = sprite_write_value[0,10]; }                                           // SET Y COORDINATE
                case 6: { sprite_tile_number[ sprite_set_number ] = sprite_write_value[0,3]; }                                  // SET TILE NUMBER
            }
        }
    }
}

