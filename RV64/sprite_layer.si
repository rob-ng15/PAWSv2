unit sprite_layer(
    input   uint10  pix_x,                                                                                                      // DISPLAY INPUTS   X
    input   uint10  pix_x1,                                                                                                     //                  X+1 FOR PRE-FETCHING
    input   uint9   pix_y,                                                                                                      //                  Y
    input   uint1   pix_active,                                                                                                 //                  ACTIVE
    input   uint1   pix_end,                                                                                                    //                  ( 639, 479 )

    output! uint8   pixel,                                                                                                      // DISPLAY OUTPUTS  SELECTED PIXEL FOR SPRITE LAYER
    output! uint1   sprite_layer_display,                                                                                       //                  PIXEL TO DISPLAY?

    input   uint1   collision_layer_1,                                                                                          // BITMAP, EITHER, PIXEL?
    input   uint1   collision_layer_2,                                                                                          // LOWER TILEMAP PIXEL?
    input   uint1   collision_layer_3,                                                                                          // UPPER TILEMAP PIXEL?
    input   uint1   collision_layer_4,                                                                                          // OTHER SPRITE LAYER PIXEL?
    input   uint1   collision_bitmap_0,                                                                                         // BITMAP 0 PIXEL, IF DETECTING BETWEEN BITMAPS
    input   uint1   collision_bitmap_1,                                                                                         // BITMAP 1 PIXEL, IF DETECTING BETWEEN BITMAPS

    input   uint$32*1$  sprite_active,                                                                                          // SPRITE   ACTIVE?
    input   uint$32*6$  sprite_actions,                                                                                         //          ACTIONS SCALE, ROTATION, REFLECTION
    input   uint$32*3$  sprite_tile,                                                                                            //          TILE NUMBER, 0 - 7
    input   uint$32*11$ sprite_x,                                                                                               //          X COORDINATE
    input   uint$32*10$ sprite_y,                                                                                               //          Y COORDINATE
    input   uint$32*7$  sprite_size,                                                                                            //          SIZE IN PIXELS

    output  uint$32*32$  sprite_collision,                                                                                      // SPRITE TO SPRITE COLLISION
    output  uint$32*6$   sprite_layer_collision,                                                                                // SPRITE TO LAYER COLLISION

    input   uint11  writerpixel,                                                                                                // FOR WRITING SPRITE TILEMAPS  PIXEL NUMBER
    input   uint8   WDATA,                                                                                                      //                              PIXEL
    input   uint16  wenable1                                                                                                    //                              WRITE ENDABLE FLAGS
) {
    $$for i=0,15 do
    dualport_bram uint8 tiles_$i$[2048] = uninitialised;                                                                        // Sprite Tiles - 16 x 16 x 8 in RRGGGBBM colour

    sprite_generator SPRITE_$i*2$(                                                                                              // SPRITE GENERATORS, EVEN SPRITES, USING TILE0
        tiles <:> tiles_$i$,
        x <: pix_x,
        x1 <: pix_x1,
        y <: pix_y,

        sprite_active <: sprite_active[$i*2$,1],
        sprite_actions <: sprite_actions[$i*2*6$,6],
        sprite_size <: sprite_size[$i*2*7$,7],
        sprite_x <: sprite_x[$i*2*11$,11],
        sprite_y <: sprite_y[$i*2*10$,10],
        sprite_tile_number <: sprite_tile[$i*2*3$,3],
    );
    sprite1_generator SPRITE_$i*2+1$(                                                                                           // SPRITE GENERATORS, ODD SPRITES, USING TILE1
        tiles <:> tiles_$i$,
        x <: pix_x,
        x1 <: pix_x1,
        y <: pix_y,

        sprite_active <: sprite_active[$i*2+1$,1],
        sprite_actions <: sprite_actions[$(i*2+1)*6$,6],
        sprite_size <: sprite_size[$(i*2+1)*7$,7],
        sprite_x <: sprite_x[$(i*2+1)*11$,11],
        sprite_y <: sprite_y[$(i*2+1)*10$,10],
        sprite_tile_number <: sprite_tile[$(i*2+1)*3$,3],

        writerpixel <: writerpixel,
        WDATA <: WDATA,
        wenable1 <: wenable1[$i$,1]
    );
    $$end

    uint32  sprite_visible <: {                                                                                                 // SPRITE VISIBLE FLAGS AT EACH PIXEL
                                SPRITE_31.pix_visible, SPRITE_30.pix_visible, SPRITE_29.pix_visible,
                                SPRITE_28.pix_visible, SPRITE_27.pix_visible, SPRITE_26.pix_visible,
                                SPRITE_25.pix_visible, SPRITE_24.pix_visible, SPRITE_23.pix_visible,
                                SPRITE_22.pix_visible, SPRITE_21.pix_visible, SPRITE_20.pix_visible,
                                SPRITE_19.pix_visible, SPRITE_18.pix_visible, SPRITE_17.pix_visible,
                                SPRITE_16.pix_visible, SPRITE_15.pix_visible, SPRITE_14.pix_visible,
                                SPRITE_13.pix_visible, SPRITE_12.pix_visible, SPRITE_11.pix_visible,
                                SPRITE_10.pix_visible, SPRITE_9.pix_visible,  SPRITE_8.pix_visible,
                                SPRITE_7.pix_visible,  SPRITE_6.pix_visible,  SPRITE_5.pix_visible,
                                SPRITE_4.pix_visible,  SPRITE_3.pix_visible,  SPRITE_2.pix_visible,
                                SPRITE_1.pix_visible, SPRITE_0.pix_visible
                                };

    sprite_layer_display := pix_active & |sprite_visible;                                                                       // PIXEL TO DISPLAY?

    always {
        $$for i=0,15 do
        uint32  detect_collision_$i*2$ = uninitialised;                                                                         // Collision detection flag sprite to sprite (0-15)
        uint32  detect_collision_$i*2+1$ = uninitialised;                                                                       // Collision detection flag sprite to sprite (16-31)
        uint6   detect_layer_$i*2$ = uninitialised;                                                                             // Collision detection flag sprite to other layers (0-15)
        uint6   detect_layer_$i*2+1$ = uninitialised;                                                                           // Collision detection flag sprite to other layers (16-31)
        $$end
        uint1   dooutput = uninitialised;                                                                                       // START OF VBLANK? OUTPUT FRAME COLLISIONS

        if( dooutput ) {
            sprite_collision = {                                                                                                // OUTPUT SPRITE-TO-SPRITE COLLISION FLAGS
                $$for i=0,30 do
                detect_collision_$31-i$,
                $$end
                detect_collision_0
            };

            sprite_layer_collision = {                                                                                          // OUTPUT SPRITE-TO-LAYER COLLISION FLAGS
                $$for i=0,30 do
                detect_layer_$31-i$,
                $$end
                detect_layer_0
            };
            $$for i=0,31 do
                detect_collision_$i$ = 0; detect_layer_$i$ = 0;                                                                 //  RESET COLLISION FLAGS
            $$end
        } else {
            $$for i=0,31 do
            if( SPRITE_$i$.pix_visible ) {                                                                                      // IS SPRITE 0 TO 31 VISIBLE?
                pixel = SPRITE_$i$.pixel;                                                                                       //  SET DISPLAY PIXEL

                detect_collision_$i$ = detect_collision_$i$ | ( pix_active ? sprite_visible : 0 );                              //  UPDATE SPRITE TO SPRITE COLLISIONS
                detect_layer_$i$ = detect_layer_$i$ | ( pix_active ? {
                                collision_bitmap_1, collision_bitmap_0,                                                         // BITMAP 1 AND BITMAP 0 VISIBLE AT PIXEL
                                collision_layer_1, collision_layer_2, collision_layer_3, collision_layer_4                      // BITMAP, TILEMAP L, TILEMAP U, OTHER SPRITE VISIBLE AT PIXEL
                            } : 0 );                                   //  UPDATE SPRITE TO LAYER COLLISIONS
            }
            $$end
        }

        dooutput = pix_end;                                                                                                     // CHECK FOR START OF VBLANK
    }
}

unit sprite_transform(                                                                                                          // TRANSFORM X,Y FOR REFLECTION/ROTATION IN SPRITE TILE
    input   uint4   xspriteshift,                                                                                               // X COORDINATE IN SPRITE TILE
    input   uint4   yspriteshift,                                                                                               // Y COORDINATE IN SPRITE TILE
    input   uint3   actions,                                                                                                    // REFLECTION/ROTATION FLAGS
    output! uint4   x,                                                                                                          // TRANSFORMED X COORDINATE
    output! uint4   y                                                                                                           // TRANSFORMED Y COORDINATE
) {
    uint1   action00 <: ( ~|actions[0,2] );                                                                                     // CHECK ACTION FLAGS FOR REFLECTION/ROTATION
    uint1   action01 <: ( actions[0,2] == 2b01 );
    uint1   action10 <: ( actions[0,2] == 2b10 );

    x := actions[2,1] ? action00 ? xspriteshift : action01 ? yspriteshift : action10 ? ~xspriteshift : ~yspriteshift :          // CALCULATE X IN TILE FOR  ROTATION
                        actions[0,1] ? ~xspriteshift : xspriteshift;                                                            //                          REFLECTION
    y := actions[2,1] ? action00 ? yspriteshift : action01 ? ~xspriteshift : action10 ? ~yspriteshift : xspriteshift :          // CALCULATE Y IN TILE FOR  ROTATION
                        actions[1,1] ? ~yspriteshift : yspriteshift;                                                            //                          REFLECTION
}

unit sprite_generator(
    input   uint11  x,
    input   uint11  x1,
    input   uint10  y,
    input   uint1   sprite_active,
    input   uint6   sprite_actions,
    input   uint7   sprite_size,
    input   int11   sprite_x,
    input   int10   sprite_y,
    input   uint3   sprite_tile_number,
    dualport_bram_port0 tiles,
    output! uint1   pix_visible,
    output! uint8   pixel
) {
    int11   xspritex <: ( x1 - sprite_x );                                                                                      // X PIXEL IN THE SPRITE TILE
    int10   yspritey <: ( y - sprite_y );                                                                                       // Y PIXEL IN THE SPRITE TILE

    sprite_transform TRANSFORM( actions <: sprite_actions );                                                                    // PERFORM ROTATION/REFLECTION
    TRANSFORM.xspriteshift := sprite_actions[5,1] ? ( xspritex << sprite_actions[3,2] ) : ( xspritex >>> sprite_actions[3,2] ); // SCALE X PIXEL
    TRANSFORM.yspriteshift := sprite_actions[5,1] ? ( yspritey << sprite_actions[3,2] ) : ( yspritey >>> sprite_actions[3,2] ); // SCALE Y PIXEL

    tiles.addr0 := { sprite_tile_number, TRANSFORM.y, TRANSFORM.x };                                                            // READ ADDRESS FOR SPRITE TILE ( next pixel )
    pixel := tiles.rdata0;                                                                                                      // OUTPUT PIXEL COLOUR ( current pixel )
    pix_visible := sprite_active & ( __signed(x) >= __signed(sprite_x) ) &                                                      // Determine if pixel is visible ( current pixel )
                                   ( __signed(x) < __signed( sprite_x + sprite_size ) ) &
                                   ( __signed(y) >= __signed(sprite_y) ) &
                                   ( __signed(y) < __signed( sprite_y + sprite_size ) ) & ( tiles.rdata0 != 64 );
}

unit sprite1_generator(
    input   uint11  x,
    input   uint11  x1,
    input   uint10  y,
    input   uint1   sprite_active,
    input   uint6   sprite_actions,
    input   uint7   sprite_size,
    input   int11   sprite_x,
    input   int10   sprite_y,
    input   uint3   sprite_tile_number,
    dualport_bram_port1 tiles,
    output! uint1   pix_visible,
    output! uint8   pixel,

    input   uint11  writerpixel,
    input   uint8   WDATA,
    input   uint1   wenable1
) {
    int11   xspritex <: ( x1 - sprite_x );                                                                                      // X PIXEL IN THE SPRITE TILE
    int10   yspritey <: ( y - sprite_y );                                                                                       // Y PIXEL IN THE SPRITE TILE

    sprite_transform TRANSFORM( actions <: sprite_actions );                                                                    // PERFORM ROTATION/REFLECTION
    TRANSFORM.xspriteshift := sprite_actions[5,1] ? ( xspritex << sprite_actions[3,2] ) : ( xspritex >>> sprite_actions[3,2] ); // SCALE X PIXEL
    TRANSFORM.yspriteshift := sprite_actions[5,1] ? ( yspritey << sprite_actions[3,2] ) : ( yspritey >>> sprite_actions[3,2] ); // SCALE Y PIXEL

    tiles.addr1 := wenable1 ? writerpixel : { sprite_tile_number, TRANSFORM.y, TRANSFORM.x };                                   // WRITE/READ ADDRESS ( next pixel ) FOR SPRITE TILE
    tiles.wdata1 := WDATA;                                                                                                      // PIXEL TO WRITE
    tiles.wenable1 := wenable1;                                                                                                 // PIXEL WRITE ENABLE

    pixel := tiles.rdata1;                                                                                                      // OUTPUT PIXEL COLOUR ( current pixel )
    pix_visible := sprite_active & ( __signed(x) >= __signed(sprite_x) ) &                                                      // Determine if pixel is visible ( current pixel )
                                   ( __signed(x) < __signed( sprite_x + sprite_size ) ) &
                                   ( __signed(y) >= __signed(sprite_y) ) &
                                   ( __signed(y) < __signed( sprite_y + sprite_size ) ) & ( tiles.rdata1 != 64 );
}

unit sprite_layer_writer(
    input   uint5   sprite_set_number,                                                                                          // SPRITE NUMBER
    input   uint11  sprite_write_value,                                                                                         // VALUE
    input   uint3   sprite_layer_write,                                                                                         // REGISTER TO WRITE

    output  uint$32*1$  sprite_active,                                                                                          // SPRITE   ACTIVE FLAGS
    output  uint$32*6$  sprite_actions,                                                                                         //          SCALE/ROTATION/REFLECTION FLAGS
    output  uint$32*3$  sprite_tile,                                                                                            //          TILE NUMBERS
    output  uint$32*11$ sprite_x,                                                                                               //          X POSITIONS
    output  uint$32*10$ sprite_y,                                                                                               //          Y POSITIONS
    output  uint$32*7$  sprite_size                                                                                             //          SPRITE SIZES IN PIXELS
) {
    uint7   sprite_sizes[8] = { 16, 32, 64, 128, 16, 8, 4, 2 };                                                                 // POSSIBLE SIZES OF SPRITES

    always{
        switch( sprite_layer_write ) {
            default: {}
            case 1: { sprite_active[ sprite_set_number, 1 ] = sprite_write_value[0,1]; }                                        // SET ACTIVE
            case 2: {                                                                                                           // SET ROTATION/REFLECTION/SIZE FLAGS
                sprite_actions[ sprite_set_number * 6, 6 ] = sprite_write_value[0,6];
                sprite_size[ sprite_set_number * 7, 7 ] = sprite_sizes[ sprite_write_value[3,3] ];
            }
            case 4: { sprite_x[ sprite_set_number * 11, 11 ] = sprite_write_value[0,11]; }                                      // SET X COORDINATE
            case 5: { sprite_y[ sprite_set_number * 10, 10 ] = sprite_write_value[0,10]; }                                      // SET Y COORDINATE
            case 6: { sprite_tile[ sprite_set_number * 3, 3 ] = sprite_write_value[0,3]; }                                      // SET TILE NUMBER
        }
    }
}

unit sprite_memmap(
    // Clocks
    input   uint1   video_clock,
    input   uint1   video_reset,

    // Pixels
    input   uint10  pix_x,
    input   uint10  pix_x1,
    input   uint9   pix_y,
    input   uint1   pix_active,
    input   uint1   pix_end,
    output(!) uint8   pixel,
    output(!) uint1   pixel_display,

    // Memory access
    input   uint1   bitmapwriter,
    input   uint12  ADDR,
    input   uint1   WENABLE,
    input   uint16  WDATA,

    input   uint1   collision_layer_1,
    input   uint1   collision_layer_2,
    input   uint1   collision_layer_3,
    input   uint1   collision_layer_4,
    input   uint1   collision_bitmap_0,
    input   uint1   collision_bitmap_1,

    // For reading sprite characteristics
    output  uint$32*1$  sprite_active,
    output  uint$32*6$  sprite_actions,
    output  uint$32*3$  sprite_tile,
    output  uint$32*11$ sprite_x,
    output  uint$32*10$ sprite_y,
    output  uint$32*32$ sprite_collision,
    output  uint$32*6$  sprite_layer_collision
) {
    uint1   latch = 0;
    uint1   add = 0;
    uint11  writerpixel_NEXT <:: sprites.writerpixel + 1;
    uint4   writerspritenumber = uninitialised;

    sprite_layer sprites <@video_clock,!video_reset> (
        pix_x      <: pix_x,
        pix_x1     <: pix_x1,
        pix_y      <: pix_y,
        pix_active <: pix_active,
        pix_end <: pix_end,
        pixel    :> pixel,
        sprite_layer_display :> pixel_display,

        collision_layer_1 <: collision_layer_1,
        collision_layer_2 <: collision_layer_2,
        collision_layer_3 <: collision_layer_3,
        collision_layer_4 <: collision_layer_4,
        collision_bitmap_0 <: collision_bitmap_0,
        collision_bitmap_1 <: collision_bitmap_1,

        sprite_collision :> sprite_collision,
        sprite_layer_collision :> sprite_layer_collision,

        sprite_active <: SLW.sprite_active,
        sprite_actions <: SLW.sprite_actions,
        sprite_size <: SLW.sprite_size,
        sprite_tile <: SLW.sprite_tile,
        sprite_x <: SLW.sprite_x,
        sprite_y <: SLW.sprite_y,

        WDATA <: WDATA
    );
    sprite_layer_writer SLW(
        sprite_write_value <: WDATA,
        sprite_active :> sprite_active,
        sprite_actions :> sprite_actions,
        sprite_tile :> sprite_tile,
        sprite_x :> sprite_x,
        sprite_y :> sprite_y,
    );
    SLW.sprite_layer_write := 0;

    always {
        // SPRITE BITMAP WRITER - SETTING THE SPRITE NUMBER RESETS THE COUNT, WRITING A PIXEL INCREMENTS THE COUNT - ALLOWS USE OF DMA TRANSFER
        if( latch ) { latch = 0; } else { sprites.wenable1 = 0; if( add ) { sprites.writerpixel = writerpixel_NEXT; add = 0; } }

        if( WENABLE ) {                                                                                                         // WRITE TO SPRITE MEMORY?
            if( bitmapwriter ) {                                                                                                //  WRITE TO BITMAP?
                switch( ADDR[1,1] ) {
                    case 0: { writerspritenumber = WDATA; sprites.writerpixel = 0; }
                    case 1: { sprites.wenable1[ writerspritenumber, 1 ] = 1; latch = 1; add = 1; }
                }
            } else {
                if( ADDR[7,1] ) {                                                                                               //  WRITE X OR Y COORDINATE?
                    SLW.sprite_set_number = ADDR[1,5];
                    SLW.sprite_layer_write = { 2b10, ADDR[6,1] };
            } else {
                    SLW.sprite_set_number = ADDR[0,5];
                    switch( ADDR[5,2] ) {
                        case 2h0: { SLW.sprite_layer_write = 1; }                                                               //  WRITE ACTIVE FLAG?
                        case 2h1: { SLW.sprite_layer_write = 2; }                                                               //  WRITE ACTIONS?
                        case 2h2: { SLW.sprite_layer_write = 6; }                                                               //  WRITE TILE NUMBER?
                        default: {}
                    }
                }
            }
        }
    }
}
