// RISC-ICE-V
// inspired by https://github.com/sylefeb/Silice/blob/master/projects/ice-v/ice-v.ice
//
// A simple Risc-V RV64GC processor

// RISC-V - MAIN CPU LOOP

unit PAWSCPU(
    input   uint1               clock_CPUdecoder,                                                                               // 100 MHz clocks for fast decode/register fetch
    input   uint1               clock_cache,                                                                                    // 100 MHz clock for on CPU instruction cache

    output  uint$addr_width$    MEM_ADDR,                                                                                       // MEMORY INTERFACE LINES
    output  uint2               MEM_SIZE,
    output  uint32              MEM_WDATA,
    output  uint1               MEM_WENABLE,
    input   uint32              MEM_RDATA,
    output  uint1               MEM_RENABLE,
    input   uint1               MEM_BUSY,

    output  uint1               DMA_START,                                                                                      // DMA CONTROLLER FLAGS     CPU TO DMA START FLAG
    input   uint1               DMA_REQ,                                                                                        //                          DMA START REQUEST WHEN != 0
    input   uint1               DMA_ACTIVE,                                                                                     //                          DMA ACTIVE
    output  uint1               DMA_AUDIO_START,                                                                                //                          CPU TO DMA AUDIO START FLAG
    input   uint1               DMA_AUDIO_REQ,                                                                                  //                          DMA AUDIO START REQUEST WHEN != 0
    input   uint1               DMA_AUDIO_ACTIVE,                                                                               //                          DMA AUDIO ACTIVE

    input   uint$CWIDTH$        IRQ_TIMER,                                                                                      // IRQ TIMER TRIGGER VALUE
    input   uint1               TIMER_VALID,                                                                                    // HAS IRQ TIMER TRIGGER VALUE BEEN FULLY SET
    input   uint$CWIDTH$        RDTIME,
    input   uint1               IRQ_VBLANK                                                                                      // IRQ VBLANK
) {
    uint9               STATE = 9b000000001;                                                                                    // CPU STATE MACHINE, DEFAULT TO STATE_RESET
                        $$ STATE_RESET      = 1
                        $$ STATE_DMA_START  = 2
                        $$ STATE_DMA_WAIT   = 4
                        $$ STATE_FETCH      = 8
                        $$ STATE_EXEC       = 16
                        $$ STATE_LOAD       = 32
                        $$ STATE_MULTI      = 64
                        $$ STATE_COMMIT     = 128
                        $$ STATE_NEXT       = 256

    uint8               resetCounter = -1;                                                                                      // RESET COUNTER

    uint1   RV64_frd <:: RV64.IS_FPU ? FPU.F_RD : ( RV64.IS_LOAD & Rtype(MEMORY.instruction).opp[2,1] );
    uint64  RV64_result <::                     RV64.IS_FPU ? FPU.RESULT :                                                      // SELECT RESULT FROM UNIT
                            RV64.IS_FAST ?      RV64.IS_ALU ? { ( RV64.OPCODE[1,1] & RV64.IS_ALU32SIGNX ) ? {32{ALU.result[31,1]}} : ALU.result[32,32], ALU.result[0, 32] } :
                                           RV64.IS_AUIPCLUI ? RV64.AUIPCLUI :
                                                RV64.IS_JAL ? RV64.nextPC :
                                                              MEMORY.RDATA :
                                                RV64.IS_ALU ? { RV64.OPCODE[1,1] ? {32{ALUMD.result[31,1]}} : ALUMD.result[32,32], ALUMD.result[0,32] } :
                                                RV64.IS_CSR ? CSR.result :
                                       RV64.FUNCTION7[3, 1] ? MEMORY.RDATA : RV64.FUNCTION7[2, 1] ? 0 : MEMORY.RDATA;
    control RV64 <@clock_CPUdecoder> (                                                                                          // RISC-V CONTROL FLAGS FOR INSTRUCTION
        instruction <: MEMORY.instruction, compressed <: MEMORY.compressed,
        accesssize :> MEM_SIZE,                                                                                                  // MEMORY ACCESSSIZE FLAGS ( handles fetch and misaligned )
        frd <:RV64_frd, result <:RV64_result
    );

    alu ALU(                                                                                                                    // ALU OPERATIONS, EXCEPT DIVIDE
        OP <: RV64.ALUOP,
        immediate <: RV64.OPCODE[3,1],                                                                                          //  IMMEDIATE OR SOURCEREG2 FLAG
        size32 <: RV64.OPCODE[1,1],                                                                                             //  32 BIT OPERATION FLAG
        function3 <: RV64.FUNCTION3, shiftbit6 <: RV64.FUNCTION7[0,1],
        rs1 <: RV64.RS1, rs2 <: RV64.RS2,
        sourceReg1 <: RV64.sourceReg1, sourceReg2 <: RV64.sourceReg2,
        immediateValue <: RV64.IMMEDIATE,
        LT <: RV64.COMPARISONS[2,1], LTU <: RV64.COMPARISONS[3,1]
    );

    aludivision ALUMD(                                                                                                          // INTEGER 32/64 BIT SIGNED/UNSIGNED DIVISION
        size32 <: RV64.OPCODE[1,1], function3 <: RV64.FUNCTION3[0,2],
        sourceReg1 <: RV64.sourceReg1, S1_abs32 <: RV64.S1_abs32, S1_abs64 <: RV64.S1_abs64,
        sourceReg2 <: RV64.sourceReg2, S2_abs32 <: RV64.S2_abs32, S2_abs64 <: RV64.S2_abs64
    );

    aluA ALUA( function7 <: RV64.FUNCTION7[2,5], RDATA <: MEMORY.RDATA, sourceReg2 <: RV64.sourceReg2 );                        // ATOMIC MEMORY OPERATIONS ( NOT TESTED )

    uint$addr_width$    IRQ_VECTOR <:: CSR.CSR_MTVEC[0,1] ? ( { CSR.CSR_MTVEC[2,$addr_width-2$], 2b00 } + { CSR.IRQ_VECTOR, 2b00 } ) : CSR.CSR_MTVEC;
    CSRblock CSR(                                                                                                               // RISC-V CSR REGISTERS + INTERRUPT CONTROLLER
        RDTIME <: RDTIME, IRQ_VBLANK <: IRQ_VBLANK, IRQ_TIMER <: IRQ_TIMER, TIMER_VALID <: TIMER_VALID,                         // HARDWARE IRQ FLAGS
        IS_ECALL <: RV64.IS_ECALL,                                                                                              // SOFTWARE IRQ FLAG
        DMA_ACTIVE <: DMA_ACTIVE, DMA_AUDIO_ACTIVE <: DMA_AUDIO_ACTIVE,                                                         //  FOR PERFORMANCE COUNTERS
        PC_NEXT <: RV64.newPC,                                                                                                  //  NEXT INSTRUCTION FOR MEPC INTERRUPTS
        function3 <: RV64.FUNCTION3, rs1 <: RV64.RS1,
        CSR_REG <: RV64.CSR_REG,
        sourceReg1 <: RV64.sourceReg1,
        IN_FPUFLAGS <: FPU.OUT_FPUFLAGS, W_FPUFLAGS <: FPU.CSR_UPDATE_FPUFLAGS
    );

    fpu_execute FPU(                                                                                                            // RISC-V FLOATING POINT OPERATIONS
        OPCODE <: RV64.OPCODE,
        FUNCTION3 <: RV64.FUNCTION3,
        FUNCTION7 <: RV64.FUNCTION7,
        RS1 <: RV64.RS1, RS2 <: RV64.RS2,
        I_1 <: RV64.sourceReg1, I_1_ABS32 <: RV64.S1_abs32, I_1_ABS64 <: RV64.S1_abs64,
        F_1 <: RV64.sourceReg1F, F_1_X <: RV64.sourceReg1Fx, F_1_CP <: RV64.sourceReg1Fxopp, F_1_TYPE <: RV64.type_1F, F_1_TYPE_CP <: RV64.typeAopp,
        F_2 <: RV64.sourceReg2F, F_2_X <: RV64.sourceReg2Fx, F_2_TYPE <: RV64.type_2F,
        F_3_X <: RV64.sourceReg3Fx, F_3_TYPE <: RV64.type_3F,
        F1_OR_F2_INF <: RV64.F1_OR_F2_INF,
        F1_AND_F2_INF <: RV64.F1_AND_F2_INF,
        F1_OR_F2_NAN <: RV64.F1_OR_F2_NAN,
        F1_OR_F2_ZERO <: RV64.F1_OR_F2_ZERO,
        F1_AND_F2_ZERO <: RV64.F1_AND_F2_ZERO,
        F1_ZERO_FRACTION <: RV64.F1_ZERO_FRACTION,
        F2_ZERO_FRACTION <: RV64.F2_ZERO_FRACTION,
        FLT <: RV64.FLT, FEQ <: RV64.FEQ,
        IS_FASTFPU <: RV64.IS_FASTFPU,
        IS_FPUCONVERT <: RV64.IS_FPUCONVERT,
        IN_FPUFLAGS <: CSR.OUT_FPUFLAGS
    );

    uint64  MEMORY_WDATA <:: RV64.IS_FAST ? RV64.OPCODE[0,1] ? RV64.sourceReg2F :  RV64.sourceReg2 :                            // STORE INTEGER / FLOAT
                                         RV64.FUNCTION7[3,1] ? ALUA.result : RV64.sourceReg2;                                   // OR ATOMIC MEMORY OPERATION RESULT
    memory_controller MEMORY(                                                                                                   // HANDLE CPU MEMORY OPERATIONS { STORE, LOAD, FETCH }
        clock_CPUdecoder <: clock_CPUdecoder, clock_cache <: clock_cache,
        MEM_SIZE <: RV64.FUNCTION3[0,2], IS_MA <: RV64.IS_MA, IS_64 <: RV64.IS_MEM64,
        IS_FLOAT <: RV64.OPCODE[0,1], IS_UNSIGNED <: RV64.FUNCTION3[2,1],
        LOAD_ADDRESS <: RV64.LOAD_ADDRESS, STORE_ADDRESS <: RV64.STORE_ADDRESS, WDATA <: MEMORY_WDATA,
        MEM_BUSY <: MEM_BUSY, MEM_ADDR :> MEM_ADDR,
        MEM_WDATA :> MEM_WDATA, MEM_WENABLE :> MEM_WENABLE,
        MEM_RDATA <: MEM_RDATA, MEM_RENABLE :> MEM_RENABLE
    );

    RV64.write := 0;                                                                                                            // WRITE TO REGISTERS
    MEMORY.start := 0;                                                                                                          // { STORE, LOAD, FETCH }

    ALUMD.start := 0; FPU.START := 0;                                                                                           // DIVISION AND FPU START FLAGS
    CSR.IRQ_ACK := 0; CSR.IRQ_END := 0; CSR.START := 0; CSR.INC_INSNRET := 0;                                                   // CSR START, IRQ ACK AND END, INSTRUCTION COUNTER FLAGS
    DMA_START := 0; DMA_AUDIO_START := 0;                                                                                       // DMA CONTROLLER START FLAGS

    always {
        uint1           COMMIT = uninitialized;                                                                                 // COMMIT RESULT TO REGISTERS FLAG
        uint1           DMA_REQUESTED = uninitialised;

        onehot(STATE) {
            case 0: {                                                                                                           // STATE_RESET
                if ( |resetCounter ) {
                    CSR.CPU_ACTIVE = 0; MEMORY.CPU_FENCE = 0; MEMORY.pc = 0; COMMIT = 0;
                    resetCounter = resetCounter - ~( MEM_BUSY | DMA_ACTIVE | DMA_AUDIO_ACTIVE | ALUMD.busy | FPU.BUSY | MEMORY.busy );
                } else {
                    STATE = $STATE_NEXT$;
                }
            }
            case 1: {                                                                                                           // STATE_DMA
                DMA_START = DMA_REQ; DMA_AUDIO_START = ~DMA_REQ & DMA_AUDIO_REQ;
                DMA_REQUESTED = 1; STATE = $STATE_DMA_WAIT$;
            }
            case 2: {                                                                                                           // STATE_DMA_WAIT
                if( DMA_REQUESTED ) {
                    DMA_REQUESTED = 0;
                } else {
                    if( ~( DMA_ACTIVE | DMA_AUDIO_ACTIVE ) ) {  STATE = $STATE_NEXT$; }
                }
            }
            case 3: {                                                                                                           // STATE_FETCH
                if( ~MEMORY.busy ) {
                    RV64.cacheselect = 1; COMMIT = RV64.writeRegister;                                                          //      DATA CACHE, SET COMMIT FLAG IF REGISTER WRITE
                    STATE = RV64.IS_LOAD ? RV64.IS_FAST ? $STATE_COMMIT$ : $STATE_LOAD$ : $STATE_EXEC$;                         //      LOAD? COMMIT OR ATOMIC( MULTI ), ELSE EXEC
                    MEMORY.start = { 1b0, RV64.IS_LOAD, 1b0 };                                                                  //      START LOAD?
                }
                RV64.PC = MEMORY.pc;                                                                                            //      UPDATE PC
            }
            case 4: {                                                                                                           // STATE_EXEC
                STATE = ( RV64.IS_FPU | RV64.IS_CSR | RV64.IS_ATOMIC ) ? $STATE_MULTI$ :                                        //      MULTICYCLE FPU CSR ATOMIC -> MULTI
                                                                         $STATE_COMMIT$;                                        //      ALU DIVISION OR FAST -> COMMIT
                if( RV64.IS_FENCE ) { MEMORY.CPU_FENCE = { |RV64.FUNCTION7[1,2], ~RV64.FUNCTION3[0,1] }; }                      //      ADJUST FENCE
                ALUMD.start = ~RV64.IS_FAST & RV64.IS_ALU; CSR.START = RV64.IS_CSR; FPU.START = RV64.IS_FPU;                    //      START MULTI-CYCLE UNIT?
                MEMORY.start = { RV64.IS_STORE & RV64.IS_FAST, 2b00 };                                                          //      START STORE?
            }
            case 5: { if( ~MEMORY.busy ) { STATE = $STATE_MULTI$; } }                                                           // STATE_LOAD WAIT FOR ATOMIC MEMORY OPERATIONS
            case 6: { if( ~FPU.BUSY ) { STATE = $STATE_COMMIT$; MEMORY.start = { RV64.IS_STORE, 2b00 }; } }                     // STATE_MULTI WAIT FOR FLOATING-POINT TO FINISH
            case 7: {                                                                                                           // STATE_COMMIT
                if( ~MEMORY.busy & ~ALUMD.busy ) {                                                                              //      WAIT FOR LOAD/STORE/DIVIDE TO FINISH
                    MEMORY.pc =                        RV64.IS_MRET ? CSR.CSR_MEPC :                                            //      SELECT NEXT INSTRUCTION     MRET
                                ( RV64.IS_ECALL | CSR.IRQ_PENDING ) ? IRQ_VECTOR :                                              //                                  INTERRUPT
                                                        RV64.IS_WFI ? MEMORY.pc :                                               //      WFI HOLDS AT CURRENT MEMORY ADDRESS UNTIL INTERRUPT
                                                                      RV64.newPC;                                               //                                  NEXT INSTRUCTION
                    CSR.IRQ_END = RV64.IS_MRET; CSR.IRQ_ACK = CSR.IRQ_PENDING & ~RV64.IS_MRET;                                  //      SIGNAL IRQ ACKNOWLEDGE / END
                    CSR.INC_INSNRET = 1; STATE = $STATE_NEXT$;                                                                  //      FLAG INSTRUCTION EXECUTION COMPLETE
                }
            }
            case 8: {                                                                                                           // STATE_NEXT
                RV64.write = COMMIT; COMMIT = 0;                                                                                //      COMMIT AND CLEAR THE COMMIT FLAG
                RV64.cacheselect = ( DMA_REQ | DMA_AUDIO_REQ );                                                                 //      SELECT DATA CACHE FOR DMA, INSTRUCTION CACHE FOR FETCH
                CSR.CPU_ACTIVE = ~( DMA_REQ | DMA_AUDIO_REQ );                                                                  //      SET CPU ACTIVE IF NOT DMA
                STATE = ( DMA_REQ | DMA_AUDIO_REQ ) ? $STATE_DMA_START$ : $STATE_FETCH$;                                        //      START DMA OR FETCH
                MEMORY.start = { 2b00, ~( DMA_REQ | DMA_AUDIO_REQ ) };                                                          //          START FETCH?
            }
        }
    }
}

unit memory_controller(
    input   uint1               clock_CPUdecoder,
    input   uint1               clock_cache,
    input   uint3               start,                                                                                          // { STORE, LOAD, FETCH }
    output  uint1               busy,

    input   uint2               MEM_SIZE,
    input   uint1               IS_MA,
    input   uint1               IS_64,
    input   uint1               IS_FLOAT,
    input   uint1               IS_UNSIGNED,

    output  uint$addr_width$    MEM_ADDR,
    input   uint1               MEM_BUSY,
    output  uint1               MEM_WENABLE,
    output  uint32              MEM_WDATA,
    output  uint1               MEM_RENABLE,
    input   uint32              MEM_RDATA,

    input   uint2               CPU_FENCE,
    input   uint$addr_width$    pc,
    input   uint$addr_width$    LOAD_ADDRESS,
    input   uint$addr_width$    STORE_ADDRESS,
    output  uint64              RDATA,
    input   uint64              WDATA,

    output  uint32              instruction,
    output  uint1               compressed
) {
    uint5               STATE = 1;
                        $$ STATE_FSL_WAIT       = 1
                        $$ STATE_FETCH_READ     = 2
                        $$ STATE_FETCH_COMPLETE = 4
                        $$ STATE_LOAD_MEMBUSY   = 8
                        $$ STATE_LS_NEXT        = 16

    uint4               count = uninitialised;                                                                                  // NUMBER OF MEMORY OPERATION
    uint4               count_NEXT <:: count + 1;
    uint$addr_width$    MEM_ADDR_NEXT <:: MEM_ADDR + ( IS_MA ? 1 : 4 );                                                         // NEXT MEMORY ADDRESS FOR LOAD/STORE

    simple_dualport_bram uint$32+L10Ipartaddresswidth$ L10cache <@clock_cache,@clock> [$L10Iblocks$] = uninitialized;           // SMALL ON CPU L1 CACHE - 1 per HART - RESET FENCE MEM IS 1
    iL10cache_read ICACHE <@clock_cache> ( L1cache <:> L10cache, CLS <: ICACHEW.CLS, ADDR <: pc );
    iL10cache_write ICACHEW( L1cache <:> L10cache, ADDR <: pc, newinstruction <: instruction[2,30], newcompressed <: compressed, update <:: STATE[2,1] );

    compressed00 COMPRESSED00 <@clock_CPUdecoder> ( i16 <: MEM_RDATA[2,14] );                                                   // COMPRESSED INSTRUCTION EXPANDERS
    compressed01 COMPRESSED01 <@clock_CPUdecoder> ( i16 <: MEM_RDATA[2,14] );
    compressed10 COMPRESSED10 <@clock_CPUdecoder> ( i16 <: MEM_RDATA[2,14] );

    signnanbox LOAD(                                                                                                            // SIGN EXTEND IF SIGNED LOAD, OR NAN-BOX FOR FLOAT LOAD
        IS_FLOAT <: IS_FLOAT,                                                                                                   //  IS FLOAT LOAD
        IS_UNSIGNED <: IS_UNSIGNED,                                                                                             //  IS UNSIGNED INTEGER LOAD
        MEM_SIZE <: MEM_SIZE,                                                                                                   //  IS 8 BIT, 16, BIT, 32, 64 BIT LOAD
        ADDR_B0 <: LOAD_ADDRESS[0,1],                                                                                           //  ADDRESS LINE 0 FOR 8 BIT LOAD
        MEM_RDATA :> RDATA                                                                                                      //  OUTPUT LOAD RESULT
    );

    MEM_RENABLE := 0; MEM_WENABLE := 0;                                                                                         // READ / WRITE FLAGS
//    ICACHEW.update := STATE[2,1];
    ICACHEW.invalidate := reset | CPU_FENCE[0,1];                                                 // UPDATE/INVALIDATE( after load ) CPU L1 CACHE FLAG

    always {
        uint3 ACTION = uninitialised;

        if( STATE[4,1] & ~MEM_BUSY & ACTION[1,1] ) {                                                                            //  IF LOAD, PACK READDATA INTO MEMORY INPUT
            if( IS_MA ) {
                LOAD.RDATA[{ count, 3b000 }, 8] = MEM_RDATA[{ MEM_ADDR[0,1], 3b000 }, 8];                                       //  SINGLE BYTE FOR MISALIGNED LOADS
            } else {
                LOAD.RDATA[{ count[0,1], 5b00000 }, 32] = MEM_RDATA;                                                            //  8/16/32 BITS FOR ALIGNED LOADS
            }
        }

        onehot(STATE) {
            case 0: {
                if( |start ) {                                                                                                  // WAIT FOR START
                    count = 0;                                                                                                  //  0 COUNT
                    MEM_ADDR = start[0, 1] ? pc : start[1, 1] ? LOAD_ADDRESS : STORE_ADDRESS;                                   //  SET FIRST ADDRESS
                    ACTION = start;

                    onehot(start) {                                                                                             // SEND TO { STORE, LOAD, FETCH }
                        case 0: {
                            if( ICACHE.tagmatch ) {
                                instruction = { ICACHE.instruction, 2b11 }; compressed = ICACHE.compressed;                     //  FETCH FROM L1 CACHE
                            } else {
                                STATE = $STATE_FETCH_READ$;                                                                     //  FETCH FROM MEMORY
                            }
                        }
                        case 1: { LOAD.RDATA = 0; STATE = $STATE_LOAD_MEMBUSY$; }                                               //  LOAD FROM MEMORY
                        case 2: { STATE = $STATE_LS_NEXT$; }                                                                    //  STORE TO MEMORY
                    }
                }

                busy = |start[1,2] | ( start[0,1] & ~ICACHE.tagmatch );
                MEM_RENABLE = start[1,1] | ( start[0,1] & ~ICACHE.tagmatch );
                MEM_WDATA = WDATA; MEM_WENABLE = start[2,1];
            }

            case 1: { if( ~MEM_BUSY ) { STATE = $STATE_FETCH_COMPLETE$; } }                                                     // WAIT FOR MEMORYREAD TO COMPLETE
            case 2: {                                                                                                           // PACK FETCHED INSTRUCTION
                compressed =   ~&MEM_RDATA[0,2];                                                                                //  SET COMPRESSED FLAGS
                instruction = { &MEM_RDATA[0,2] ? MEM_RDATA[2,30] :                                                             //  32 BIT INSTRUCTION READ
                               ~|MEM_RDATA[0,2] ? COMPRESSED00.i32 :                                                            //  16 BIT INSTRUCTION READ block 00
                                 MEM_RDATA[0,1] ? COMPRESSED01.i32 :                                                            //                          block 01
                                                  COMPRESSED10.i32, 2b11 };                                                     //                          block 10, plus trailing 11
                busy = 0; STATE = $STATE_FSL_WAIT$;                                                                             // FINISHED FETCH
            }

            case 3: { if( ~MEM_BUSY ) { STATE = $STATE_LS_NEXT$; } }                                                            // WAIT FOR MEMORYREAD TO COMPLETE
            case 4: {
                if( ~MEM_BUSY ) {                                                                                               // WAIT FOR MEMORYWRITE TO COMPLETE
                    if( count_NEXT[ IS_MA ? MEM_SIZE : IS_64 ? 1 : 0, 1 ] ) {
                        busy = 0; STATE = $STATE_FSL_WAIT$;                                                                     //  FINISHED LOAD/STORE
                    } else {
                        MEM_WDATA = IS_MA ? WDATA[{ count_NEXT, 3b000 }, 8] : WDATA[32, 32];                                    // SET MEMORY OUTPUT TO PRESENT STORE PART
                        count = count_NEXT;
                        MEM_ADDR = MEM_ADDR_NEXT;                                                                               //  MOVE TO NEXT PART, 8 bit MA or NEXT 32 BITS FOR 64 BITS
                        MEM_WENABLE = ACTION[2,1]; MEM_RENABLE = ACTION[1,1];
                        STATE = ACTION[2,1] ? $STATE_LS_NEXT$ : $STATE_LOAD_MEMBUSY$;
                    }
                }
            }
        }
    }
}

unit signnanbox( // SIGN EXTEND/NAN BOX MEMORYINPUT
    input   uint1   IS_FLOAT,
    input   uint1   IS_UNSIGNED,
    input   uint2   MEM_SIZE,
    input   uint1   ADDR_B0,
    input   uint64  RDATA,
    output  uint64  MEM_RDATA
) {
    always {
        switch (MEM_SIZE) {
            case 2b00: {                                                                                                        // SIGN EXTEND 8 BIT LOAD ( not for floats )
                MEM_RDATA = { {56{ ~IS_UNSIGNED & RDATA[{ ADDR_B0, 3b111 }, 1] }}, RDATA[{ ADDR_B0, 3b000 }, 8] };
            }
            case 2b01: { MEM_RDATA = { {48{ IS_FLOAT | (~IS_UNSIGNED & RDATA[15,1]) }}, RDATA[0,16] }; }                        // SIGN EXTEND / NAN BOX 16 BIT LOAD
            case 2b10: { MEM_RDATA = { {32{ IS_FLOAT | (~IS_UNSIGNED & RDATA[31,1]) }}, RDATA[0,32] }; }                        // SIGN EXTEND / NAN BOX 32 BIT LOAD
            case 2b11: { MEM_RDATA = RDATA; }                                                                                   // COPY 64 BIT LOAD
        }
    }
}
