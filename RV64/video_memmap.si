unit passthrough(input uint1 i,output! uint1 o)
{
  always { o=i; }
}

unit statusdisplay(
    input   uint9   pix_x,
    input   uint8   pix_y,
    input   uint1   pix_active,
    input   uint1   pix_end,
    output! uint8   pixel,
    output! uint1   pixel_display,

    input   uint1   display,
    input   uint8   background(64),
    input   uint2   sdcardlightcolour,
    input   uint1   sdcarderror,
    input   uint1   JOYSTICK,
    input   uint1   CAPSLOCK,
    input   uint1   NUMLOCK,
    input   uint1   RESETSTATUS
) {
    // 4 ICONS, SDCARD, JOYSTICK MODE, CAPS LOCK STATUS, NUM LOCK STATUS
    brom uint16 sdcard[16]   = { 16h0000, 16h3ff8, 16h3ffc, 16h3ffc, 16h3ffc, 16h3ff8, 16h1ffc, 16h1ffc, 16h3ffc, 16h3ffc, 16h3ffc, 16h3ffc, 16h3ffc, 16h3ffc, 16h3ffc, 16h0000 };
    brom uint16 joystick[16] = { 16h0000, 16h0180, 16h03c0, 16h07e0, 16h0180, 16h1188, 16h318c, 16h7ffe, 16h7ffe, 16h318c, 16h1188, 16h0180, 16h07e0, 16h03c0, 16h0180, 16h0000 };
    brom uint16 capslock[16] = { 16h0000, 16h03c0, 16h0e70, 16h381c, 16h700e, 16h6006, 16h6006, 16h7ffe, 16h7ffe, 16h6006, 16h6006, 16h6006, 16h6006, 16h6006, 16h6006, 16h0000 };
    brom uint16 numlock[16]  = { 16h0000, 16h0780, 16h0d80, 16h0980, 16h0180, 16h0180, 16h0180, 16h0180, 16h0180, 16h0180, 16h0180, 16h0180, 16h0180, 16h0180, 16h0ff0, 16h0000 };

    sdcard.addr := pix_y[0,4]; joystick.addr := pix_y[0,4]; capslock.addr := pix_y[0,4]; numlock.addr := pix_y[0,4];
    pixel := 8h40;

    always {
        uint6   COUNTER = uninitialised;                                                                                       // TIMER, 1 SECOND = 60 frames

       if( |COUNTER & display & pix_x[8,1] & ~|pix_y[4,4] ) {                                                                  // CHECK IF IN RANGE
            switch( pix_x[4,2] ) {
                // SELECT PIXEL COLOUR ACCORDING TO EACH STATUS LIGHT
                case 2b00: {
                    pixel = sdcard.rdata[~pix_x[0,4],1] ? sdcarderror            ? 8h86 :                                       //        SILENT ERROR ( MAGENTA )
                                                          &sdcardlightcolour     ? 8hc1 :                                       // SDCARD   == 3 ERROR ( RED )
                                                          sdcardlightcolour[1,1] ? 8hf9 :                                       //          == 2 WRITE ( YELLOW )
                                                          sdcardlightcolour[0,1] ? 8h1f :                                       //          == 1 READ  ( BLUE )
                                                                                   8h38 :                                       //          == 0 IDLE  ( GREEN )
                                                                                   background;
                }
                case 2b01: { pixel = joystick.rdata[~pix_x[0,4],1] ? JOYSTICK ? 8h38 : 8h5b : background; }                     // JOYSTICK
                case 2b10: { pixel = capslock.rdata[~pix_x[0,4],1] ? CAPSLOCK ? 8h38 : 8h5b : background; }                     // CAPSLOCK
                case 2b11: { pixel = numlock.rdata[~pix_x[0,4],1] ? NUMLOCK ? 8h38 : 8h5b : background; }                       // NUMLOCK
            }
        }
        pixel_display = ( pixel != 8h40 );                                                                                      // CHECK NOT TRANSPARENT
        if( RESETSTATUS ) { COUNTER = 60; } else { COUNTER = COUNTER - ( |COUNTER & pix_end ); }                                // REQUEST TO DISPLAY STATUS LIGHTS
    }
}

unit video_memmap(
    input   uint1   CS,
    input   uint1   CS_BM,
    input   uint1   CS_CM,
    input   uint1   CS_TM,

    // CLOCKS
    input   uint1   palette_clock,                                                                                              // 50MHz (double) clock
    input   uint1   video_clock,                                                                                                // 25MHz VGA (640x480@60Hz) clock
    input   uint1   gpu_clock,                                                                                                  // 25MHz (video) clock

    // Memory access via normal I/O registers
    input   uint18  ADDR,
    input   uint18  ADDR0,
    input   uint2   SIZE,
    input   uint1   WENABLE,
    input   uint32  WDATA,
    output  uint32  RDATA,

    // Memory access direct to bitmap / character map / tilemaps
    output! uint32  BITMAP_RDATA,
    output  uint32  CMAP_RDATA,
    output  uint9   LTMAP_RDATA,
    output  uint9   UTMAP_RDATA,

$$if HDMI then
    // HDMI OUTPUT
    output! uint4   gpdi_dp,
$$end
$$if VGA then
    // VGA OUTPUT
    output! uint$color_depth$ video_r,
    output! uint$color_depth$ video_g,
    output! uint$color_depth$ video_b,
    output  uint1 video_hs,
    output  uint1 video_vs,
$$end

    // RNG + CURSOR
    input   uint10  staticGenerator,
    input   uint1   blink,

    // STATUSLIGHTS
    input   uint2   sdcardlightcolour,
    input   uint1   sdcarderror,
    input   uint1   JOYSTICK,
    input   uint1   CAPSLOCK,
    input   uint1   NUMLOCK,
    input   uint1   RESETSTATUS
) {
    // Video Reset
    uint1   video_reset = uninitialised; clean_reset video_rstcond<@video_clock,!reset> ( out :> video_reset );

    // HDMI driver
    // Status of the screen, if in range, if in vblank, actual pixel x and y
    uint1   vblank = uninitialized;
    uint1   pix_active = uninitialized;
    uint10  pix_x  = uninitialized;
    uint9   pix_y  = uninitialized;
    uint1   pix_end <:: ( pix_x == 639 ) & ( pix_y == 479 );
$$if VGA then
  vga vga_driver<@video_clock,!video_reset>(
    vga_hs :> video_hs,
    vga_vs :> video_vs,
    vga_x  :> pix_x,
    vga_y  :> pix_y,
    vblank :> vblank,
    active :> pix_active
  );
$$end
$$if HDMI then
    hdmi video <@video_clock,!video_reset> (
        vblank  :> vblank,
        active  :> pix_active,
        x       :> pix_x,
        y       :> pix_y,
        gpdi_dp :> gpdi_dp
    );
$$end
    // CREATE DISPLAY LAYERS
    // PREPARE COORDINATES FOR PRE-FETCHERS, ALL LAYERS BUT BACKGROUND
    // HDMI IMAGE STARTS IMMEDIATELY AFTER VBLANK, VGA HAS A "PORCH" FOR EACH LINE, PART OF HBLANK
    // (xscreen,yscreen) is the screen coordinate that is next to be rendered.
$$if HDMI then
    uint10  xscreen <:: pix_active ? pix_x : 0;
    uint10  xscreenp1 <:: pix_active ? ( pix_x + 1 ) : 0;
    uint9   yscreen <:: vblank ? 0 : pix_active ? pix_y : ( pix_y + 1 );
$$else
    uint10  xscreen <:: pix_active ? pix_x : 0;
    uint10  xscreenp1 <:: pix_active ? ( pix_x + 1 ) : 0;
    uint9   yscreen <:: vblank ? 0 : pix_y;
$$end
    uint3   hilorez = uninitialised;                                                                                            // FLAG FOR hi or lo  SWITCH FOR TILEMAPS, CHARACTERMAP { cm, tm_u, tm_l }

    // BACKGROUND
    background_memmap BACKGROUND(
        video_clock <: video_clock,
        video_reset <: video_reset,
        colourmode <: display.colour,
        pix_x      <: xscreen,
        pix_y      <: yscreen,
        pix_vblank <: vblank,
        pix_end <: pix_end,
        ADDR <: ADDR,
        WDATA <: WDATA,
        staticGenerator <: staticGenerator[0,10]
    );

    bitmap_memmap BITMAP(
        video_clock <: video_clock,
        video_reset <: video_reset,
        gpu_clock <: gpu_clock,
        pix_x      <: xscreen,
        pix_y      <: yscreen,
        pix_active <: pix_active,
        pix_vblank <: vblank,
        ADDR <: ADDR,
        ADDR <: ADDR0,
        WDATA <: WDATA,
        RDATA_DIRECT :> BITMAP_RDATA,
        SIZE <: SIZE,
        static8bit <: staticGenerator[0,8]
    );

    // Character Map Window
    charactermap_memmap CHARACTER_MAP(
        video_clock <: video_clock,
        video_reset <: video_reset,
        clockCG <: palette_clock,
        lorez <: hilorez[2,1],
        pix_x      <: xscreen,
        pix_x1     <: xscreenp1,
        pix_y      <: yscreen,
        pix_active <: pix_active,
        pix_vblank <: vblank,
        blink <: blink,
        ADDR <: ADDR,
        WDATA <: WDATA,
        RDATA_DIRECT :> CMAP_RDATA
    );

    // Sprite Layers - Lower and Upper
    sprite_memmap LOWER_SPRITE(
        video_clock <: video_clock,
        video_reset <: video_reset,
        pix_x      <: xscreen,
        pix_x1     <: xscreenp1,
        pix_y      <: yscreen,
        pix_active <: pix_active,
        pix_end <: pix_end,
        ADDR <: ADDR,
        WDATA <: WDATA,
        collision_layer_1 <: BITMAP.pixel_display,
        collision_layer_2 <: LOWER_TILE.pixel_display,
        collision_layer_3 <: UPPER_TILE.pixel_display,
        collision_layer_4 <: UPPER_SPRITE.pixel_display,
    );
    sprite_memmap UPPER_SPRITE(
        video_clock <: video_clock,
        video_reset <: video_reset,
        pix_x      <: xscreen,
        pix_x1     <: xscreenp1,
        pix_y      <: yscreen,
        pix_active <: pix_active,
        pix_end <: pix_end,
        ADDR <: ADDR,
        WDATA <: WDATA,
        collision_layer_1 <: BITMAP.pixel_display,
        collision_layer_2 <: LOWER_TILE.pixel_display,
        collision_layer_3 <: UPPER_TILE.pixel_display,
        collision_layer_4 <: LOWER_SPRITE.pixel_display,
        collision_bitmap_0 <: BITMAP.pixel0_collision,
        collision_bitmap_1 <: BITMAP.pixel1_collision
    );

    // Tilemaps - Lower and Upper
    tilemap_memmap LOWER_TILE(
        video_clock <: video_clock,
        video_reset <: video_reset,
        clockTG <: palette_clock,
        lorez <: hilorez[0,1],
        pix_x      <: xscreen,
        pix_x1     <: xscreenp1,
        pix_y      <: yscreen,
        pix_active <: pix_active,
        pix_vblank <: vblank,
        ADDR <: ADDR,
        WDATA <: WDATA,
        RDATA_DIRECT :> LTMAP_RDATA
    );
    tilemap_memmap UPPER_TILE(
        video_clock <: video_clock,
        video_reset <: video_reset,
        clockTG <: palette_clock,
        lorez <: hilorez[1,1],
        pix_x      <: xscreen,
        pix_x1     <: xscreenp1,
        pix_y      <: yscreen,
        pix_active <: pix_active,
        pix_vblank <: vblank,
        ADDR <: ADDR,
        WDATA <: WDATA,
        RDATA_DIRECT :> UTMAP_RDATA
    );

    // STATUS LIGHTS
    statusdisplay STATUS <@video_clock,!video_reset> (
        pix_x      <: xscreenp1[1,9],
        pix_y      <: yscreen[1,8],
        pix_active <: pix_active,
        pix_end <: pix_end,
        sdcardlightcolour <: sdcardlightcolour,
        sdcarderror <: sdcarderror,
        JOYSTICK <: JOYSTICK,
        CAPSLOCK <: CAPSLOCK,
        NUMLOCK <: NUMLOCK,
        RESETSTATUS <: RESETSTATUS
    );

    // Combine the display layers for display, output the select RGBM/palette/grey pixel
    simple_dualport_bram uint24 palette <@palette_clock,@clock> [256] = uninitialized;
    multiplex_display display <@video_clock,!video_reset> (
        palette_clock <: palette_clock,
        palette <:> palette,
        background_p <: BACKGROUND.pixel,
        lower_tilemap_p <: LOWER_TILE.pixel,
        lower_tilemap_display <: LOWER_TILE.pixel_display,
        upper_tilemap_p <: UPPER_TILE.pixel,
        upper_tilemap_display <: UPPER_TILE.pixel_display,
        lower_sprites_p <: LOWER_SPRITE.pixel,
        lower_sprites_display <: LOWER_SPRITE.pixel_display,
        upper_sprites_p <: UPPER_SPRITE.pixel,
        upper_sprites_display <: UPPER_SPRITE.pixel_display,
        bitmap_p <: BITMAP.pixel,
        bitmap_display <: BITMAP.pixel_display,
        character_map_p <: CHARACTER_MAP.pixel,
        character_map_display <: CHARACTER_MAP.pixel_display,
        status_p <: STATUS.pixel,
        status_display <: STATUS.pixel_display
    );

    uint4   dimmer = 0;
    uint32  framecount = 0;

    BACKGROUND.WENABLE := 0;
    BITMAP.WENABLE := 0; BITMAP.WENABLE_DIRECT := CS_BM & WENABLE;
    CHARACTER_MAP.WENABLE := 0; CHARACTER_MAP.WENABLE_DIRECT := CS_CM & WENABLE;
    LOWER_SPRITE.WENABLE := 0; LOWER_SPRITE.bitmapwriter := 0;
    UPPER_SPRITE.WENABLE := 0; UPPER_SPRITE.bitmapwriter := 0;
    LOWER_TILE.WENABLE := 0; LOWER_TILE.WENABLE_DIRECT := CS_TM & WENABLE & ~ADDR[15,1];
    UPPER_TILE.WENABLE := 0; UPPER_TILE.WENABLE_DIRECT := CS_TM & WENABLE & ADDR[15,1];
    palette.wenable1 := 0; palette.wdata1 := WDATA;

    $$if VGA then
        video_r := display.pix_red[2,6] >> dimmer; video_g := display.pix_green[2,6] >> dimmer; video_b := display.pix_blue[2,6] >> dimmer;
    $$end
    $$if HDMI then
        video.red := display.pix_red >> dimmer; video.green := display.pix_green >> dimmer; video.blue := display.pix_blue >> dimmer;
    $$end

    framecount := framecount + pix_end;

    always {
        // WRITE IO Memory
        if( CS & WENABLE ) {
            switch( ADDR[8,4] ) {
                case 4h0: { BACKGROUND.WENABLE = 1; }
                case 4h1: { LOWER_TILE.WENABLE = 1; }
                case 4h2: { UPPER_TILE.WENABLE = 1; }
                case 4h3: { LOWER_SPRITE.WENABLE = 1; }
                case 4h4: { UPPER_SPRITE.WENABLE = 1; }
                case 4h5: { CHARACTER_MAP.WENABLE = 1; }
                case 4h6: { BITMAP.WENABLE = 1; }
                case 4h8: { LOWER_SPRITE.WENABLE = 1; LOWER_SPRITE.bitmapwriter = 1; }
                case 4h9: { UPPER_SPRITE.WENABLE = 1; UPPER_SPRITE.bitmapwriter = 1; }
                case 4hf: {
                    if( ADDR[4,1] ) {
                        if( ADDR[2,1] ) {
                            if( ADDR[0,1] ) { display.usepalette = WDATA; } else { palette.addr1 = WDATA; }
                        } else {
                            palette.wenable1 = 1;
                        }
                    } else {
                        switch( ADDR[0,3] ) {
                            default: { display.display_order = WDATA; }
                            case 1: { display.colour = WDATA; }
                            case 2: { hilorez = WDATA; }
                            case 3: { dimmer = WDATA; }
                            case 4: { STATUS.display = WDATA; }
                            case 5: { STATUS.background = WDATA; }
                        }
                    }
                }
                default: {}
            }
        }

        // READ IO Memory
        switch( ADDR[8,4] ) {
            case 4h0: { RDATA = BACKGROUND.RDATA; }
            case 4h1: {
                switch( ADDR[1,3] ) {
                    case 3h0: { RDATA = LOWER_TILE.base_x; }
                    case 3h1: { RDATA = LOWER_TILE.base_y; }
                    case 3h2: { RDATA = { {11{LOWER_TILE.tm_offset_x[4,1]}}, LOWER_TILE.tm_offset_x }; }
                    case 3h3: { RDATA = { {11{LOWER_TILE.tm_offset_y[4,1]}}, LOWER_TILE.tm_offset_y }; }
                    case 3h7: { RDATA = LOWER_TILE.tm_lastaction; }
                    default: {}
                }
            }
            case 4h2: {
                switch( ADDR[1,3] ) {
                    case 3h0: { RDATA = UPPER_TILE.base_x; }
                    case 3h1: { RDATA = UPPER_TILE.base_y; }
                    case 3h2: { RDATA = { {11{UPPER_TILE.tm_offset_x[4,1]}}, UPPER_TILE.tm_offset_x }; }
                    case 3h3: { RDATA = { {11{UPPER_TILE.tm_offset_y[4,1]}}, UPPER_TILE.tm_offset_y }; }
                    case 3h7: { RDATA = UPPER_TILE.tm_lastaction; }
                    default: {}
                }
            }
            case 4h3: {
                switch( ADDR[7,1] ) {
                    case 0: {
                        switch( ADDR[5,2] ) {
                            case 0: {
                                RDATA = { LOWER_SPRITE.sprite_active[ { ADDR[1,4], 1b1 } ,1 ], 7b0, LOWER_SPRITE.sprite_active[ { ADDR[1,4], 1b0 } ,1 ] };
                            }
                            case 1: {
                                RDATA = { LOWER_SPRITE.sprite_actions[ { ADDR[1,4], 1b1 } * 6 ,6 ], 2b0, LOWER_SPRITE.sprite_actions[ { ADDR[1,4], 1b0 } * 6 ,6 ] };
                            }
                            case 2: {
                                RDATA = { LOWER_SPRITE.sprite_tile[ { ADDR[1,4], 1b1 } * 3 ,3 ], 5b0, LOWER_SPRITE.sprite_tile[ { ADDR[1,4], 1b0 } * 3 ,3 ] };
                            }
                            case 3: {
                                RDATA = { LOWER_SPRITE.sprite_layer_collision[ { ADDR[1,4], 1b1 } * 6 ,6 ],
                                             2b0,
                                             LOWER_SPRITE.sprite_layer_collision[ { ADDR[1,4], 1b0 } * 6 ,6 ] };
                            }
                        }
                    }
                    case 1: {
                        RDATA = ADDR[6,1] ? {{6{LOWER_SPRITE.sprite_y[ ADDR[1,5] * 10 +  9, 1 ]}}, LOWER_SPRITE.sprite_y[ ADDR[1,5] * 10, 10 ] } :
                                                        {{5{LOWER_SPRITE.sprite_x[ ADDR[1,5] * 11 + 10, 1 ]}}, LOWER_SPRITE.sprite_x[ ADDR[1,5] * 11, 11 ] };
                    }
                }
            }
            case 4h4: {
                switch( ADDR[7,1] ) {
                    case 0: {
                        switch( ADDR[5,2] ) {
                            case 0: {
                                RDATA = { UPPER_SPRITE.sprite_active[ { ADDR[1,4], 1b1 } ,1 ], 7b0, UPPER_SPRITE.sprite_active[ { ADDR[1,4], 1b0 } ,1 ] };
                            }
                            case 1: {
                                RDATA = { UPPER_SPRITE.sprite_actions[ { ADDR[1,4], 1b1 } * 6 ,6 ], 2b0, UPPER_SPRITE.sprite_actions[ { ADDR[1,4], 1b0 } * 6 ,6 ] };
                            }
                            case 2: {
                                RDATA = { UPPER_SPRITE.sprite_tile[ { ADDR[1,4], 1b1 } * 3 ,3 ], 5b0, UPPER_SPRITE.sprite_tile[ { ADDR[1,4], 1b0 } * 3 ,3 ] };
                            }
                            case 3: {
                                RDATA = { UPPER_SPRITE.sprite_layer_collision[ { ADDR[1,4], 1b1 } * 6 ,6 ],
                                             2b0,
                                             UPPER_SPRITE.sprite_layer_collision[ { ADDR[1,4], 1b0 } * 6 ,6 ] };
                            }
                        }
                    }
                    case 1: {
                        RDATA = ADDR[6,1] ? {{6{UPPER_SPRITE.sprite_y[ ADDR[1,5] * 10 +  9, 1 ]}}, UPPER_SPRITE.sprite_y[ ADDR[1,5] * 10, 10 ] } :
                                                        {{5{UPPER_SPRITE.sprite_x[ ADDR[1,5] * 11 + 10, 1 ]}}, UPPER_SPRITE.sprite_x[ ADDR[1,5] * 11, 11 ] };
                    }
                }
            }
            case 4h6: { RDATA = ADDR[1,1] ? BITMAP.gpu_queue_full : BITMAP.gpu_queue_complete; }
            case 4h8: { RDATA = LOWER_SPRITE.sprite_collision[ { ADDR[2,5], 5b00000 }, 32 ]; }
            case 4h9: { RDATA = UPPER_SPRITE.sprite_collision[ { ADDR[2,5], 5b00000 }, 32 ]; }
            case 4hf: { RDATA = ADDR[2,1] ? framecount : vblank; }
            default: {}
        }

        if( reset ) {
            // SET DEFAULT DISPLAY ORDER, COLOUR MODE AND DIMMER
            STATUS.display = 1; STATUS.background = 64; display.display_order = 0; display.colour = 0; display.usepalette = 0;hilorez = 0;
        }
    }
}
