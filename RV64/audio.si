// AUDIO MEMORY MAP CONTROLLER
unit audio_memmap(
    input   uint1   CS,

    input   uint5   ADDR,                                                                                                       // BITS 1-5 ( 32 16 bit registers )
    input   uint1   WENABLE,
    input   uint32  WDATA,
    output  uint8   RDATA,

    // AUDIO
    output  uint4   audio_l,
    output  uint4   audio_r,

    // RNG
    input  uint8   static8bit,

    // DMA DIGITAL AUDIO SAMPLES
    input   uint1   L_ADMA_ACTIVE,
    input   uint8   L_SAMPLE,
    output  uint4   L_AUDIO_DMA_STATUS,
    output  uint$addr_width$ L_AUDIO_DMA_BASE,
    output  uint$addr_width$  L_AUDIO_DMA_LENGTH,

    input   uint1   R_ADMA_ACTIVE,
    input   uint8   R_SAMPLE,
    output  uint4   R_AUDIO_DMA_STATUS,
    output  uint$addr_width$ R_AUDIO_DMA_BASE,
    output  uint$addr_width$ R_AUDIO_DMA_LENGTH,
) {
    // BLOCK STORAGE FOR "DOOM SAMPLES" - A SERIES OF NOTES TO BE PLAYED FOR A GIVEN NUMBER OF MILLISECONDS
    simple_dualport_bram uint7 samples_left[128] = uninitialized;
    simple_dualport_bram uint7 samples_right[128] = uninitialized;
    doom_samples_writer DSL( doom_samples <:> samples_left, samples <: WDATA[0,7] );
    doom_samples_writer DSR( doom_samples <:> samples_right, samples <: WDATA[0,7] );

    // BLOCK STORAGE FOR "BIT SAMPLES" - 128 x 1 bit SAMPLES ( very crude digital sounds ), STORED AS 16 x 8 bits PER CHANNEL
    simple_dualport_bram uint8 bit_samples_left[16] = uninitialized;
    simple_dualport_bram uint8 bit_samples_right[16] = uninitialized;
    bitsample_writer BSL( bit_samples <:> bit_samples_left, samples <: WDATA[0,8] );
    bitsample_writer BSR( bit_samples <:> bit_samples_right, samples <: WDATA[0,8] );

    dualport_bram uint8 sine[256] = {
        128,131,134,137,140,144,147,150,153,156,159,162,165,168,171,174,
        177,179,182,185,188,191,193,196,199,201,204,206,209,211,213,216,
        218,220,222,224,226,228,230,232,234,235,237,239,240,241,243,244,
        245,246,248,249,250,250,251,252,253,253,254,254,254,255,255,255,
        255,255,255,255,254,254,254,253,253,252,251,250,250,249,248,246,
        245,244,243,241,240,239,237,235,234,232,230,228,226,224,222,220,
        218,216,213,211,209,206,204,201,199,196,193,191,188,185,182,179,
        177,174,171,168,165,162,159,156,153,150,147,144,140,137,134,131,
        128,125,122,119,116,112,109,106,103,100,97,94,91,88,85,82,
        79,77,74,71,68,65,63,60,57,55,52,50,47,45,43,40,
        38,36,34,32,30,28,26,24,22,21,19,17,16,15,13,12,
        11,10,8,7,6,6,5,4,3,3,2,2,2,1,1,1,
        1,1,1,1,2,2,2,3,3,4,5,6,6,7,8,10,11,
        12,13,15,16,17,19,21,22,24,26,28,30,32,34,36,38,
        40,43,45,47,50,52,55,57,60,63,65,68,71,74,77,79,
        82,85,88,91,94,97,100,103,106,109,112,116,119,122,125
    };
    dualport_bram uint8 harmonic[256] = {
        127,137,147,156,165,174,182,190,196,203,208,213,216,220,223,225,226,
        228,229,230,231,232,233,234,235,236,238,239,241,243,245,247,249,250,
        252,253,254,254,254,253,252,251,249,246,243,240,237,234,231,227,224,
        222,219,217,216,215,215,215,216,217,219,221,223,225,228,230,233,234,
        236,237,238,238,237,236,234,231,228,224,220,215,210,204,199,194,188,
        183,178,174,169,166,162,159,156,154,152,150,148,146,144,143,141,139,
        136,134,131,128,125,122,118,115,111,108,105,102,99,97,96,95,95,
        96,97,99,102,105,108,113,117,122,127,132,137,141,146,149,152,
        155,157,158,159,159,158,157,155,152,149,146,143,139,136,132,129,126,
        123,120,118,115,113,111,110,108,106,104,102,100,98,95,92,88,85,
        80,76,71,66,60,55,50,44,39,34,30,26,23,20,18,17,16,
        16,17,18,20,21,24,26,29,31,33,35,37,38,39,39,39,38,
        37,35,32,30,27,23,20,17,14,11,8,5,3,2,1,0,0,
        0,1,2,4,5,7,9,11,13,15,16,18,19,20,21,22,23,
        24,25,26,28,29,31,34,38,41,46,51,58,64,72,80,89,98,
        107,117
    };

    // Left and Right audio channels
    audio_0 apu_processor_L(
        samples <:> samples_left,
        bit_samples <:> bit_samples_left,
        harmonic <:> harmonic,
        sine <:> sine,
        staticGenerator <: static8bit,
        audio :> audio_l,
        samples_MAX <: DSL.max,
        pcm_active <:L_ADMA_ACTIVE,
        pcm_sample <: L_SAMPLE,
    );
    audio_1 apu_processor_R(
        samples <:> samples_right,
        bit_samples <:> bit_samples_right,
        harmonic <:> harmonic,
        sine <:> sine,
        staticGenerator <: static8bit,
        audio :> audio_r,
        samples_MAX <: DSR.max,
        pcm_active <:R_ADMA_ACTIVE,
        pcm_sample <: R_SAMPLE,
    );

    // SAMPLE MEMORY CONTROLS
    DSL.newsample := 0; DSR.newsample := 0; DSL.load := 0; DSR.load := 0;                                                       // DOOM STYLE PC SPEAKER SAMPLES
    BSL.newsample := 0; BSR.newsample := 0; BSL.load := 0; BSR.load := 0;                                                       // CHIP8 1 BIT SAMPLES
    L_AUDIO_DMA_STATUS := 0; R_AUDIO_DMA_STATUS := 0;

    apu_processor_L.apu_write := 0; apu_processor_R.apu_write := 0;                                                             // HOLD WRITE TRIGGERS AT 0
    RDATA := { R_ADMA_ACTIVE, L_ADMA_ACTIVE, 4b0, apu_processor_R.audio_active, apu_processor_L.audio_active };                 // RETURN AUDIO ACTIVE STATE TO CPU}

    always {
        if( CS & WENABLE ) {
            switch( ADDR ) {
                case 5h0: { apu_processor_L.waveform = WDATA; apu_processor_R.waveform = WDATA; }                               // SET APU FROM CPU
                case 5h1: { apu_processor_L.frequency = WDATA; apu_processor_R.frequency = WDATA; }
                case 5h2: { apu_processor_L.duration = WDATA;  apu_processor_R.duration = WDATA; }
                case 5h3: { apu_processor_L.apu_write = WDATA[0,1]; apu_processor_R.apu_write = WDATA[1,1]; }
                case 5h4: { DSL.newsample = WDATA[0,1]; DSR.newsample = WDATA[1,1]; }                                           // RESET SAMPLES
                case 5h5: { DSL.load = 1; }                                                                                     // WRITE TO LEFT DOOM SAMPLE MEMORY
                case 5h6: { DSR.load = 1; }                                                                                     // WRITE TO RIGHT DOOM SAMPLE MEMORY
                case 5h8: { apu_processor_L.volume = WDATA; }                                                                   // SET VOLUME LEFT
                case 5h9: { apu_processor_R.volume = WDATA; }                                                                   // SET VOLUME RIGHT
                case 5ha: { BSL.newsample = WDATA[0,1]; BSR.newsample = WDATA[1,1]; }                                           // RESET BIT SAMPLES
                case 5hb: { BSL.load = 1; }                                                                                     // WRITE TO LEFT BIT SAMPLE MEMORY
                case 5hc: { BSR.load = 1;  }                                                                                    // WRITE TO RIGHT BIT SAMPLE MEMORY
                case 5h10: { L_AUDIO_DMA_BASE = WDATA; }                                                                        // LEFT DMA AUDIO BASE ADDRESS
                case 5h12: { L_AUDIO_DMA_LENGTH = WDATA; }                                                                      // LEFT DMA AUDIO SAMPLE LENGTH
                case 5h14: { L_AUDIO_DMA_STATUS = WDATA; }                                                                      // LEFT DMA AUDIO [0,1] == STOP [1,1] == START
                case 5h18: { R_AUDIO_DMA_BASE = WDATA; }                                                                        // RIGHT DMA AUDIO BASE ADDRESS
                case 5h1a: { R_AUDIO_DMA_LENGTH = WDATA; }                                                                      // RIGHT DMA AUDIO SAMPLE LENGTH
                case 5h1c: { R_AUDIO_DMA_STATUS = WDATA; }                                                                      // RIGHT DMA AUDIO b0 == STOP b1 == START b2 == REPEAT
                default: {}
            }
        }
    }
}

// AUDIO Channel Controller
// LEFT USES HARMONIC AND SINE VIA PORT 0, RIGHT USES HARMONIC AND SINE VIA PORT 1
$$for i=0,1 do
unit audio_$i$(
    simple_dualport_bram_port0  samples,
    simple_dualport_bram_port0  bit_samples,
    dualport_bram_port$i$  sine,
    dualport_bram_port$i$  harmonic,

    input   uint1   pcm_active,
    input   uint8   pcm_sample,

    input   uint8   staticGenerator,
    input   uint5   waveform,
    input   uint7   frequency,
    input   uint16  duration,
    input   uint1   apu_write,
    input   uint3   volume,
    output  uint4   audio,
    output  uint1   audio_active,

    input   uint7   samples_MAX
) {
    octave CPUINPUT( frequency <: frequency ); octave SINPUT( frequency <: samples.rdata0 );                                    // GENERATE BASE COUNTER AND SHIFT TO CORRECT OCTAVE
    uint13 frequency_table[] = {
        0,                                                                                                                      // FREQUENCY TABLE - FIRST 24 NOTES
        6328, 6144, 5972, 5800, 5638, 5474, 5320, 5168, 5022, 4878, 4740, 4604,                                                 // USE OCTAVE ALGORITHM TO GET ADDITIONAL NOTES
        4474, 4344, 4224, 4102, 3986, 3870, 3762, 3654, 3552, 3448, 3352, 3056                                                  // 3 = c 2 , 5 = c#2, 7 = d 2...
    };
    uint13  CPUfrequency <:: frequency_table[ CPUINPUT.basefrequency ] >> CPUINPUT.shift;                                       // COUNTER FOR CPU INPUT
    uint13  Sfrequency <:: frequency_table[ SINPUT.basefrequency ] >> SINPUT.shift;                                             // COUNTER FOR SAMPLE INPUT
    uint7   SAMP0P1 <:: samples.addr0 + 1;                                                                                      // NEXT ADDRESS IN DOOM PC SPEAKER MODE

    apu_$i$ apu_processor(                                                                                                      // AUDIO CHANNEL
        bit_samples <:> bit_samples, sine <:> sine, harmonic <:> harmonic,                                                      // 8 bit output from audio channel goes through PWM modulator
        pcm_sample <: pcm_sample,
        volume <: volume,
        staticGenerator <: staticGenerator,
        audio_active :> audio_active
    );
    audio_pwm PWM( active_1 <: apu_processor.audio_active, wave_1 <: apu_processor.audio_output, active_2 <: pcm_active, wave_2 <: pcm_sample, pwm :> audio );

    apu_processor.apu_write := 0;

    always {
        uint1   SAMPLEMODE = uninitialised;                                                                                     // IS CHANNEL IN DOOM PC SPEAKER SAMPLE MODE?
        uint1   REPEAT = uninitialised;                                                                                         // IS REPEAT FOR DOOM PC SPEAKER MODE RQQUIRED?
        uint1   newS = uninitialised;                                                                                           // IS A NEW NOTE REQUIRED WHEN AUDIO STOPS?

        if( SAMPLEMODE ) {                                                                                                      // DOOM PC SPEAKER MODE?
            if( ~apu_processor.audio_active ) {                                                                                 //  PREVIOUS SAMPLE FINISHED?
                if( newS ) {                                                                                                    //  NEW SAMPLE NEEDED?
                    apu_processor.frequency = Sfrequency; apu_processor.apu_write = 1; newS = 0;                                //  SEND NEW NOTE
                    if( SAMP0P1 == samples_MAX ) {                                                                              // AT END OF NOTES?
                        samples.addr0 = 0; SAMPLEMODE = REPEAT;                                                                 //  RESTART IF REPEAT
                    } else {
                        samples.addr0 = SAMP0P1;                                                                                // MOVE TO NEXT NOTE
                    }
                }
            } else {
                newS = 1;                                                                                                       // DEFAULT TO NEW NOTE REQUIRED
            }
        } else {
            samples.addr0 = 0; newS = 1;                                                                                        // DEFAULT TO START AND NEW NOTE REQUIRED
        }

        if( apu_write ) {                                                                                                       // CPU AUDIO REQUEST
            apu_processor.duration = duration; apu_processor.waveform = waveform[0,3];                                          // SET BASE DURATION AND WAVEFORM
            SAMPLEMODE = waveform[3,1]; REPEAT = waveform[4,1];                                                                 // SET DOOM PC SPEAKER SAMPLE MODE AND REPEAT FLAGS
            if( waveform[3,1] ) {
                samples.addr0 = 0; newS = 1;                                                                                    // IF DOOM PC SPEAKER SAMPLE MODE, MOVE TO START
            } else {
                apu_processor.frequency = CPUfrequency; apu_processor.apu_write = 1;                                            // NORMAL WAVEFORM MODE, SET FREQUENCY
            }
        }
    }
}

unit apu_$i$(                                                                                                                   // Single channel audio output, outputs 8 bits for PWM. 50MHz
    simple_dualport_bram_port0  bit_samples,
    dualport_bram_port$i$  harmonic,
    dualport_bram_port$i$  sine,
    input   uint3   waveform,
    input   uint13  frequency,
    input   uint16  duration,
    input   uint1   apu_write,
    input   uint8   staticGenerator,
    input   uint3   volume,
    output  uint1   audio_active,
    output  uint8   audio_output,
    input   uint8   pcm_sample,
) {
    waveform_$i$ WAVEFORM(
        active <: COUNTER.active,
        bit_samples <:> bit_samples, sine <:> sine, harmonic <:> harmonic,
        start <: apu_write, update <: COUNTER.updatepoint,
        selected_waveform <: waveform,
        staticGenerator <: staticGenerator,
        pcm_sample <: pcm_sample
    );
    audiocounter COUNTER( selected_frequency <: frequency, selected_duration <: duration, start <: apu_write, active :> audio_active );

    always {
        if( COUNTER.updatepoint ) { audio_output = WAVEFORM.audio_output >> ~volume; }
    }
}

unit waveform_$i$(
    simple_dualport_bram_port0  bit_samples,
    dualport_bram_port$i$  harmonic,
    dualport_bram_port$i$  sine,
    input   uint1   start,
    input   uint1   update,
    input   uint3   selected_waveform,
    input   uint8   staticGenerator,
    output  uint8   audio_output,
    input   uint1   active,
    input   uint8   pcm_sample
) {
    uint8   point = uninitialised;
    uint8   point_NEXT <:: point + update;

    sine.addr$i$ := point[0,8]; harmonic.addr$i$ := point[0,8];                                                                 // POINTER INTO HARMONIC AND SINE TABLES
    bit_samples.addr0 := point[3,4];                                                                                            // POINTERS INTO BITSAMPLES
    point := ~active ? 0 : point_NEXT;                                                                                          // WAVEFORM POINT ONLY RESETS WHEN AUDIO GOES INACTIVE
                                                                                                                                // ALLOWS BIT SAMPLES TO REPEAT
    always {
        switch( selected_waveform ) {
            case 0: { audio_output = { point[7,1], 7b1111111 }; }                                                               // SQUARE
            case 1: { audio_output = point[0,8]; }                                                                              // SAWTOOTH
            case 2: { audio_output = ( point[7,1] ? ~{ point[0,7], 1b1 } : { point[0,7], 1b0 } ); }                             // TRIANGLE
            case 3: { audio_output = sine.rdata$i$; }                                                                           // SINE
            case 4: { audio_output = staticGenerator; }                                                                         // NOISE
            case 5: { audio_output = harmonic.rdata$i$; }                                                                       // HARMONIC WAVE
            case 6: { audio_output = ( sine.rdata$i$ + ( point[7,1] ? ~{ point[0,7], 1b1 } : { point[0,7], 1b0 } ) ) >> 1; }    // HARMONIC TRIANGLE + SINE ( replaces old sample waveform )
            case 7: { audio_output = {8{bit_samples.rdata0[ point[0,3], 1]}}; }                                                 // 1 BIT SAMPLES, TRANSLATE TO SQUARE WAVE
        }
    }
}
$$ end

unit audiocounter(
    input   uint1   start,
    input   uint13  selected_frequency,
    input   uint16  selected_duration,
    output  uint1   updatepoint,
    output  uint1   active(0)
) {
    uint13  counter50mhz = uninitialised;
    uint13  counter50mhz_NEXT <:: counter50mhz - 1;
    uint16  duration = uninitialised;
    uint16  duration_NEXT <:: duration - 1;
    uint16  counter1khz = uninitialised;
    uint16  counter1khz_NEXT <:: counter1khz - 1;

    active := ( |duration );
    updatepoint := |duration & ( ~|counter50mhz );

    always {
        if( start ) {
            counter50mhz = 0; counter1khz = 50000; duration = selected_duration;
        } else {
            if( updatepoint ) { counter50mhz = selected_frequency; } else { counter50mhz = counter50mhz_NEXT; }
            if( |duration & ( ~|counter1khz ) ) { counter1khz = 50000; duration = duration_NEXT; } else { counter1khz = counter1khz_NEXT; }
        }
    }
}

// GIVEN THE FREQUENCY INDEX, CONVERT TO 1 to 24, PLUS SHIFT AMOUNT
// ALLOWS FREQUENCY TABLE TO BE 25 ENTRIES LONG
unit octave(
    input   uint7   frequency,
    output  uint5   basefrequency,
    output  uint3   shift
) {
    shift := ( frequency > 120 ) ? 5 : ( frequency > 96 ) ? 4 : ( frequency > 72 ) ? 3 : ( frequency > 48 ) ? 2 : ( frequency > 24 ) ? 1 : 0;
    basefrequency := frequency - ( shift * 24 );
}

// HANDLE WRITING TO THE DOOM PC SPEAKER SAMPLES MEMORY
unit doom_samples_writer(
    simple_dualport_bram_port1  doom_samples,
    input   uint7   samples,
    input   uint1   load,
    input   uint1   newsample,
    output  uint8   max
) {
    uint8   NEXT <:: doom_samples.addr1 + 1;

    doom_samples.wenable1 := load; doom_samples.wdata1 := samples; max := NEXT; doom_samples.addr1 := newsample ? (-1) : load ? NEXT : doom_samples.addr1;
}

// HANDLE WRITING TO THE CHIP8 1 BIT SAMPLES MEMORY
unit bitsample_writer(
    simple_dualport_bram_port1  bit_samples,
    input   uint8   samples,
    input   uint1   load,
    input   uint1   newsample
) {
    uint7   NEXT <:: bit_samples.addr1 + load;

    bit_samples.wenable1 := load; bit_samples.wdata1 := samples; bit_samples.addr1 := newsample ? (-1) : NEXT;
}

// SL 12-2020
