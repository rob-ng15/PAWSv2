// MIT license, see LICENSE_MIT in Silice repo root

// This is a nice trick to 'interpolate' through a 4-bits only DAC
// I got this from emard: https://github.com/emard/ulx3s-misc/blob/master/examples/audio/hdl/dacpwm.v

// For now fixed to 8 bits in to 4 bits DAC
// TODO make it more general

// Expanded by @rob-ng15 to time-multiplex four waveforms

unit audio_pwm(
    input   uint$AUDIO_multi$   RDTIME,
    input   uint1               active_1,
    input   uint8               wave_1,
    input   uint1               active_2,
    input   uint8               wave_2,
    input   uint1               active_3,
    input   uint8               wave_3,
    input   uint1               active_4,
    input   uint8               wave_4,
    output  uint4               pwm
) {
    uint8               sample <: ( RDTIME[$AUDIO_multi-2$,2] == 2b00 ) ? active_1 ? wave_1 : 0 :
                                  ( RDTIME[$AUDIO_multi-2$,2] == 2b01 ) ? active_2 ? wave_2 : 0 :
                                  ( RDTIME[$AUDIO_multi-2$,2] == 2b10 ) ? active_3 ? wave_3 : 0 :
                                                                          active_4 ? wave_4 : 0;

    pwm := sample[4,4] + ( RDTIME[0,4] < sample[0,4] );
}
