// OUTPUT KEY PRESS AND KEY RELEASE EVENTS - RETURNS { press, extended keycode, keycode }
// TO OBTAIN ASCII, NEEDS DECODING IN THE LIBRARY
unit ps2ascii(
    input   uint1               us2_bd_dp,
    input   uint1               us2_bd_dn,
    input   uint1               outputkeycodes,
    output  uint10              keycode,
    output  uint1               keycodevalid,
    output  uint16              joystick(0)
) <reginputs> {
    ps2 PS2( ps2clk_ext <: us2_bd_dp, ps2data_ext <: us2_bd_dn );                                                               // PS2 KEYBOARD CODE READER

    uint1               start_keyup = 0;
    uint1               start_multicode = 0;
    uint16              mask = uninitialised;
    keycodevalid := 0;

    // BITS         { 15        ..      9       8       7       6         5       4       3       2       1       0       }
    // JOYSTICK     { APP               RWIN    RALT    LALT    RIGHT     LEFT    DOWN    UP      FIRE2   FIRE1   BIT0    }
    always {
        if( PS2.valid ) {
            switch( PS2.data ) {
                case 8he0: { start_multicode = 1; }
                case 8hf0: { start_keyup = 1; }
                default: {
                    switch( PS2.data ) {
                        case 8h11: { mask = start_multicode ? ( 1 << 8 ) : ( 1 << 7 ); }                                        // 07 == LALT   08 == RALT
                        case 8h14: { mask = start_multicode ? ( 1 << 10 ) : ( 1 << 1 ); }                                       // 01 == LCTRL  10 == RCTRL { LCTRL == FIRE1 }
                        case 8h1f: { mask = ( 1 << 2 ); }                                                                       // 02 == LWIN               { LWIN  == FIRE2 }
                        case 8h27: { mask = ( 1 << 9 ); }                                                                       // 09 == RWIN
                        case 8h2f: { mask = ( 1 << 15 ); }                                                                      // 15 == APPLICATION
                        case 8h6b: { mask = ( 1 << 5 ); }                                                                       // 05 == LEFT
                        case 8h72: { mask = ( 1 << 4 ); }                                                                       // 04 == DOWN
                        case 8h74: { mask = ( 1 << 6 ); }                                                                       // 06 == RIGHT
                        case 8h75: { mask = ( 1 << 3 ); }                                                                       // 03 == UP
                        case 8h69: { mask = ( 1 << 5 ) | ( 1 << 4 ); }                                                          // ( KEYPAD 1, LEFT DOWN )
                        case 8h7a: { mask = ( 1 << 6 ) | ( 1 << 4 ); }                                                          // ( KEYPAD 3, RIGHT DOWN )
                        case 8h6c: { mask = ( 1 << 5 ) | ( 1 << 3 ); }                                                          // ( KEYPAD 7, LEFT UP )
                        case 8h7d: { mask = ( 1 << 6 ) | ( 1 << 3 ); }                                                          // ( KEYPAD 9, RIGHT UP )
                        default: { mask = 0; }
                    }
                    keycode = { ~start_keyup, start_multicode, PS2.data }; keycodevalid = outputkeycodes;
                    joystick = start_keyup ? ( joystick & ~mask ) : ( joystick | mask );
                    start_multicode = 0; start_keyup = 0;
                }
            }
        }
    }
}

// PS/2 PORT - READS KEYCODE FROM PS/2 KEYBOARD
// MODIFIED FROM ORIGINAL CODE https://github.com/hoglet67/Ice40Beeb converted to Silice by @lawrie, optimised and simplified by @rob-ng15
//  ZX Spectrum for Altera DE1
