// RISC-V BASE INSTRUCTION BITFIELDS
bitfield    Btype {
    uint1   imm_b_12,
    uint6   imm_b_10_5,
    uint5   sr2,
    uint5   sr1,
    uint3   f3,
    uint4   imm_b_4_1,
    uint1   imm_b_11,
    uint7   opp
}

bitfield    Itype {
    uint12  imm,
    uint5   sr1,
    uint3   f3,
    uint5   rd,
    uint7   opp
}

bitfield    ItypeSHIFT {
    uint7   f7,
    uint5   shiftCount,
    uint5   sr1,
    uint3   f3,
    uint5   rd,
    uint7   opp
}

bitfield    Jtype {
    uint1   imm_b_20,
    uint10  imm_b_10_1,
    uint1   imm_b_11,
    uint8   imm_b_19_12,
    uint5   rd,
    uint7   opp
}

bitfield    Rtype {
    uint7   f7,
    uint5   sr2,
    uint5   sr1,
    uint3   f3,
    uint5   rd,
    uint7   opp
}
bitfield    R4type {
    uint5   sr3,
    uint2   function2,
    uint5   sr2,
    uint5   sr1,
    uint3   f3,
    uint5   rd,
    uint7   opp
}

bitfield Stype {
    uint7   imm_b_11_5,
    uint5   sr2,
    uint5   sr1,
    uint3   f3,
    uint5   imm_b_4_0,
    uint7   opp
}

bitfield Utype {
    uint20  imm_b_31_12,
    uint5   rd,
    uint7   opp
}

// CSR Risc-V Access Instruction
bitfield    CSR {
    uint12  csr,
    uint5   rs1,
    uint3   f3,
    uint5   rd,
    uint7   opp
}

// COMPRESSED Risc-V Instruction Bitfields
bitfield    CBalu {
    uint3   f3,
    uint1   ib_5,
    uint2   function2,
    uint3   rd_alt,
    uint2   logical2,
    uint3   rs2_alt
}
bitfield    CBalu50 {
    uint3   f3,
    uint1   ib_5,
    uint2   function2,
    uint3   rd_alt,
    uint5   ib_4_0
}
bitfield    CB {
    uint3   f3,
    uint1   offset_8,
    uint2   offset_4_3,
    uint3   rs1_alt,
    uint2   offset_7_6,
    uint2   offset_2_1,
    uint1   offset_5
}

bitfield    CI {
    uint3   f3,
    uint1   ib_5,
    uint5   rd,
    uint3   ib_4_2,
    uint2   ib_7_6
}
bitfield    CI50 {
    uint3   f3,
    uint1   ib_5,
    uint5   rd,
    uint5   ib_4_0
}
bitfield    CI94 {
    uint3   f3,
    uint1   ib_9,
    uint5   rd,
    uint1   ib_4,
    uint1   ib_6,
    uint2   ib_8_7,
    uint1   ib_5
}
bitfield    CIu94 {
    uint3   f3,
    uint2   ib_5_4,
    uint4   ib_9_6,
    uint1   ib_2,
    uint1   ib_3,
    uint3   rd_alt
}
bitfield    CIlui {
    uint3   f3,
    uint1   ib_17,
    uint5   rd,
    uint5   ib_16_12
}

bitfield    CJ {
    uint3   f3,
    uint1   ib_11,
    uint1   ib_4,
    uint2   ib_9_8,
    uint1   ib_10,
    uint1   ib_6,
    uint1   ib_7,
    uint3   ib_3_1,
    uint1   ib_5
}

bitfield    CL {
    uint3   f3,
    uint3   ib_5_3,
    uint3   rs1_alt,
    uint1   ib_2,
    uint1   ib_6,
    uint3   rd_alt
}

bitfield    CLD {
    uint3   f3,
    uint3   ib_5_3,
    uint3   rs1_alt,
    uint2   ib_7_6,
    uint3   rd_alt
}

bitfield    CLB {
    uint3   f3,
    uint3   function2,
    uint3   rs1_alt,
    uint1   uimm0,
    uint1   uimm1,
    uint3   rd_alt
}

bitfield    CLS {
    uint3   f3,
    uint1   ib_5,
    uint5   rd,
    uint3   ib_4_2,
    uint2   ib_7_6
}

bitfield    CLSD {
    uint3   f3,
    uint1   ib_5,
    uint5   rd,
    uint2   ib_4_3,
    uint3   ib_8_6
}

bitfield    CR {
    uint4   function4,
    uint5   rs1,
    uint5   rs2
}

bitfield    CS {
    uint3   f3,
    uint1   ib_5,
    uint2   ib_4_3,
    uint3   rs1_alt,
    uint1   ib_2,
    uint1   ib_6,
    uint3   rs2_alt
}

bitfield    CSD {
    uint3   f3,
    uint1   ib_5,
    uint2   ib_4_3,
    uint3   rs1_alt,
    uint2   ib_7_6,
    uint3   rs2_alt
}

bitfield    CSB {
    uint3   f3,
    uint3   function2,
    uint3   rs1_alt,
    uint1   uimm0,
    uint1   uimm1,
    uint3   rs2_alt
}

bitfield    CSS {
    uint3   f3,
    uint1   ib_5,
    uint3   ib_4_2,
    uint2   ib_7_6,
    uint5   rs2
}

bitfield    CSSD {
    uint3   f3,
    uint1   ib_5,
    uint2   ib_4_3,
    uint3   ib_8_6,
    uint5   rs2
}

// BITFIELD FOR FLOATING POINT NUMBER - IEEE-754 16 bit format
bitfield fp16{
    uint1   sign,
    uint5   exponent,
    uint10  fraction
}
$$ BIAS16 = 15

// BITFIELD FOR FLOATING POINT NUMBER - IEEE-754 32 bit format
bitfield fp32{
    uint1   sign,
    uint8   exponent,
    uint23  fraction
}
$$ BIAS32 = 127

// BITFIELD FOR FLOATING POINT NUMBER - IEEE-754 64 bit format
bitfield fp64{
    uint1   sign,
    uint11  exponent,
    uint52  fraction
}
$$ BIAS64 = 1023

// REFERENCE RISC-V FLOATING POINT FLAGS
$$ NX = 1
$$ UF = 2
$$ OF = 4
$$ DZ = 8
$$ NV = 16
bitfield floatingpointflags{
    uint1   NV,     // Result is not valid,
    uint1   DZ,     // Divide by zero
    uint1   OF,     // Result overflowed
    uint1   UF,     // Result underflowed
    uint1   NX      // Not exact ( integer to float conversion caused bits to be dropped )
}

// BITFIELD FOR FLOATING POINT CSR REGISTER
bitfield floatingpointcsr{
    uint24  reserved,
    uint3   frm,
    uint5   fflags
}

// ROUNDING MODES
$$ RNE = 0
$$ RTZ = 1
$$ RDN = 2
$$ RUP = 3
$$ RMM = 4

