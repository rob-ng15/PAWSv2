// RISC-ICE-V
// inspired by https://github.com/sylefeb/Silice/blob/master/projects/ice-v/ice-v.ice
//
// A simple Risc-V RV64GC processor

// RISC-V - MAIN CPU LOOP

unit PAWSCPU(
    input   uint1   clock_CPUdecoder,                                                                                           // 100 MHz clocks for fast decode/register fetch
    input   uint1   clock_cache,                                                                                                // 100 MHz clock for on CPU instruction cache

    output  uint$addr_width$  address,                                                                                          // MEMORY INTERFACE LINES
    output  uint2   accesssize,
    output  uint32  writedata,
    output  uint1   writememory,
    input   uint32  readdata,
    output  uint1   readmemory,
    input   uint1   memorybusy,

    input   uint1   SMTRUNNING,                                                                                                 // SMT CONTROL FLAGS FROM IO REGISTERS
    input   uint$addr_width$  SMTSTARTPC,                                                                                       // HART1 START ADDRESS

    output  uint1   DMASTART,                                                                                                   // DMA CONTROLLER FLAGS     CPU TO DMA START FLAG
    input   uint1   DMAREQ,                                                                                                     //                          DMA START REQUEST WHEN != 0
    input   uint1   DMAACTIVE,                                                                                                  //                          DMA ACTIVE

    output  uint1   DMA_AUDIO_START,                                                                                            // DMA CONTROLLER FLAGS     CPU TO DMA START FLAG
    input   uint1   DMA_AUDIO_REQ,                                                                                              //                          DMA START REQUEST WHEN != 0
    input   uint1   DMA_AUDIO_ACTIVE                                                                                            //                          DMA ACTIVE
) <reginputs> {
    uint9   STATE = 8b00000001;
        $$ STATE_RESET      = 1
        $$ STATE_DMA_START  = 2
        $$ STATE_DMA_WAIT   = 4
        $$ STATE_FETCH      = 8
        $$ STATE_EXEC       = 16
        $$ STATE_LOAD       = 32
        $$ STATE_MULTI      = 64
        $$ STATE_COMMIT     = 128
        $$ STATE_NEXT       = 256

    uint8   resetCounter = -1;                                                                                                  // RESET COUNTER
    uint1   DELAY = uninitialised;
    uint1   DMAREQUESTED = 0;

    uint1   COMMIT = uninitialized;                 uint1   COMMIT_SMT = uninitialised;                                         // COMMIT RESULT TO REGISTERS FLAG AND TO WHICH THREAD
    uint1   SMT = 0;                                                                                                            // SMT FLAG
    uint$addr_width$  pc = 0;                       uint$addr_width$  pcSMT = uninitialized;                                    // PROGRAMS COUNTERS FOR MAIN AND SMT THREADS

    uint64  result <:: RV64CONTROL.IS_FPU ? EXECUTEFPU.result :                                                                 // SELECT RESULT FROM UNIT
                      RV64CONTROL.IS_FAST ? RV64CONTROL.IS_ALU ? ( RV64CONTROL.opCode[1,1] & RV64CONTROL.IS_ALU32SIGNX ) ?
                                                                 { {32{ALU.result[31,1]}}, ALU.result[0,32] } : ALU.result :    // INTEGER ALU AND MULTIPLICATION, SIGN EXTEND 32 bit
                                            EXECUTEFAST.result :
                                            EXECUTESLOW.result;
    uint1   frd <:: RV64CONTROL.IS_FPU ? EXECUTEFPU.frd : ( RV64CONTROL.IS_LOAD & RV64CONTROL.opCode[0,1] );                    // DETERMINE PRESENT INSTRUCTION RESULT TYPE (FLOAT/INTEGER)
    uint1   write <:: COMMIT & RV64CONTROL.writeRegister;                                                                       // WRITE TO REGISTERS FLAG

    control RV64CONTROL <@clock_CPUdecoder> (                                                                                   // RISC-V   INSTRUCTION DECODER
        SMT <:: SMT,                                                                                                            //          INTEGER REGISTERS
        COMMIT_SMT <: COMMIT_SMT,
        frd <: frd,
        write <: write,
        result <: result,
        instruction <: MEMORY.instruction,
        compressed <: MEMORY.compressed,
        accesssize :> accesssize
    );

    float_control RV64CONTROLF <@clock_CPUdecoder> (                                                                            // RISC-V   FLOATING POINT REGISTERS
        SMT <:: SMT,                                                                                                            //          FLOATING POINT REGISTER CLASSIFIERS
        COMMIT_SMT <: COMMIT_SMT,
        frd <: frd,
        write <: write,
        result <: result,
        instruction <: MEMORY.instruction
    );

    cpuexecuteFASTPATH EXECUTEFAST(                                                                                             // RISC-V SINGLE CYCLE OPERATIONS
        function3 <: RV64CONTROL.function3,
        function7 <: RV64CONTROL.function7,
        memoryinput <: MEMORY.memoryinput,
        AUIPCLUI <: RV64CONTROL.AUIPCLUI,
        nextPC <: RV64CONTROL.nextPC,
        isAUIPCLUI <: RV64CONTROL.IS_AUIPCLUI,
        isJAL <: RV64CONTROL.IS_JAL,
        isFENCE <: RV64CONTROL.IS_FENCE
    );

    alu ALU(                                                                                                                    // SINGLE CYCLE INTEGER OPERATIONS
        OP <: RV64CONTROL.ALUOP,
        immediate <: RV64CONTROL.opCode[3,1],                                                                                   //  IMMEDIATE OR SOURCEREG2 FLAG
        size32 <: RV64CONTROL.opCode[1,1],                                                                                      //  32 BIT OPERATION FLAG
        function3 <: RV64CONTROL.function3, shiftbit6 <: RV64CONTROL.function7[0,1],
        rs1 <: RV64CONTROL.rs1, rs2 <: RV64CONTROL.rs2,
        sourceReg1 <: RV64CONTROL.sourceReg1, sourceReg2 <: RV64CONTROL.sourceReg2,
        immediateValue <: RV64CONTROL.immediateValue,
        LT <: RV64CONTROL.COMPARISONS[2,1], LTU <: RV64CONTROL.COMPARISONS[3,1]
    );

    cpuexecuteSLOWPATH EXECUTESLOW(                                                                                             // RISC-V MULTI-CYCLE OPERATIONS
        SMT <: SMT,
        size32 <: RV64CONTROL.opCode[1,1],
        size32extend <: RV64CONTROL.IS_ALU32SIGNX,
        function3 <: RV64CONTROL.function3,
        function7 <: RV64CONTROL.function7,
        rs1 <: RV64CONTROL.rs1, rs2 <: RV64CONTROL.rs2,
        sourceReg1 <: RV64CONTROL.sourceReg1, S1_abs32 <: RV64CONTROL.S1_abs32, S1_abs64 <: RV64CONTROL.S1_abs64,
        sourceReg2 <: RV64CONTROL.sourceReg2, S2_abs32 <: RV64CONTROL.S2_abs32, S2_abs64 <: RV64CONTROL.S2_abs64,
        memoryinput <: MEMORY.memoryinput,
        isALU <: RV64CONTROL.IS_ALU,
        isCSR <: RV64CONTROL.IS_CSR,
        isATOMIC <: RV64CONTROL.IS_ATOMIC,
        FPUnewflags <: EXECUTEFPU.FPUnewflags,
        CSRupdateFPUflags <: EXECUTEFPU.CSRupdateFPUflags
    );

    cpuexecuteFPU EXECUTEFPU(                                                                                                   // RISC-V FLOATING POINT OPERATIONS
        opCode <: RV64CONTROL.opCode,
        function3 <: RV64CONTROL.function3,
        function7 <: RV64CONTROL.function7,
        rs1 <: RV64CONTROL.rs1, rs2 <: RV64CONTROL.rs2,
        sourceReg1 <: RV64CONTROL.sourceReg1, S1_abs32 <: RV64CONTROL.S1_abs32, S1_abs64 <: RV64CONTROL.S1_abs64,
        sourceReg1F <: RV64CONTROLF.sourceReg1F, sourceReg1Fx <: RV64CONTROLF.sourceReg1Fx, sourceReg1Fxopp <: RV64CONTROLF.sourceReg1Fxopp, typeAF <: RV64CONTROLF.typeAF, typeAopp <: RV64CONTROLF.typeAopp,
        sourceReg2F <: RV64CONTROLF.sourceReg2F, sourceReg2Fx <: RV64CONTROLF.sourceReg2Fx, typeBF <: RV64CONTROLF.typeBF,
        sourceReg3Fx <: RV64CONTROLF.sourceReg3Fx, typeCF <: RV64CONTROLF.typeCF,
        aObINF <: RV64CONTROLF.aObINF, aAbINF <: RV64CONTROLF.aAbINF, aObNAN <: RV64CONTROLF.aObNAN, aObZERO <: RV64CONTROLF.aObZERO, aAbZERO <: RV64CONTROLF.aAbZERO,
        aZEROFRACTION <: RV64CONTROLF.aZEROFRACTION, bZEROFRACTION <: RV64CONTROLF.bZEROFRACTION,
        FLT <: RV64CONTROLF.FLT,
        FEQ <: RV64CONTROLF.FEQ,
        isFASTFPU <: RV64CONTROL.IS_FASTFPU,
        isFPUCONVERT <: RV64CONTROL.IS_FPUCONVERT,
        FPUflags <: EXECUTESLOW.FPUflags
    );

    memory_controller MEMORY(
        clock_CPUdecoder <: clock_CPUdecoder,
        accesssize <: RV64CONTROL.accesssize, IS_MA <: RV64CONTROL.IS_MA, IS_64 <: RV64CONTROL.IS_MEM64,
        IS_FLOAT <:RV64CONTROL.opCode[0,1], IS_UNSIGNED <: RV64CONTROL.function3[2,1],
        loadAddress <: RV64CONTROL.loadAddress, storeAddress <: RV64CONTROL.storeAddress,
        SMT <: SMT, pc <: pc, pcSMT <: pcSMT,
        readdata <: readdata, memorybusy <: memorybusy,
        address :> address,
        writedata :> writedata,
        writememory :> writememory,
        readmemory :> readmemory
    );

    simple_dualport_bram uint$32+L10Ipartaddresswidth$ L10cache <@clock_cache,@clock> [$L10Iblocks$] = uninitialized;           // SMALL ON CPU L1 CACHE - 1 per HART - RESET FENCE MEM IS 1
    simple_dualport_bram uint$32+L11Ipartaddresswidth$ L11cache <@clock_cache,@clock> [$L11Iblocks$] = uninitialized;
    iL10cache_read ICACHE_0 <@clock_cache> ( L1cache <:> L10cache, CLS <: ICACHE_0W.CLS, address <: pc );
    iL11cache_read ICACHE_1 <@clock_cache> ( L1cache <:> L11cache, CLS <: ICACHE_1W.CLS, address <: pcSMT );
    iL10cache_write ICACHE_0W( L1cache <:> L10cache, address <: pc, newinstruction <: MEMORY.instruction[2,30], newcompressed <: MEMORY.compressed );
    iL11cache_write ICACHE_1W( L1cache <:> L11cache, address <: pcSMT, newinstruction <: MEMORY.instruction[2,30], newcompressed <: MEMORY.compressed );

    RV64CONTROL.PC := SMT ? pcSMT : pc;                                                                                         // SELECT PROGRAM COUNTER FOR THIS CYCLE

    ICACHE_0W.update := ~SMT & STATE[3,1] & ~MEMORY.busy; ICACHE_1W.update := SMT & STATE[3,1] & ~MEMORY.busy;                  // UPDATE CPU L1 CACHE FOR MAIN/SMT THREAD FLAG
    ICACHE_0W.invalidate := reset | EXECUTEFAST.fenceACTIVE[0,1];                                                               // CPU L1 CACHE INVALIDATE FLAG, USED AFTER PROGRAM LOAD
    ICACHE_1W.invalidate := reset | EXECUTEFAST.fenceACTIVE[0,1];                                                               // CPU L1 CACHE INVALIDATE FLAG, USED AFTER PROGRAM LOAD

    MEMORY.start := {                                                                                                           // MEMORY CONTROLLER FLAGS
        RV64CONTROL.IS_STORE & ( ( STATE[4,1] & RV64CONTROL.IS_FAST ) | ( STATE[6,1] & ~( EXECUTESLOW.busy | EXECUTEFPU.busy ) ) ),
        STATE[3,1] & RV64CONTROL.IS_LOAD & ~MEMORY.busy,
        STATE[8,1] & ~( DMAREQ | DMA_AUDIO_REQ )
    };
    MEMORY.L1match := ( ~SMT & ICACHE_0.tagmatch ) | ( SMT & ICACHE_1.tagmatch );                                               //  CPU L1 CACHE MATCH FOR PC
    MEMORY.L1instruction := SMT ? ICACHE_1.instruction : ICACHE_0.instruction;                                                  //  L1 instruction
    MEMORY.L1compressed := SMT ? ICACHE_1.compressed : ICACHE_0.compressed;                                                     //  L1 compressed flag
    MEMORY.storedata := RV64CONTROL.IS_FAST ? RV64CONTROL.opCode[0,1] ? RV64CONTROLF.sourceReg2F :                              //  SELECT RESULT TO STORE  FAST FLOATING-POINT REGISTER
                                                                        RV64CONTROL.sourceReg2 :                                //                          FAST INTEGER REGISTER
                                              EXECUTESLOW.memoryoutput;                                                         //                          SLOW ATOMIC MEMORY OPERATION

    DMASTART := STATE[1,1] & DMAREQ; DMA_AUDIO_START := STATE[1,1] &  ~DMAREQ & DMA_AUDIO_REQ;                                  // DMA CONTROLLER START FLAGS
    EXECUTESLOW.start := ( STATE[4,1] & ~RV64CONTROL.IS_FAST & ~RV64CONTROL.IS_FPU ) | ( STATE[5,1] & ~MEMORY.busy );           // CPU CSR, ATOMIC, INTEGER DIVIDE START FLAG
    EXECUTEFPU.start := STATE[4,1] & RV64CONTROL.IS_FPU & ~DELAY;                                                               // CPU FPU START FLAG

    COMMIT := STATE[7,1] & ( ~MEMORY.busy & ~EXECUTESLOW.busy );                                                                // COMMIT TO REGISTERS FLAG
    EXECUTESLOW.incCSRinstret := STATE[7,1] & ( ~MEMORY.busy & ~EXECUTESLOW.busy );                                             //  INCREMENT INSTRUCTION COUNT

    always_after {
        onehot( STATE ) {
            case 0: {                                                                                                           //  STATE_RESET
                if( |resetCounter ) {
                    resetCounter = resetCounter - ~( memorybusy | DMAACTIVE | EXECUTESLOW.busy | EXECUTEFPU.busy |              // -1 WHEN ALL UNITS ARE NO LONGER BUSY
                                                     ICACHE_0W.CLS | ICACHE_1W.CLS | MEMORY.busy );
                } else {
                    STATE = $STATE_NEXT$;
                }
            }
            case 1: {                                                                                                           //  STATE_DMA
                if( DMAREQ | DMA_AUDIO_REQ ) { DMAREQUESTED = 1; STATE = $STATE_DMA_WAIT$; }
            }
            case 2: {                                                                                                           // STATE_DMA_WAIT
                if( DMAREQUESTED ) {
                    DMAREQUESTED = 0;
                } else {
                    if( ~( DMAREQ | DMAACTIVE | DMA_AUDIO_ACTIVE ) ) { STATE = $STATE_NEXT$; }
                }
            }
            case 3: {                                                                                                           //  STATE_FETCH
                if( ~MEMORY.busy ) {
                    RV64CONTROL.cacheselect = 1; COMMIT_SMT = SMT;                                                              //      LATCH THREAD MAIN/SMT, DATA CACHE
                    DELAY = RV64CONTROL.IS_FPU;                                                                                 //      DELAY FOR FPU REGISTER PROPAGATION
                    STATE = RV64CONTROL.IS_LOAD ? RV64CONTROL.IS_FAST ? $STATE_COMMIT$ : $STATE_LOAD$ : $STATE_EXEC$;           //      LOAD? COMMIT OR MULTI ELSE EXEC
                }
            }
            case 4: {                                                                                                           // STATE_EXEC
                if( RV64CONTROL.IS_FAST ) {                                                                                     //      FAST OR START STORE?
                    STATE = $STATE_COMMIT$;                                                                                     //      FAST -> COMMIT ELSE -> MULTI FOR ATOMIC
                } else {
                    if( RV64CONTROL.IS_FPU ) {                                                                                  //      START FPU ( after propogation delay )
                        STATE = DELAY ? $STATE_EXEC$ : $STATE_MULTI$; DELAY = 0;                                                //      FPU
                    } else {
                        STATE = ( RV64CONTROL.IS_CSR | RV64CONTROL.IS_ATOMIC ) ? $STATE_MULTI$ :                                //      MULTICYCLE CSR ATOMIC -> MULTI
                                                                                 $STATE_COMMIT$;                                //      DIVISION -> COMMIT
                    }
                }
            }
            case 5: { if( ~MEMORY.busy ) { STATE = $STATE_MULTI$; } }                                                           // STATE LOAD WAIT FOR ATOMIC MEMORY OPERATIONS
            case 6: {                                                                                                           // STATE_MULTI
                if( ~( EXECUTESLOW.busy | EXECUTEFPU.busy ) ) {
                    STATE = $STATE_COMMIT$;                                                                                     //  WAIT FOR CSR, ATOMIC, DIVISION, FLOATING-POINT TO FINISH
                }
            }
            case 7: {                                                                                                           //  STATE_COMMIT
                if( ~MEMORY.busy & ~EXECUTESLOW.busy ) {                                                                        //      WAIT FOR LOAD/STORE/DIVIDE TO FINISH
                    pc = SMT ? pc : RV64CONTROL.newPC; pcSMT = SMT ? RV64CONTROL.newPC : SMTRUNNING ? pcSMT : SMTSTARTPC;       //      MOVE TO NEXT INSTRUCTION
                    if( ~EXECUTEFAST.fenceACTIVE[1,1] ) { SMT = ~SMT & SMTRUNNING; }                                            //      SWITCH THREADS IF ACTIVE AND NOT FENCED
                    STATE = $STATE_NEXT$;
                }
            }
            case 8: {                                                                                                           //  STATE_NEXT
                { RV64CONTROL.cacheselect = ( DMAREQ | DMA_AUDIO_REQ ); }                                                       // SELECT DATA CACHE FOR DMA, INSTRUCTION CACHE FOR FETCH
                { STATE = ( DMAREQ | DMA_AUDIO_REQ ) ? $STATE_DMA_START$ : $STATE_FETCH$; }
            }
        }
    }
}

unit cpuexecuteFASTPATH(
    input   uint3   function3,
    input   uint7   function7,
    input   int64   memoryinput,
    input   uint64  AUIPCLUI,
    input   uint$addr_width$  nextPC,
    input   uint1   isAUIPCLUI,
    input   uint1   isJAL,
    input   uint1   isFENCE,
    output  int64   result,
    output  uint2   fenceACTIVE(0)
) <reginputs> {
    always_after {
        { result = isAUIPCLUI ? AUIPCLUI :                                                                                      // LUI AUIPC
                        isJAL ? nextPC :                                                                                        // JAL[R]
                                memoryinput; }                                                                                  // INTEGER/FLOAT LOAD SIGN EXTENDED/NAN BOIXED BY LOAD UNIT

        { fenceACTIVE = isFENCE ? { |function7[1,2], ~function3[0,1] } : fenceACTIVE; }                                         // SET FENCE ACTIVE { IO, MEM }
    }
}

unit cpuexecuteSLOWPATH(
    input   uint1   size32,
    input   uint1   size32extend,
    input   uint1   start,
    output  uint1   busy(0),
    input   uint1   SMT,
    input   uint3   function3,
    input   uint7   function7,
    input   uint5   rs1,
    input   uint5   rs2,
    input   int64   sourceReg1,
    input   uint32  S1_abs32,
    input   uint64  S1_abs64,
    input   int64   sourceReg2,
    input   uint32  S2_abs32,
    input   uint64  S2_abs64,
    input   int64   memoryinput,
    output  int64   memoryoutput,
    output  int64   result,
    input   uint1   incCSRinstret,
    input   uint1   isCSR,
    input   uint1   isATOMIC,
    input   uint1   isALU,
    output  uint8   FPUflags,
    input   uint5   FPUnewflags,
    input   uint1   CSRupdateFPUflags
) <reginputs> {
    uint3   STATE = 1;
        $$ STATE_CPUSLOW_IDLE       = 1
        $$ STATE_CPUSLOW_CSR_ATOMIC = 2
        $$ STATE_CPUSLOW_DIVISION   = 4

    uint3   operation <:: { isALU, isATOMIC, isCSR };                                                                           // DETERMINE OPERATION, DIVIDE, AMO, CSR

    aluA ALUA(                                                                                                                  // ATOMIC MEMORY OPERATIONS
        function7 <: function7[2,5], memoryinput <: memoryinput, sourceReg2 <: sourceReg2
    );

    CSRblock CSR(                                                                                                               // RISC-V CSR REGISTERS
        SMT <: SMT,                                                                                                             //  HARTID == 0 MAIN THREAD == 1 SMT THREAD
        function3 <: function3,
        rs1 <: rs1,
        sourceReg1 <: sourceReg1,
        FPUflags :> FPUflags,
        FPUnewflags <: FPUnewflags,
        updateFPUflags <: CSRupdateFPUflags,
        incCSRinstret <: incCSRinstret
    );

    aludivision ALUMD(                                                                                                          // INTEGER 32/64 BIT SIGNED/UNSIGNED DIVISION
        size32 <: size32, function3 <: function3,
        sourceReg1 <: sourceReg1, S1_abs32 <: S1_abs32, S1_abs64 <: S1_abs64,
        sourceReg2 <: sourceReg2, S2_abs32 <: S2_abs32, S2_abs64 <: S2_abs64
    );

    CSR.start := start & isCSR & |function3; ALUMD.start := start & isALU;                                                      // START FLAGS
    busy := ( STATE[0,1] & start ) | ( STATE[2,1] & ALUMD.busy );

    always_after {
        { CSR.csrRegister = { function7, rs2 }; }                                                                               // EXTRACT CSR REGISTER NUMBER FROM INSTRUCTION

        { onehot( STATE ) {
            case 0: {                                                                                                           // WAIT FOR START
                { if( start ) {
                    onehot( operation ) {
                        default: { STATE = $STATE_CPUSLOW_CSR_ATOMIC$; }                                                        //  CSR OR ATOMIC-MEMORY-OPERATION
                        case 2: { STATE = $STATE_CPUSLOW_DIVISION$; }                                                           //  DIVISION
                    }
                } }
            }
            case 1: { STATE = $STATE_CPUSLOW_IDLE$; }                                                                           // CSR OR AMO
            case 2: { if( ~ALUMD.busy ) { STATE = $STATE_CPUSLOW_IDLE$; } }                                                     // DIVISION
        } }

        { result = isCSR ? |function3 ? CSR.result : 0 :                                                                        //  CSR
                   isATOMIC ? function7[3,1] ? memoryinput : function7[2,1] ? 0 : memoryinput :                                 //  ATOMIC LOAD - MODIFY - STORE
                                    size32  & size32extend ? { {32{ALUMD.result[31,1]}}, ALUMD.result[0,32] } : ALUMD.result; } //  INTEGER DIVISION, WITH SIGN EXTENSION FOR 32 BIT

        { memoryoutput = function7[3,1] ? ALUA.result : sourceReg2; }                                                           //  ATOMIC LOAD - MODIFY - STORE OR LR.W SC.W - MEMORYOUTPUT
    }
}

unit cpuexecuteFPU(
    input   uint1   start,
    output  uint1   busy,
    input   uint5   opCode,
    input   uint3   function3,
    input   uint7   function7,
    input   uint5   rs1,
    input   uint5   rs2,
    input   int64   sourceReg1,
    input   uint32  S1_abs32,
    input   uint64  S1_abs64,
    input   uint64  sourceReg1F,
    input   uint64  sourceReg1Fx,
    input   uint64  sourceReg1Fxopp,
    input   uint4   typeAF,
    input   uint4   typeAopp,
    input   uint64  sourceReg2F,
    input   uint64  sourceReg2Fx,
    input   uint4   typeBF,
    input   uint64  sourceReg3Fx,
    input   uint4   typeCF,
    input   uint1   aObINF,                                                                                                     // EITHER A OR B INF?
    input   uint1   aAbINF,                                                                                                     // BOTH A AND B INF?
    input   uint1   aObNAN,                                                                                                     // EITHER A OR B NAN?
    input   uint1   aObZERO,                                                                                                    // EITHER A OR B ZERO?
    input   uint1   aAbZERO,                                                                                                    // BOTH A AND B ZERO?
    input   uint1   aZEROFRACTION,                                                                                              // A FRACTION PART 0, POWER OF 2 OR TRUE ZERO DETECTION
    input   uint1   bZEROFRACTION,                                                                                              // B FRACTION PART 0, POWER OF 2 OR TRUE ZERO DETECTION
    input   uint1   FLT,
    input   uint1   FEQ,
    output  uint1   frd,
    output  int64   result,
    input   uint1   isFASTFPU,
    input   uint1   isFPUCONVERT,
    input   uint8   FPUflags,
    output  uint5   FPUnewflags,
    output  uint1   CSRupdateFPUflags
) <reginputs> {
    uint3   STATE = 1;
        $$ STATE_FPU_IDLE           = 1
        $$ STATE_FPU_CALC           = 2
        $$ STATE_FPU_CALC_FINISH    = 4

    uint10  BIAS <:: function7[0,1] ? $BIAS64$ : function7[1,1] ? $BIAS16$ : $BIAS32$;                                          // SELECT BIAS
    uint3   operation <:: { ~( isFASTFPU | isFPUCONVERT ), isFPUCONVERT, isFASTFPU & ~isFPUCONVERT };                           // PRESENT INSTRUCTION ROUTE

    fpuSINGLECYCLE FPUFAST(                                                                                                     // FLOATING POINT SINGLE CYCLE OPERATIONS
        dsh <: function7[0,2],
        function3 <: function3[0,2], function7 <: function7[2,5],
        rs1 <: rs1, rs2 <: rs2,
        sourceReg1 <: sourceReg1, sourceReg1F <: sourceReg1F, sourceReg2F <: sourceReg2F,
        sign1F <: fp64( sourceReg1Fx ).sign, sign2F <: fp64( sourceReg2Fx ).sign,
        typeAF <: typeAF, typeBF <: typeBF,
        aObNAN <: aObNAN,
        aZEROFRACTION <: aZEROFRACTION,
        FLT <: FLT, FEQ <: FEQ
    );

    floatcalc FPUCALC(                                                                                                          // FLOATING POINT CALCULATIONS CONTROLLER
        dsh <: function7[0,2],                                                                                                  //  RETURNS RESULT WIDE PACKED IN DOUBLE BITFIELDS
        BIAS <: BIAS,
        opCode <: opCode, function3 <: function3, function7 <: function7[2,5],
        sourceReg1Fx <: sourceReg1Fx, sourceReg2Fx <: sourceReg2Fx, sourceReg3Fx <: sourceReg3Fx,
        typeAF <: typeAF, typeBF <: typeBF, typeCF <: typeCF,
        aObINF <: aObINF, aAbINF <: aAbINF, aObNAN <: aObNAN, aObZERO <: aObZERO, aAbZERO <: aAbZERO,
        aZEROFRACTION <: aZEROFRACTION, bZEROFRACTION <: bZEROFRACTION
    );
    repackage_actual CALCRESULT( dsh <: function7[0,2], a <: FPUCALC.result );                                                  // REPACKAGE CALCULATION RESULT INTO CORRECT BITFIELDS

    intlong2float FPUIL2F(                                                                                                      // INTEGER TO FLOATING-POINT CONVERSION
        rm <: function3[0,2], dounsigned <: rs2[0,1], il <: rs2[1,1], dsh <: function7[0,2], BIAS <: BIAS,                      //  FLAGS ROUNDING, UNSIGNED, 32/64-BIT, HALF/SINGLE/DOUBLE
        sourceReg1 <: sourceReg1, S1_abs32 <: S1_abs32, S1_abs64 <: S1_abs64
    );
    float2intlong FPUF2IL(                                                                                                      // FLOTING-POINT TO INTEGER CONVERSION
        rm <: function3[0,2], dounsigned <: rs2[0,1], domod <: rs2[3,1], il <: rs2[1,1], BIAS <: BIAS,                          //  FLAGS ROUNDING, UNSIGNED, MODULAR CONVERTR, 32/64-BIT
        sourceReg1Fx <: sourceReg1Fx, typeAF <: typeAF
    );
    floatchangeprecision FPUF_CP(                                                                                               // FLOATING-POINT CHANGE PRECISION
        rm <: function3[0,2], dest <: function7[0,2], DBIAS <: BIAS, source <: rs2[0,2],                                        //  FLAGS ROUNDING, DESTINATION PRECISION, SOUCRE PRECISION
        sourceReg1Fx <: sourceReg1Fxopp, typeAF <: typeAopp
    );
    floatround FPUROUND(                                                                                                        // FLOATING-POINT ROUND ROUNDNX
        rm <: function3[0,2], dsh <: function7[0,2], nx <: rs2[0,1], BIAS <: BIAS,                                              //  FLAGS ROUNDING, HALF/SINGLE/DOUBLE, NX
        sourceReg1F <:sourceReg1F, sourceReg1Fx <:sourceReg1Fx, typeAF <: typeAF
    );

    FPUF_CP.SBIAS := rs2[0,1] ? $BIAS64$ : rs2[1,1] ? $BIAS16$ : $BIAS32$;                                                      // SELECT BIAS ( SOURCE FOR CHANGE PRECISION )
    FPUCALC.start := ~( isFASTFPU | isFPUCONVERT ) & start;                                                                     // FPU CALCULATIONS START FLAG
    FPUCALC.rm := &FPUflags[5,3] ? function3[0,2] : FPUflags[5,2];                                                              // SET ROUNDING FLAG, FCSR UNLESS 111
    CSRupdateFPUflags := ( STATE[0,1] & ( isFASTFPU | isFPUCONVERT ) ) | STATE[2,1];                                            // UPDATE CSR FPU FLAGS
    busy := ( STATE[0,1] & start & ~( isFASTFPU | isFPUCONVERT ) ) | STATE[1,1];

    always_after {
        { onehot( STATE ) {
            case 0: {
                if( start ) {                                                                                                   // START FPU OPERATION
                    onehot( operation ) {
                        default: {}                                                                                             //  CONVERSION/ROUNDING OR SINGLE-CYCLE OPERATION
                        case 2: { STATE = $STATE_FPU_CALC$; }                                                                   //  CALCULATION
                    }
                }
            }
            case 1: { if( ~FPUCALC.busy ) { STATE = $STATE_FPU_CALC_FINISH$; } }                                                // WAIT FOR FPU CALCULATION TO FINISH
            case 2: { STATE = $STATE_FPU_IDLE$; }                                                                               // CALCULATION FINISHED
        } }

        { result = ( isFASTFPU & ~isFPUCONVERT ) ? FPUFAST.result :                                                             // COLLECT THE APPROPRIATE RESULT
                   isFPUCONVERT ? ( function7[2,5] == 5b11000 ) ? FPUF2IL.result :                                              //  FD2IL
                                    ( function7[2,5] == 5b11010 ) ? FPUIL2F.result :                                            //  IL2FD
                                                       rs2[2,1] ? FPUROUND.result : FPUF_CP.result :                            //  ROUND OR CHANGE PRECISION
                                    CALCRESULT.repack; }
        { frd = isFPUCONVERT ? ( function7[2,5] != 5b11000 ) : ( isFASTFPU | isFPUCONVERT ) ? FPUFAST.frd : 1; }                // WRITE TO F REGISTERS FLAG ( NOT FD2IL )
        { FPUnewflags = FPUflags | (                                                                                            // MERGE OLD AND NEW FLAGS
                                    isFPUCONVERT ? ( function7[2,5] == 5b11000 ) ? FPUF2IL.FPUflags :                           //  FD2IL
                                                   ( function7[2,5] == 5b11010 ) ? FPUIL2F.FPUflags :                           //  IL2FD
                                                                      rs2[2,1] ? FPUROUND.FPUflags : FPUF_CP.FPUflags :         //  ROUND OR CHANGE PRECISION
                                      ~( isFASTFPU | isFPUCONVERT ) ? FPUCALC.FPUnewflags :
                                                                      FPUFAST.FPUnewflags
                                ); }

    }
}

unit memory_controller(
    input   uint1   clock_CPUdecoder,
    input   uint3   start,                                                                                                      // { STORE, LOAD, FETCH }
    output  uint1   busy,

    input   uint2   accesssize,
    input   uint1   IS_MA,
    input   uint1   IS_64,
    input   uint1   IS_FLOAT,
    input   uint1   IS_UNSIGNED,

    output  uint$addr_width$ address,
    input   uint1   memorybusy,
    output  uint1   writememory,
    output  uint32  writedata,
    output  uint1   readmemory,
    input   uint32  readdata,

    input   uint1   SMT,
    input   uint$addr_width$ pc,
    input   uint$addr_width$ pcSMT,
    input   uint$addr_width$ loadAddress,
    input   uint$addr_width$ storeAddress,

    output  uint32  instruction,
    output  uint1   compressed,

    input   uint1   L1match,
    input   uint30  L1instruction,
    input   uint1   L1compressed,

    output  uint64  memoryinput,
    input   uint64  storedata
) <reginputs> {
    uint5   STATE = 1;
        $$ STATE_FSL_WAIT       = 1

        $$ STATE_FETCH_READ     = 2
        $$ STATE_FETCH_COMPLETE = 4

        $$ STATE_LOAD_MEMBUSY   = 8
        $$ STATE_LS_NEXT        = 16

    uint3   ACTION = uninitialised;
    uint4   count = uninitialised;                                                                                              // NUMBER OF MEMORY OPERATION

    compressed00 COMPRESSED00 <@clock_CPUdecoder> ( i16 <: readdata[2,14] );                                                    // COMPRESSED INSTRUCTION EXPANDERS
    compressed01 COMPRESSED01 <@clock_CPUdecoder> ( i16 <: readdata[2,14] );
    compressed10 COMPRESSED10 <@clock_CPUdecoder> ( i16 <: readdata[2,14] );

    signnanbox LOAD(                                                                                                            // SIGN EXTEND IF SIGNED LOAD, OR NAN-BOX FOR FLOAT LOAD
        floatload <: IS_FLOAT,                                                                                                  //  IS FLOAT LOAD
        dounsigned <: IS_UNSIGNED,                                                                                              //  IS UNSIGNED INTEGER LOAD
        accesssize <: accesssize,                                                                                               //  IS 8 BIT, 16, BIT, 32, 64 BIT LOAD
        byteaccess <: loadAddress[0,1],                                                                                         //  ADDRESS LINE 0 FOR 8 BIT LOAD
        readdata :> memoryinput                                                                                                 //  OUTPUT LOAD RESULT
    );

    readmemory := 0; writememory := 0;

    always_after {
        { if( STATE[4,1] & ~memorybusy & ACTION[1,1] ) {                                                                        //  IF LOAD, PACK READDATA INTO MEMORY INPUT
            if( IS_MA ) {
                LOAD.memoryinput[ { count, 3b000 }, 8 ] = readdata[ { address[0,1], 3b000 }, 8 ];                               //  SINGLE BYTE FOR MISALIGNED LOADS
            } else {
                LOAD.memoryinput[ { count[0,1], 5b00000 }, 32 ] = readdata;                                                     //  8/16/32 BITS FOR ALIGNED LOADS
            }
        } }

        { onehot( STATE ) {
            case 0: {
                { if( |start ) {                                                                                                // WAIT FOR START
                    { count = 0; } { LOAD.memoryinput = 0; }                                                                    //  0 COUNT AND MEMORY INPUT
                    { address = start[0,1] ? SMT ? pcSMT : pc : start[1,1] ? loadAddress : storeAddress; }                      //  SET FIRST ADDRESS
                    { ACTION = start; }

                    { onehot( start ) {                                                                                         // SEND TO { STORE, LOAD, FETCH }
                        case 0: {
                            if( L1match ) {
                                { instruction = { L1instruction, 2b11 }; } { compressed = L1compressed; }                       //  FETCH FROM L1 CACHE
                            } else {
                                STATE = $STATE_FETCH_READ$;                                                                     //  FETCH FROM MEMORY
                            }
                        }
                        case 1: { STATE = $STATE_LOAD_MEMBUSY$; }                                                               //  LOAD FROM MEMORY
                        case 2: { STATE = $STATE_LS_NEXT$; }                                                                    //  STORE TO MEMORY
                    } }
                } }

                { busy = |start[1,2] | ( start[0,1] & ~L1match ); }
                { readmemory = start[1,1] | ( start[0,1] & ~L1match ); }
                { writedata = storedata; }
                { writememory = start[2,1]; }
            }

            case 1: { if( ~memorybusy ) { STATE = $STATE_FETCH_COMPLETE$; } }                                                   // WAIT FOR MEMORYREAD TO COMPLETE
            case 2: {                                                                                                           // PACK FETCHED INSTRUCTION
                { compressed = ~&readdata[0,2]; }                                                                               //  SET COMPRESSED FLAGS
                { instruction = { &readdata[0,2] ? readdata[2,30] :                                                             //  32 BIT INSTRUCTION READ
                                 ~|readdata[0,2] ? COMPRESSED00.i32 :                                                           //  16 BIT INSTRUCTION READ block 00
                                   readdata[0,1] ? COMPRESSED01.i32 :                                                           //                          block 01
                                                   COMPRESSED10.i32, 2b11 }; }                                                  //                          block 10, plus trailing 11
                { busy = 0; } { STATE = $STATE_FSL_WAIT$; }                                                                     // FINISHED FETCH
            }

            case 3: { if( ~memorybusy ) { STATE = $STATE_LS_NEXT$; } }                                                          // WAIT FOR MEMORYREAD TO COMPLETE
            case 4: {
                if( ~memorybusy ) {                                                                                             // WAIT FOR MEMORYWRITE TO COMPLETE
                    if( ( count + 1 ) == ( IS_MA ? ( 1 << accesssize ) : IS_64 ? 2 : 1 ) ) {
                        { busy = 0; } { STATE = $STATE_FSL_WAIT$; }                                                             //  FINISHED LOAD/STORE
                    } else {
                        { writedata = IS_MA ? storedata[ { count + 4d1, 3b000 }, 8 ] : storedata[ 32, 32 ]; }                   // SET MEMORY OUTPUT TO PRESENT STORE PART
                        { count = count + 1; } { address = address + ( IS_MA ? 1 : 4 ); }                                       //  MOVE TO NEXT PART, 8 bit MA or NEXT 32 BITS FOR 64 BITS
                        { writememory = ACTION[2,1]; } { readmemory = ACTION[1,1]; }
                        { STATE = ACTION[2,1] ? $STATE_LS_NEXT$ : $STATE_LOAD_MEMBUSY$; }
                    }
                }
            }
        } }
    }
}

unit signnanbox(                                                                                                                // SIGN EXTEND/NAN BOX MEMORYINPUT
    input   uint1   floatload,
    input   uint1   dounsigned,
    input   uint2   accesssize,
    input   uint1   byteaccess,
    input   uint64  memoryinput,
    output  uint64  readdata
) <reginputs> {
    always_after {
        switch( accesssize ) {
            case 2b00: {                                                                                                        // SIGN EXTEND 8 BIT LOAD ( not for floats )
                readdata = { {56{~dounsigned & memoryinput[ { byteaccess, 3b111 }, 1 ]}}, memoryinput[ { byteaccess, 3b000 }, 8 ] };
            }
            case 2b01: { readdata = { {48{floatload | ( ~dounsigned & memoryinput[ 15, 1] )}}, memoryinput[0,16] }; }           // SIGN EXTEND / NAN BOX 16 BIT LOAD
            case 2b10: { readdata = { {32{floatload | ( ~dounsigned & memoryinput[ 31, 1] )}}, memoryinput[0,32] }; }           // SIGN EXTEND / NAN BOX 32 BIT LOAD
            case 2b11: { readdata = memoryinput; }                                                                              // COPY 64 BIT LOAD
        }
    }
}
