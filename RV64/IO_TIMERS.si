unit timers_memmap(
    input   uint1               CS,

    input   uint6               ADDR,
    input   uint1               WENABLE,
    input   uint1               RENABLE,
    input   uint32              WDATA,
    output  uint32              RDATA,

    output  uint16              static16bit,                                                                                    // RNG + CURSOR BLINK
    output  uint1               cursor
) {
    random RNG( g_noise_out :> static16bit );                                                                                   // RNG random number generator

    timesinceboot P1( counter1hz :> cursor );                                                                                   // 1hz  SYSTEMCLOCK
    P1.resettime := 0;

    always {
        uint$CWIDTH$  LATCHseconds = uninitialised; uint20  LATCHmilliseconds = uninitialised;                                  // LATCH TIME OF DAY SO READ RETURNS THE SAME TIME

        if( CS & WENABLE ) {                                                                                                    // WRITE IO Memory
            switch( ADDR[2,2] ) {
                case 2h0: { P1.newtime[0,32] = WDATA; }                                                                         // SET CLOCK TIME
                case 2h1: { P1.newtime[32,$CWIDTH-32$] = WDATA; }
                default: { P1.resettime = 1; }
            }
        }

        if( CS & RENABLE ) {                                                                                                    // READ IO Memory
            if( ADDR[5,1] ) {
                switch( ADDR[2,2] ) {
                    default: { LATCHseconds = P1.counter1hz; LATCHmilliseconds = P1.counter1mhz; RDATA = P1.counter1hz[0,32]; }
                    case 2h1: { RDATA = LATCHseconds[32,$CWIDTH-32$]; }
                    case 2h2: { RDATA = LATCHmilliseconds; }
                }
            } else {
                switch( ADDR[1,2] ) {
                    default: { RDATA = RNG.g_noise_out; }                                                                       // RANDOM NUMBER GENERATOR 0
                    case 4h1: { RDATA = RNG.u_noise_out; }                                                                      // RANDOM NUMBER GENERATOR 1
                    case 4h2: { RDATA = { RNG.u_noise_out[0,7], RNG.g_noise_out, RNG.u_noise_out[7,7] }; }                      // COMBINE TO FLOATING POINT RNG
                }
            }
        }
     }
}

// Create a 1KHz pulse
unit pulse_1khz(
    output  uint1               PULSE_1KHZ
) {
    uint16              counter50mhz = 0;
    uint16              counter50mhz_NEXT <:: counter50mhz + 1;

    PULSE_1KHZ := 0;

    always {
        if( counter50mhz == 50000 ) { PULSE_1KHZ = 1; counter50mhz = 0; } else { counter50mhz = counter50mhz_NEXT; }
    }
}

// Create seconds and milliseconds since boot
unit timesinceboot(
    output  uint$CWIDTH$        counter1hz(0),
    input   uint$CWIDTH$        newtime,
    output  uint20              counter1mhz(0),
    input   uint1               resettime
) {
    uint6               counter50mhz = uninitialised;
    uint6               counter50mhz_m1 <:: counter50mhz - 1;
    uint20              counter1mhz_p1 <:: counter1mhz + 1;
    uint$CWIDTH$        counter1hz_p1 <:: counter1hz + 1;
    uint2               ACTION <:: { counter1mhz == 1000000, ~|counter50mhz };

    always {
        if( resettime ) {
            counter1hz = newtime; counter1mhz = 0; counter50mhz = 50;
        } else {
            switch( ACTION ) {
                case 2b00: { counter50mhz = counter50mhz_m1; }
                case 2b01: { counter1mhz = counter1mhz_p1; counter50mhz = 50; }
                default: { counter1hz = counter1hz_p1; counter1mhz = 0; counter50mhz = 50; }
            }
        }
    }
}

// 16 bit random number generator
// Translation into Silice of LFSR_Plus.v
unit random(
    output  uint16              g_noise_out,
    output  uint16              u_noise_out,
) {
    uint16              rand_ff = 24b011000110111011010011101;
    uint18              rand_en_ff = 24b001100010011011101100101;

    uint16              temp_u_noise3 = uninitialised;
    uint16              temp_u_noise2 = uninitialised;
    uint16              temp_u_noise1 = uninitialised;
    uint16              temp_u_noise0 = uninitialised;

    temp_u_noise0 := temp_u_noise1; temp_u_noise1 := temp_u_noise2; temp_u_noise2 := temp_u_noise3; temp_u_noise3 := { rand_ff[15,1], rand_ff[15,1], rand_ff[2,13] };
    g_noise_out := ( rand_en_ff[17,1] ) ? ( temp_u_noise3 + temp_u_noise2 + temp_u_noise1 + temp_u_noise0 + ( rand_en_ff[9,1] ? g_noise_out : 0 ) ) :
                   ( rand_en_ff[10,1] ) ? rand_ff : g_noise_out;
    u_noise_out := ( rand_en_ff[17,1] ) ? rand_ff : u_noise_out;
    rand_en_ff := { ( rand_en_ff[7,1] ^ rand_en_ff[0,1] ), rand_en_ff[1,17] };
    rand_ff := { ( rand_ff[5,1] ^ rand_ff[3,1] ^ rand_ff[2,1] ^ rand_ff[0,1] ), rand_ff[1,15] };
}
