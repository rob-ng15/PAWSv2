 * THIS SOFTWARE IS PROVIDED BY THE REGENTS AND CONTRIBUTORS "AS IS", AND ANY
 * EXPRESS OR IMPLIED WARRANTIES, INCLUDING, BUT NOT LIMITED TO, THE IMPLIED
 * WARRANTIES OF MERCHANTABILITY AND FITNESS FOR A PARTICULAR PURPOSE, ARE
 * DISCLAIMED.  IN NO EVENT SHALL THE REGENTS OR CONTRIBUTORS BE LIABLE FOR ANY
 * DIRECT, INDIRECT, INCIDENTAL, SPECIAL, EXEMPLARY, OR CONSEQUENTIAL DAMAGES
 * (INCLUDING, BUT NOT LIMITED TO, PROCUREMENT OF SUBSTITUTE GOODS OR SERVICES;
 * LOSS OF USE, DATA, OR PROFITS; OR BUSINESS RESULTERRUPTION) HOWEVER CAUSED AND
 * ON ANY THEORY OF LIABILITY, WHETHER IN CONTRACT, STRICT LIABILITY, OR TORT
 * (INCLUDING NEGLIGENCE OR OTHERWISE) ARISING IN ANY WAY OUT OF THE USE OF
 * THIS SOFTWARE, EVEN IF ADVISED OF THE POSSIBILITY OF SUCH DAMAGE.
 *
 * =============================================================================*/

unit floatcompare(
    input   uint64  a,                                                                                                          // A INPUT FOR A<B OR A==B ( repacked into double bitfields )
    input   uint64  b,                                                                                                          // B INPUT FOR A<B OR A==B ( repacked into double bitfields )
    input   uint1   F1_OR_F2_NAN,                                                                                               // { INF sNAN qNAN ZERO } FOR A
    input   uint1   F1_AND_F2_ZERO,                                                                                             // A == 0 AND B == 0?
    input   uint1   F1_ZERO_FRACTION,                                                                                           // A FRACTION == 0?
    input   uint1   F2_ZERO_FRACTION,                                                                                           // B FRACTION == 0?
    output  uint1   less,                                                                                                       // A < B FLAG
    output  uint1   equal                                                                                                       // A == B FLAG
) {
    uint1   aequalb <:: ( a == b );                                                                                             // A == B ( BITSTREAM )
    uint1   abTRUEZERO <:: F1_AND_F2_ZERO & F1_ZERO_FRACTION & F2_ZERO_FRACTION;                                                // A == 0 & B == 0 ( NOT SUBNORMAL )

    less := ~F1_OR_F2_NAN & ( ( fp64( a ).sign ^ fp64( b ).sign ) ? fp64( a ).sign & ~abTRUEZERO : ~aequalb & ( fp64( a ).sign ^ ( __unsigned( a ) < __unsigned( b ) ) ) );
    equal := ~F1_OR_F2_NAN & ( aequalb | abTRUEZERO );
}




// ARCHIVED MODULES TO PERFORM FLOAT ADDITION/SUBTRACTION/MULTIPLICATION
// REPLACED BY USING FUSED MULTIPLY AND ADD WITH MODIFIED INPUTS

// ADDSUB ADD/SUBTRACT TWO FLOATING POINT NUMBERS ( SUBTRACT ACHIEVED BY ALTERING SIGN OF SECOND INPUT )
// ( NOT USED BY PAWS, ADDITION/SUBTRACTION IS DONE AS FUSED A*1.0+B or A*1.0-B )
unit do_addsub_align(                                                                                                           // ALIGN FRACTIONS BASED UPON EXPONENTS
    input   uint10  BIAS,                                                                                                       // BIAS FOR DOUBLE/SINGLE/HALF
    input   uint11  expA,                                                                                                       // EXPONENT OF A INCLUDING BIAS
    input   uint52  fractionA,                                                                                                  // FRACTION OF A ( no leading 1 bit )
    input   uint11  expB,                                                                                                       // EXPONENT OF B INCLUDING BIAS
    input   uint52  fractionB,                                                                                                  // FRACTION OF B ( no leading 1 bit )
    output  uint106 sigA,                                                                                                       // ALIGNED FRACTION OF A ( including leading 1 bit )
    output  uint106 sigB,                                                                                                       // ALIGNED FRACTION OF B ( including leading 1 bit )
    output  int13   RESULTexp                                                                                                   // PROVISIONAL EXPONENT OF RESULT
) {
    uint1   expAvexpB <:: ( expA < expB );                                                                                      // FIND SMALLEST EXPONENT
    uint11  shift <:: ( expAvexpB ? expB : expA ) - ( expAvexpB ? expA :expB );                                                 // FIND THE SHIFT FOR ALIGNMENT

    sigA := { 2b01, fractionA, 52b0 } >> ( expAvexpB ? shift : 0 );                                                             // GENERATE A FROM FRACTION, ALIGN IF SMALLER
    sigB := { 2b01, fractionB, 52b0 } >> ( expAvexpB ? 0 : shift );                                                             // GENERATE B FROM FRACTION, ALIGN IF SMALLER
    RESULTexp := ( expAvexpB ? expB : expA ) - ( { BIAS[1,9], 1b0 } );                                                          // RESULT EXPONENT IS LARGEST EXPONENT, remove ( bias - 1 )
                                                                                                                                // FOR OVERFLOW
}
unit do_float_addsub(
    input   uint1   signA,
    input   uint106 sigA,
    input   uint1   signB,
    input   uint106 sigB,
    output  uint1   RESULTsign,
    output  uint106 RESULTfraction
) {
    uint1   AvB <:: ( __unsigned( sigA ) > __unsigned( sigB ) );                                                                // FIND LARGEST FRACTION ( when exponents are equal )
    uint1   sign <:: ( signA ^ signB ) ? ( signA ? AvB : ~AvB ) : signA;                                                        // DETERMINE RESULT SIGN

    RESULTsign := sign;                                                                                                         // RETURN RESULT SIGN
    RESULTfraction := ( signA ^ signB ) ? ( signA ^ sign ? sigB : sigA ) - ( signA ^ sign ? sigA : sigB ) : ( sigA + sigB );    // DIFFERING SIGNS, SUBTRACTION OR SAME SIGNS ADDITION
}
unit floataddsub(
    input   uint1   START,
    output  uint1   BUSY,
    input   uint10  BIAS,                                                                                                       // BIAS FOR DOUBLE/SINGLE/HALF
    input   uint64  a,                                                                                                          // A INPUT FOR A+B OR A-B
    input   uint64  b,                                                                                                          // B INPUT FOR A+B OR A-B
    input   uint1   aINF,                                                                                                       // A is INF?
    input   uint1   bZERO,                                                                                                      // B is ZERO?
    input   uint1   F1_OR_F2_INF,                                                                                               // EITHER A OR B INF?
    input   uint1   F1_AND_F2_INF,                                                                                              // BOTH A AND B INF?
    input   uint1   F1_OR_F2_NAN,                                                                                               // EITHER A OR B NAN?
    input   uint1   F1_OR_F2_ZERO,                                                                                              // EITHER A OR B ZERO?
    input   uint1   F1_AND_F2_ZERO,                                                                                             // BOTH A AND B ZERO?
    input   uint1   OF,
    input   uint1   UF,
    output  uint5   flags,                                                                                                      // OPERATION FLAGS
    output  uint7   special,
    output  uint1   sign,
    output  int13   exponent,
    output  uint106 fraction
) {
    uint1   NV <:: F1_AND_F2_INF & ( fp64( a ).sign ^ fp64( b ).sign );                                                         // INVALID IF BOTH INFINITY WITH DIFFERING SIGNS
    uint2   ACTION <:: { F1_OR_F2_INF | F1_OR_F2_NAN, F1_OR_F2_ZERO };                                                          // DO ADDITION IF NOT INFINITY, NAN OR ZERO

    do_addsub_align ALIGN(                                                                                                      // ALIGN THE FRACTIONS
        BIAS <: BIAS,                                                                                                           // MOVE THE FRACTION WITH THE SMALLEST EXPONENT RIGHT
        expA <: fp64( a ).exponent, fractionA <: fp64( a ).fraction,
        expB <: fp64( b ).exponent, fractionB <: fp64( b ).fraction,
        RESULTexp :> exponent
    );
    do_float_addsub ADDSUB(                                                                                                     // PERFORM THE ADDITION/SUBTRACTION, ACCOUNTING FOR SIGNS
        signA <: fp64( a ).sign, sigA <: ALIGN.sigA,                                                                            // SPECIAL CASE FOR SUBTRACTION WHEN EQUAL EXPONENTS
        signB <: fp64( b ).sign, sigB <: ALIGN.sigB,                                                                            // AND SECOND FRACTION IS LARGER THAN THE FIRST
        RESULTsign :> sign, RESULTfraction :> fraction
    );

    uint1   wait = uninitialised; BUSY:= START | wait; wait := START;                                                           // PROVIDE WAIT STATES

    flags := { NV, 1b0, ~|ACTION & OF, ~|ACTION & UF, 1b0 };                                                                    // RETURN FLAGS
    special := 0;

    algorithm <autorun> { while(1) {
        switch( ACTION ) {
            case 2b00: { special = ~|ADDSUB.RESULTfraction; }                                                                   // CALCULATION IS VALID, CHECK FOR ZERO RESULT
            case 2b01: { special = F1_AND_F2_ZERO ? 7b0000001 : ( bZERO ? 7b1000000 : 7b0100000 ); }                            // BOTH ZERO, RETURN ZERO.  ONE ZERO, RETURN OTHER
            default: {
                switch( { F1_OR_F2_INF, F1_OR_F2_NAN } ) {
                    case 2b10: { special = NV ? 7b0000010 : ( aINF ? 7b1000000 : 7b0100000 ); }                                 // INFINITY RETURN NAN IF OPPOSITE SIGNS ELSE RETURN INFINITY
                    default: { special = 7b0000010; }                                                                           // NAN RETURN NAN
                }
            }
        }
    } }
}

// MULTIPLY TWO FLOATING POINT NUMBERS
// ( NOT USED BY PAWS, MULTIPLICATION IS DONE AS FUSED A*B+0.0 )
unit floatmultiply(
    input   uint1   START,
    output  uint1   BUSY,
    input   uint1   F1_OR_F2_INF,                                                                                               // EITHER A OR B INF?
    input   uint1   F1_OR_F2_NAN,                                                                                               // EITHER A OR B NAN?
    input   uint1   F1_OR_F2_ZERO,                                                                                              // EITHER A OR B ZERO?
    input   uint1   OF,
    input   uint1   UF,
    output  uint5   flags,                                                                                                      // OPERATION FLAGS
    output  uint4   special
) {
    uint2   ACTION <:: { F1_OR_F2_INF | F1_OR_F2_NAN, F1_OR_F2_ZERO };

    BUSY := START;                                                                                                              // PROVIDE BUSY FLAG

    flags := { F1_OR_F2_INF & F1_OR_F2_ZERO, 1b0, ~|ACTION & OF, ~|ACTION & UF, 1b0 };                                          // RETURN FLAGS, INVALID IF INFINITY x ZERO
    special := 0;

    algorithm <autorun> { while(1) {
        switch( ACTION ) {
            case 2b00: {}                                                                                                       // MULTIPLICATION IS VALID
            case 2b01: { special = 7b0000001; }                                                                                 // ZERO INPUT RETURN ZERO
            default: {
                switch( { F1_OR_F2_INF, F1_OR_F2_ZERO } ) {
                    case 2b11: { special = 7b0000010; }                                                                         // INFINITY x ZERO RETURN qNAN
                    case 2b10: { special = F1_OR_F2_NAN ? 7b0000010 : 7b0001000; }                                              // NAN OR INFITITY RETURN qNAN OR INFINITY
                    default: { special = 7b0000010; }                                                                           // NAN OR ZERO RETURN qNAN
                }
            }
        }
    } }
}
