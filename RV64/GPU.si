circuitry copycoordinates( input x, input y, output x1, output y1 ) { x1 = x; y1 = y; }                                         // COPY COORDINATES CIRCUIT

bitfield Q {
    uint4   write,
    uint8   colour,
    uint8   colour_alt,
    uint4   dither,
    uint10  x,
    uint10  y,
    uint10  p0,
    uint10  p1,
    uint10  p2,
    uint10  p3,
    uint10  p4,
    uint10  p5,
    uint9   c_L,
    uint9   c_R,
    uint8   c_T,
    uint8   c_B
}

unit gpu_queue(
    output  int10   bitmap_x_write,                                                                                             // TO FRAMEBUFFER PIXEL WRITER
    output  int10   bitmap_y_write,
    output  uint8   bitmap_colour_write,
    output  uint8   bitmap_colour_write_alt,
    output  uint1   bitmap_write,
    output  uint9   bitmap_crop_left,
    output  uint9   bitmap_crop_right,
    output  uint8   bitmap_crop_top,
    output  uint8   bitmap_crop_bottom,
    output  uint4   gpu_active_dithermode,

    input   uint9   crop_left,                                                                                                  // CPU REQUESTED CROPPING RECTANGLE
    input   uint9   crop_right,
    input   uint8   crop_top,
    input   uint8   crop_bottom,

    input   int10   gpu_x,                                                                                                      // CPU REQUESTED GPU OPERATION
    input   int10   gpu_y,
    input   uint8   gpu_colour,
    input   uint8   gpu_colour_alt,
    input   int10   gpu_param0,
    input   int10   gpu_param1,
    input   int10   gpu_param2,
    input   int10   gpu_param3,
    input   int10   gpu_param4,
    input   int10   gpu_param5,
    input   uint4   gpu_write,
    input   uint4   gpu_dithermode,

    simple_dualport_bram_port0 blit1tilemap,                                                                                    // STORAGE FOR 1 BIT 16x16 TILES
    simple_dualport_bram_port0 characterGenerator8x8,                                                                           // STORAGE FOR 512 8x8 CHARACTERS
    simple_dualport_bram_port0 colourblittilemap,                                                                               // STORAGE FOR COLOUR 16x16 TILES

    input   uint2   pb_mode,                                                                                                    // PIXEL BLOCK PARAMETERS/REQUESTS FROM CPU
    input   uint8   pb_colour,
    input   uint8   pb_colour8r,
    input   uint8   pb_colour8g,
    input   uint8   pb_colour8b,
    input   uint2   pb_newpixel,
    simple_dualport_bram_port0 pb_colourmap,

    output  uint1   queue_full,                                                                                                 // GPU QUEUE STATUS
    output  uint1   queue_complete,
    output  uint1   gpu_active
) {
    simple_dualport_bram uint138 QUEUE[16] = uninitialised;
    uint1   TRIANGLE2 = 0;
    uint1   WRITE = 0;
    uint4   QA0P1 <:: QUEUE.addr0 + 1;
    uint4   QA1P1 <:: QUEUE.addr1 + 1;

    gpu GPU(
        blit1tilemap <:> blit1tilemap,
        characterGenerator8x8 <:> characterGenerator8x8,
        colourblittilemap <:> colourblittilemap,
        pb_colourmap <:> pb_colourmap,
        bitmap_x_write :> bitmap_x_write, bitmap_y_write :> bitmap_y_write,
        bitmap_colour_write :> bitmap_colour_write, bitmap_colour_write_alt :> bitmap_colour_write_alt,
        bitmap_write :> bitmap_write,
        gpu_active_dithermode :> gpu_active_dithermode,
        pb_mode <: pb_mode, pb_colour <: pb_colour, pb_colour8r <: pb_colour8r, pb_colour8g <: pb_colour8g, pb_colour8b <: pb_colour8b, pb_newpixel <: pb_newpixel,
        gpu_active :> gpu_active
    );

    QUEUE.wenable1 := |gpu_write;
    QUEUE.wdata1 := {   gpu_write, gpu_colour, gpu_colour_alt, gpu_dithermode,
                        gpu_x, gpu_y, gpu_param0, gpu_param1, gpu_param2, gpu_param3, gpu_param4, gpu_param5,
                        crop_left, crop_right, crop_top, crop_bottom
                    };
    GPU.gpu_write := 0;                                                                                                         // GPU START OPERATION FLAG
    queue_full := ( QA1P1 == QUEUE.addr0 ); queue_complete := ~gpu_active & ~WRITE & ( QUEUE.addr1 == QUEUE.addr0 );            // QUEUE FULL OR COMPLETE?

    always {
        if( ~gpu_active & ~WRITE & ( QUEUE.addr0 != QUEUE.addr1 ) ) {                                                           // GPU READY FOR NEXT ENTRY
            GPU.gpu_dithermode = Q( QUEUE.rdata0 ).dither;                                                                      //  COPY QUEUE ENTRY
            GPU.gpu_colour = Q( QUEUE.rdata0 ).colour;
            GPU.gpu_colour_alt = Q( QUEUE.rdata0 ).colour_alt;
            GPU.gpu_x = Q( QUEUE.rdata0 ).x;
            GPU.gpu_y = Q( QUEUE.rdata0 ).y;
            GPU.gpu_param0 = TRIANGLE2 ? Q( QUEUE.rdata0 ).p4 : Q( QUEUE.rdata0 ).p0;                                           //  IF 2ND TRIANGLE OF QUADRILATERAL USE P4/5 NOT P0/1
            GPU.gpu_param1 = TRIANGLE2 ? Q( QUEUE.rdata0 ).p5 : Q( QUEUE.rdata0 ).p1;
            GPU.gpu_param2 = Q( QUEUE.rdata0 ).p2;
            GPU.gpu_param3 = Q( QUEUE.rdata0 ).p3;
            GPU.crop_left = Q( QUEUE.rdata0 ).c_L; bitmap_crop_left = Q( QUEUE.rdata0 ).c_L;
            GPU.crop_right = Q( QUEUE.rdata0 ).c_R; bitmap_crop_right = Q( QUEUE.rdata0 ).c_R;
            GPU.crop_top = Q( QUEUE.rdata0 ).c_T; bitmap_crop_top = Q( QUEUE.rdata0 ).c_T;
            GPU.crop_bottom = Q( QUEUE.rdata0 ).c_B; bitmap_crop_bottom = Q( QUEUE.rdata0 ).c_B;

            if( TRIANGLE2 ) {                                                                                                   // IF 2ND TRIANGLE OF QUADRILATERAL
                GPU.gpu_write = 6; TRIANGLE2 = 0; QUEUE.addr0 = QA0P1;                                                          //  DISPATCH TRIANGLE AND MOVE TO NEXT
            } else {
                if( &Q( QUEUE.rdata0 ).write ) {                                                                                // IF QUADRILATERAL
                    GPU.gpu_write = 6; TRIANGLE2 = 1;                                                                           //  SEND 1ST TRIANGLE AND FLAG 2ND TRIANGLE NEEDED
                } else {
                    GPU.gpu_write = Q( QUEUE.rdata0 ).write; QUEUE.addr0 = QA0P1;                                               // ANYTHING ELSE DISPATCH AND MOVE TO NEXT
                }
            }
        }
        QUEUE.addr1 = WRITE ? QA1P1 : QUEUE.addr1;                                                                              // NEW ENTRY WRITTEN? MOVE TO NEXT SLOT
        WRITE = |gpu_write;                                                                                                     //  PROVIDE DELAY TO ALLOW QUEUE ENTRY TO SHOW

        if( reset ) { QUEUE.addr0 = 0; QUEUE.addr1 = 0; }
    }
}

unit gpu(
    simple_dualport_bram_port0 blit1tilemap,
    simple_dualport_bram_port0 characterGenerator8x8,
    simple_dualport_bram_port0 colourblittilemap,
    simple_dualport_bram_port0 pb_colourmap,

    // GPU to SET and GET pixels
    output int10   bitmap_x_write,
    output int10   bitmap_y_write,
    output uint8   bitmap_colour_write,
    output uint8   bitmap_colour_write_alt,
    output uint1   bitmap_write,
    output uint4   gpu_active_dithermode,

    input   uint9   crop_left,
    input   uint9   crop_right,
    input   uint8   crop_top,
    input   uint8   crop_bottom,

    input   int10   gpu_x,
    input   int10   gpu_y,
    input   uint8   gpu_colour,
    input   uint8   gpu_colour_alt,
    input   int10   gpu_param0,
    input   int10   gpu_param1,
    input   int10   gpu_param2,
    input   int10   gpu_param3,
    input   int10   gpu_param4,
    input   int10   gpu_param5,
    input   uint4   gpu_write,
    input   uint4   gpu_dithermode,

    input   uint2   pb_mode,
    input   uint8   pb_colour,
    input   uint8   pb_colour8r,
    input   uint8   pb_colour8g,
    input   uint8   pb_colour8b,
    input   uint2   pb_newpixel,

    output  uint1   gpu_active,
) {
    uint2   STATE = 1;
        $$ STATE_QUEUE_DISPATCH = 1
        $$ STATE_QUEUE_TRANSFER = 2

    rectangle GPUrectangle(                                                                                                     // GPU FILLED RECTANGLE
        crop_left <: crop_left, crop_right <: crop_right, crop_top <: crop_top, crop_bottom <: crop_bottom,
        x <: gpu_x, y <: gpu_y, x1 <: gpu_param0, y1 <: gpu_param1
    );
    line GPUline(                                                                                                               // GPU 1 OR PARAM2 WIDE PIXEL LINE
        x <: gpu_x, y <: gpu_y, x1 <: gpu_param0, y1 <: gpu_param1,
        width <: gpu_param2[0,8]
    );
    circle GPUcircle(                                                                                                           // GPU OUTLINE/FILLED CIRCLE
        x <: gpu_x, y <: gpu_y, radius <: gpu_param0, sectormask <: gpu_param1
    );
    triangle GPUtriangle(                                                                                                       // GPU FILLED TRIANGLE ( used x2 for quadrilateral )
        crop_left <: crop_left, crop_right <: crop_right, crop_top <: crop_top, crop_bottom <: crop_bottom,
        x <: gpu_x, y <: gpu_y, x1 <: gpu_param0, y1 <: gpu_param1, x2 <: gpu_param2, y2 <: gpu_param3
    );
    blit GPUblit(                                                                                                               // GPU BLITTER
        blit1tilemap <:> blit1tilemap,                                                                                          // 1 BIT 16x16 TILES
        characterGenerator8x8 <:> characterGenerator8x8,                                                                        // 8x8 CHARACTERS
        colourblittilemap <:> colourblittilemap,                                                                                // COLOUR 16x16 TILES
        x <: gpu_x, y <: gpu_y,
        tile <: gpu_param0[0,9], scale <: gpu_param1[0,2], action <: gpu_param2[0,3]
    );
    pixelblock GPUpixelblock(                                                                                                   // PIXELBLOCK FOR RAPID TRANSFER OF BITMAPS
        colourmap <:> pb_colourmap,                                                                                             // INCLUDING RGBA -> RGBM or GREY
        x <: gpu_x, y <: gpu_y, width <: gpu_param0,
        ignorecolour <: gpu_param1,
        mode <: pb_mode, colour <: pb_colour,
        colour8r <: pb_colour8r, colour8g <: pb_colour8g, colour8b <: pb_colour8b,
        newpixel <: pb_newpixel
    );

    // GPU UNIT BUSY FLAGS
    uint6   gpu_busy_flags <:: { GPUpixelblock.busy, |GPUblit.busy, GPUtriangle.busy, GPUcircle.busy, GPUrectangle.busy, GPUline.busy };
    uint1   gpu_busy <:: |gpu_busy_flags;

    GPUrectangle.start := 0; GPUline.start := 0; GPUcircle.start := 0; GPUtriangle.start := 0; GPUblit.start := 0; GPUpixelblock.start := 0;

    bitmap_write := ( gpu_write == 1 ) | GPUline.bitmap_write | GPUrectangle.bitmap_write | GPUcircle.bitmap_write | GPUtriangle.bitmap_write | GPUblit.bitmap_write |
                                        GPUpixelblock.bitmap_write;
    gpu_active := ( |gpu_write[1,3] ) | gpu_busy;

    always {
        onehot( STATE ) {
            case 0: {                                                                                                           // STATE_QUEUE_DISPATCH
                if( |gpu_write ) {                                                                                              // START GPU DRAWING UNIT FROM QUEUE ENTRY
                    gpu_active_dithermode = 0;                                                                                  // RESET TO THE COMMON DEFAULTS
                    bitmap_colour_write = gpu_colour; bitmap_colour_write_alt = gpu_colour_alt;
                    GPUcircle.filledcircle = gpu_write[0,1]; GPUblit.tilecharacter = gpu_write[0,1];

                    switch( gpu_write ) {
                        default: {}
                        case 1: { ( bitmap_x_write, bitmap_y_write ) = copycoordinates(  gpu_x, gpu_y );}                       // PLOT POINT (X,Y) DIRECT, NO GPU ACTIVATION
                        case 2: { GPUline.start = 1; }                                                                          // DRAW LINE FROM (X,Y) to (P0,P1)
                        case 3: { gpu_active_dithermode = gpu_dithermode; GPUrectangle.start = 1; }                             // DRAW RECTANGLE FROM (X,Y) to (P0,P1)
                        case 4: { GPUcircle.start = 1; }                                                                        // DRAW CIRCLE CENTRE (X,Y) with RADIUS P0
                        case 5: { gpu_active_dithermode = gpu_dithermode; GPUcircle.start = 1; }                                // DRAW FILLED CIRCLE CENTRE (X,Y) with RADIUS P0
                        case 6: { gpu_active_dithermode = gpu_dithermode; GPUtriangle.start = 1; }                              // DRAW FILLED TRIANGLE WITH VERTICES (X,Y) (P0,P1)
                                                                                                                                //                                    (PARAM2,PARAM3)
                        case 7: { GPUblit.start = 1; }                                                                          // BLIT 16 x 16 TILE PARAM0 TO (X,Y)
                        case 8: { GPUblit.start = 1; }                                                                          // BLIT 8 x 8 CHARACTER PARAM0 TO (X,Y) as 8 x 8
                        case 9: { GPUblit.start = 2; }                                                                          // BLIT 16 x 16 COLOUR TILE PARAM0 TO (X,Y) as 16 x 16
                        case 10: { GPUpixelblock.start = 1; }                                                                   // START THE PIXELBLOCK AT (x,y)  WIDTH P0, IGNORE COLOUR P1
                        // 11 PLACE HOLDER                                                                                      // DRAW FILLED ELLIPSE CENTE (X,Y) RADII (P0,P1)
                        // 12 PLACE HOLDER                                                                                      // DRAW ELLIPSE CENTE (X,Y) RADII (P0,P1)
                        // 13
                        // 14                                                                                                   // QUEUE CONTROLLED QUADRILATERAL, TRIANGLE 2
                        // 15                                                                                                   // QUEUE CONTROLLED QUADRILATERAL, TRIANGLE 1
                    }
                    STATE = $STATE_QUEUE_TRANSFER$;
                }
            }
            case 1: {                                                                                                           // STATE_QUEUE_TRANSFER
                if( gpu_busy ) {                                                                                                //  COPY OUTPUT TO THE BITMAP WRITER
                    onehot( gpu_busy_flags ) {
                        case 0: { ( bitmap_x_write, bitmap_y_write ) = copycoordinates( GPUline.bitmap_x_write, GPUline.bitmap_y_write ); }
                        case 1: { ( bitmap_x_write, bitmap_y_write ) = copycoordinates( GPUrectangle.bitmap_x_write, GPUrectangle.bitmap_y_write ); }
                        case 2: { ( bitmap_x_write, bitmap_y_write ) = copycoordinates( GPUcircle.bitmap_x_write, GPUcircle.bitmap_y_write ); }
                        case 3: { ( bitmap_x_write, bitmap_y_write ) = copycoordinates( GPUtriangle.bitmap_x_write, GPUtriangle.bitmap_y_write ); }
                        case 4: {
                            ( bitmap_x_write, bitmap_y_write ) = copycoordinates(  GPUblit.bitmap_x_write, GPUblit.bitmap_y_write );
                            if( GPUblit.busy[1,1] ) { bitmap_colour_write = GPUblit.bitmap_colour_write; }
                        }
                        case 5: {
                            ( bitmap_x_write, bitmap_y_write ) = copycoordinates( GPUpixelblock.bitmap_x_write, GPUpixelblock.bitmap_y_write );
                            bitmap_colour_write = GPUpixelblock.bitmap_colour_write;
                        }
                    }
                } else {
                    STATE = $STATE_QUEUE_DISPATCH$;
                }
            }
        }
    }
}

unit int10_less(                                                                                                                // HELPER v1 < v2
    input   int10   v1,
    input   int10   v2,
    output  uint1   less
) {
    less := ( __signed(v1) < __signed(v2) );
}
unit int10_less_minmax(                                                                                                         // HELPER v1 < v2 OUTPUT min AND max
    input   int10   v1,
    input   int10   v2,
    output  uint1   less,
    output  int10   min,
    output  int10   max
) {
    always {
        if( __signed(v1) < __signed(v2) ) { less = 1; min = v1; max = v2; } else { less = 0; min = v2; max = v1; }
    }
}

unit int10_more(                                                                                                                // HELPER v1 > v2
    input   int10   v1,
    input   int10   v2,
    output  uint1   more
) {
    more := ( __signed(v1) > __signed(v2) );
}
unit int10_more_neg(                                                                                                            // HELPER v1 > -v2
    input   int10   v1,
    input   int10   v2,
    output  uint1   more
) {
    more := ( __signed(v1) > __signed(-v2) );
}
unit int10_more_minmax(                                                                                                         // HELPER v1 > v2 OUTPUT min AND max
    input   int10   v1,
    input   int10   v2,
    output  uint1   more,
    output  int10   min,
    output  int10   max
) {
    always {
        if( __signed(v1) > __signed(v2) ) { more = 1; min = v2; max = v1; } else { more = 0; min = v1; max = v2; }
    }
}

unit istodraw(                                                                                                                  // HELPER - DECIDE IF MIN/MAX ARE WITHIN CROP
    input   int10   crop_left,
    input   int10   crop_right,
    input   int10   crop_top,
    input   int10   crop_bottom,
    input   int10   min_x,
    input   int10   min_y,
    input   int10   max_x,
    input   int10   max_y,
    output  uint1   draw
) {
    int10_less XL( v1 <: max_x, v2 <: crop_left );
    int10_less YT( v1 <: max_y, v2 <: crop_top );
    int10_more XR( v1 <: min_x, v2 <: crop_right );
    int10_more YB( v1 <: min_y, v2 <: crop_bottom );

    draw := ~( XL.less | YT.less | XR.more | YB.more );
}

unit applycrop(                                                                                                                 // HELPER - APPLY CROPPING RECTANGLE FOR RECTANGLES AND TRIANGLES
    input   int10   crop_left,
    input   int10   crop_right,
    input   int10   crop_top,
    input   int10   crop_bottom,
    input   int10   x1,
    input   int10   y1,
    input   int10   x2,
    input   int10   y2,
    output  int10   min_x,
    output  int10   min_y,
    output  int10   max_x,
    output  int10   max_y
) {
    int10_less_minmax XL( v1 <: x1, v2 <: crop_left, max :> min_x  );
    int10_more_minmax XR( v1 <: x2, v2 <: crop_right, min :> max_x );
    int10_less_minmax YT( v1 <: y1, v2 <: crop_top, max :> min_y );
    int10_more_minmax YB( v1 <: y2, v2 <: crop_bottom );

    max_y := 1 + ( YB.min );
}

// RECTANGLE - OUTPUT PIXELS TO DRAW A RECTANGLE
unit preprectangle(                                                                                                             // SORT SO AS DRAWING TOP LEFT TO BOTTOM RIGHT AND CROP
    input   uint1   start,
    output  uint1   busy,
    input   uint9   crop_left,
    input   uint9   crop_right,
    input   uint8   crop_top,
    input   uint8   crop_bottom,
    input   int10   x,
    input   int10   y,
    input   int10   param0,
    input   int10   param1,
    output  int10   min_x,
    output  int10   min_y,
    output  int10   max_x,
    output  int10   max_y,
    output  uint1   todraw
) {
    uint2               STATE = 1;
                        $$ STATE_PREPRECT_WAIT  = 1
                        $$ STATE_PREPRECT_SORT  = 2

    int10_less_minmax X0( v1 <: x, v2 <: param0 );
    int10_less_minmax Y1( v1 <: y, v2 <: param1 );

    applycrop CROP(
        x1 <: X0.min, x2 <: X0.max, y1 <: Y1.min, y2 <: Y1.max,
        crop_left <: crop_left, crop_right <: crop_right, crop_top <: crop_top, crop_bottom <: crop_bottom,
        min_x :> min_x, min_y :> min_y, max_x :> max_x, max_y :> max_y
    );

    istodraw TODRAW(
        crop_left <: crop_left, crop_right <: crop_right, crop_top <: crop_top, crop_bottom <: crop_bottom,
        min_x <: CROP.min_x, min_y <: CROP.min_y, max_x <: CROP.max_x, max_y <: CROP.max_y
    );

    todraw := 0;

    always {
        uint3   DELAY = uninitialised;

        onehot( STATE ) {
            case 0: { DELAY = -1; busy = start; if( start ) { STATE = $STATE_PREPRECT_SORT$; } }                                // STATE_PREPRECT_WAIT
            case 1: {                                                                                                           // STATE_PREPRECT_SORT
                if( DELAY[0,1] ) {
                    DELAY = DELAY[1,2];
                } else {
                    todraw = TODRAW.draw; busy = 0; STATE = $STATE_PREPRECT_WAIT$;
                }
            }
        }
    }
}
unit drawrectangle(
    input   uint1   start,
    output  uint1   busy,
    input   uint9   min_x,
    input   uint8   min_y,
    input   uint9   max_x,
    input   uint8   max_y,
    output  uint9   bitmap_x_write,
    output  uint8   bitmap_y_write,
) {
    uint2               STATE = 1;
                        $$ STATE_RECT_WAIT  = 1
                        $$ STATE_RECT_DRAW  = 2

    uint9               bitmap_x_write_NEXT <:: bitmap_x_write + 1;                                                             // NEXT PIXEL TO THE RIGHT
    uint8               bitmap_y_write_NEXT <:: bitmap_y_write + 1;                                                             // NEXT LINE DOWN

    always {
        onehot( STATE ) {
            case 0: {                                                                                                           // STATE_RECT_WAIT
                ( bitmap_x_write, bitmap_y_write ) = copycoordinates( min_x, min_y );                                           //  MOVE TO FIRST PIXEL
                busy = start; if( start ) { STATE = $STATE_RECT_DRAW$; }                                                        //  START DRAWING RECTANGLE
            }
            case 1: {                                                                                                           // STATE_RECT_DRAW
                if( bitmap_x_write == max_x ) {                                                                                 //  END OF LINE
                    if( bitmap_y_write_NEXT == max_y ) {
                        busy = 0; STATE = $STATE_RECT_WAIT$;                                                                    //      FINISHED
                    } else {
                        ( bitmap_x_write, bitmap_y_write ) = copycoordinates( min_x, bitmap_y_write_NEXT );                     //      MOVE TO START OF NEXT LINE
                    }
                } else {
                    bitmap_x_write = bitmap_x_write_NEXT;                                                                       //  NEXT PIXEL ON LINE
                }
            }
        }
    }
}
unit rectangle (
    input   uint1   start,
    output  uint1   busy,
    input   uint9   crop_left,
    input   uint9   crop_right,
    input   uint8   crop_top,
    input   uint8   crop_bottom,
    input   int10   x,
    input   int10   y,
    input   int10   x1,
    input   int10   y1,

    output  uint9   bitmap_x_write,
    output  uint8   bitmap_y_write,
    output  uint1   bitmap_write
) {
    preprectangle PREP(
        start <: start,
        crop_left <: crop_left, crop_right <: crop_right, crop_top <: crop_top, crop_bottom <: crop_bottom,
        x <: x, y <: y, param0 <: x1, param1 <: y1
    );
    drawrectangle RECTANGLE(
        min_x <: PREP.min_x, min_y <: PREP.min_y, max_x <: PREP.max_x, max_y <: PREP.max_y,
        bitmap_x_write :> bitmap_x_write, bitmap_y_write :> bitmap_y_write, busy :> bitmap_write,
        start <: PREP.todraw
    );

    busy := start | PREP.busy | PREP.todraw | RECTANGLE.busy;
}

// LINE - OUTPUT PIXELS TO DRAW A LINE via BRESENHAM'S LINE DRAWING ALGORITHM
unit absolutedelta(                                                                                                             // ABSOLUTRE/POSITIVE DELTA/DIFFERENCE BETWEEN TWO INPUTS
    input   int10   value1,                                                                                                     // FIRST VALUE
    input   int10   value2,                                                                                                     // SECOND VALUE
    output  uint1   v1v2,                                                                                                       // OUTPUT COMPARISON
    output  int10   delta                                                                                                       // OUTPUT ABSOLUTE/POSITIVE DELTA/DIFFERENCE
) {
    int10_less_minmax V1V2( v1 <: value1, v2 <: value2, less :> v1v2 );

    delta := ( V1V2.max ) - ( V1V2.min );                                                                                       // LARGEST - SMALLEST
}
unit prepline(
    input   uint1               start,
    output  uint1               busy,
    input   int10               x,                                                                                              // (x,y) -> (param0,param1)
    input   int10               y,
    input   int10               param0,
    input   int10               param1,
    output  int10               x1,                                                                                             // SORT SO AS
    output  int10               y1,
    output  int10               dx,
    output  int10               dy,
    output  uint1               dv,
    output  int10               numerator,
    output  int10               max_count,
    output  uint1               todraw
) {
    uint3               STATE = 1;
                        $$ STATE_PREPLINE_WAIT      = 1
                        $$ STATE_PREPLINE_SORT      = 2
                        $$ STATE_PREPLINE_OUTPUT    = 4

    absolutedelta DX( value1 <: x, value2 <: param0, delta :> dx );                                                             // COMPARE X AND PARAM0 ( x1 < x2 of inputs )
    absolutedelta DY( value1 <: y, value2 <: param1, delta :> dy );                                                             // COMPARE Y AND PARAM1 ( y1 < y2 of inputs )
    int10_more DXDY( v1 <: DX.delta, v2 <: DY.delta );                                                                          // DX.delta > DY.delta

    todraw := STATE[2,1];

    always {
        uint3 DELAY = uninitialised;

        onehot( STATE ) {
            case 0: { busy = start; if( start ) { DELAY = -1; STATE = $STATE_PREPLINE_SORT$; } }                                // STATE_PREPLINE_WAIT
            case 1: { if( DELAY[0,1] ) { DELAY = DELAY[1,2]; } else { STATE = $STATE_PREPLINE_OUTPUT$; } }                      // STATE_PREPLINE_SORT
            case 2: {                                                                                                           // STATE_PREPLINE_OUTPUT
                x1 = DX.v1v2 ? x : param0;
                y1 = DX.v1v2 ? y : param1;
                dv = DX.v1v2 ? DY.v1v2 : ~DY.v1v2;

                numerator = DXDY.more ? ( DX.delta[1,9] ) : -( DY.delta[1,9] );                                                 // DETERMINE STARTING NUMERATOR
                max_count = ( DXDY.more ? DX.delta : DY.delta ) + 1;                                                            // NUMBER OF PIXELS TO DRAW
                STATE = $STATE_PREPLINE_WAIT$;
            }
        }
    }
}
unit drawline(
    input   uint1   start,
    output  uint1   busy,
    input   int10   start_x,
    input   int10   start_y,
    input   int10   start_numerator,
    input   int10   dx,
    input   int10   dy,
    input   uint1   dv,
    input   int10   max_count,
    input   uint8   width,
    output  int10   bitmap_x_write,
    output  int10   bitmap_y_write,
    output  uint1   bitmap_write
) {
    uint4               STATE = 1;
                        $$ STATE_LINE_WAIT      = 1
                        $$ STATE_LINE_THIN      = 2
                        $$ STATE_LINE_WIDE      = 4
                        $$ STATE_LINE_DRAWWIDE  = 8

    int10_less N2DY( v1 <: numerator, v2 <: dy );                                                                               // numerator < dy
    int10_more DXDY( v1 <: dx, v2 <: dy );                                                                                      // dx > dy
    int10_more_neg N2DX( v1 <: numerator, v2 <: dx );                                                                           // numerator > -dx

    int10               x = uninitialized;
    int10               x_NEXT <:: x + N2DX.more;
    int10               offset_x = uninitialised;
    int10               offset_x_NEXT <:: offset_x + ~DXDY.more;
    int10               y = uninitialized;
    int10               y_NEXT <:: N2DY.less ? ( y + ( dv ? 1 : -1 ) ) : y;
    int10               offset_y = uninitialised;
    int10               offset_y_NEXT <:: offset_y + DXDY.more;
    int10               numerator = uninitialized;
    int10               numerator_NEXT <:: numerator - ( N2DX.more ? dy : 0 ) + ( N2DY.less ? dx : 0 );
    int10               count = uninitialized;
    int10               count_NEXT <:: count + 1;
    uint1               countMORE <:: count != max_count;
    int10               offset_start <:: -( width[1,7] );
    uint1               singlepixel <:: ( width == 1 );
    uint8               pixel_count = uninitialised;
    uint8               pixel_count_NEXT <:: pixel_count + 1;
    uint1               pixelMORE <:: pixel_count != width;

    bitmap_x_write := x + ( singlepixel ? 0 : offset_x );
    bitmap_y_write := y + ( singlepixel ? 0 : offset_y );
    bitmap_write := ( STATE[1,1] & countMORE ) | ( STATE[3,1] & pixelMORE );

    always {
        onehot( STATE ) {
            case 0: {                                                                                                           // STATE_LINE_WAIT
                x = start_x; y = start_y; numerator = start_numerator; count = 0; busy = start;                                 //  COPY STARTING POSITION
                if( start ) { STATE = singlepixel ? $STATE_LINE_THIN$ : $STATE_LINE_WIDE$; }                                    //  START THIN OR WIDE LINE DRAWING
            }
            case 1: {                                                                                                           // STATE_LINE_THIN
                if( countMORE ) {                                                                                               //  MORE TO DRAW?
                    numerator = numerator_NEXT; count = count_NEXT; x = x_NEXT; y = y_NEXT;                                     //      MOVE TO NEXT PIXEL ALONG THE LINE
                } else {
                    busy = 0; STATE = $STATE_LINE_WAIT$;                                                                        //      FINISH
                }
            }
            case 2: {                                                                                                           // STATE_LINE_WIDE
                if( countMORE ) {                                                                                               //  MORE TO DRAW?
                    offset_x = DXDY.more ? 0 : offset_start; offset_y = DXDY.more ? offset_start : 0; pixel_count = 0;          //      MOVE TO SIDE OF CENTRE TO DRAW WIDE LINE
                    STATE = $STATE_LINE_DRAWWIDE$;
                } else {
                    busy = 0; STATE = $STATE_LINE_WAIT$;                                                                        //      FINISH
                }
            }
            case 3: {                                                                                                           // STATE_LINE_DRAWWIDE
                if( pixelMORE ) {                                                                                               //  MORE TO DRAW?
                    offset_x = offset_x_NEXT; offset_y = offset_y_NEXT; pixel_count = pixel_count_NEXT;                         //      MOVE TO NEXT PIXEL IN THE WIDE LINE
                } else {
                    numerator = numerator_NEXT; count = count_NEXT; x = x_NEXT; y = y_NEXT;                                     //      MOVE TO NEXT PIXEL ALONG THE LINE
                    STATE = $STATE_LINE_WIDE$;
                }
            }
        }
    }
}
unit line(
    input   uint1   start,
    output  uint1   busy,
    input   int10   x,
    input   int10   y,
    input   int10   x1,
    input   int10   y1,
    input   uint8   width,
    output  int10   bitmap_x_write,
    output  int10   bitmap_y_write,
    output  uint1   bitmap_write
) {
    prepline PREP(
        start <: start,
        x <: x, y <: y, param0 <: x1, param1 <: y1
    );
    drawline LINE(
        start_x <: PREP.x1, start_y <: PREP.y1,
        start_numerator <: PREP.numerator,
        dx <: PREP.dx, dy <: PREP.dy, dv <: PREP.dv,
        max_count <: PREP.max_count, width <: width,
        bitmap_x_write :> bitmap_x_write, bitmap_y_write :> bitmap_y_write,
        bitmap_write :> bitmap_write,
        start <: PREP.todraw
    );

    busy := start | PREP.busy | LINE.busy;
}

//  CIRCLE - OUTPUT PIXELS TO DRAW AN OUTLINE OR FILLED CIRCLE
unit arccoords(
    input   int10   xc,
    input   int10   yc,
    input   int10   active_x,
    input   int10   count,
    input   uint4   arc,
    output  int10   bitmap_x_write,
    output  int10   bitmap_y_write,
    output  uint1   centrepixel
) {
    int10   xcpc <:: xc + ( arc[2,1] ? count : active_x );
    int10   xcmc <:: xc - ( arc[2,1] ? count : active_x );
    int10   ycpc <:: yc + ( arc[2,1] ? active_x : count );
    int10   ycmc <:: yc - ( arc[2,1] ? active_x : count );

    centrepixel := ( ~|count & ~|active_x );

    always {
        switch( arc[0,3] ) {                                                                                                    // ADJUST COORDINATES FOR EACH ARC OF THE CIRCLE
            case 0: { bitmap_x_write = xcpc; bitmap_y_write = ycpc; }
            case 1: { bitmap_y_write = ycmc; }
            case 2: { bitmap_x_write = xcmc; }
            case 3: { bitmap_y_write = ycpc; }
            case 4: { bitmap_x_write = xcpc; bitmap_y_write = ycpc; }
            case 5: { bitmap_y_write = ycmc; }
            case 6: { bitmap_x_write = xcmc; }
            case 7: { bitmap_y_write = ycpc; }
        }
    }
}
unit drawcircle(
    input   uint1   start,
    output  uint1   busy,
    input   int10   xc,
    input   int10   yc,
    input   int10   radius,
    input   int10   start_numerator,
    input   uint8   draw_sectors,
    input   uint1   filledcircle,
    output  int10   bitmap_x_write,
    output  int10   bitmap_y_write,
    output  uint1   bitmap_write
) {
    uint4               STATE = 1;
                        $$ STATE_CIRCLE_WAIT = 1
                        $$ STATE_CIRCLE_MOVE = 2
                        $$ STATE_CIRCLE_DRAW = 4
                        $$ STATE_CIRCLE_FILL = 8

    int10               numerator = uninitialised;
    int10               numerator_NEXT <:: numerator + ( numerator[9,1] ? { ARC.active_x, 2b00 } + 6 : { (ARC.active_x - active_y), 2b00 } + 10 );
    int10               count_NEXT <:: ARC.count - 1;
    int10               min_count = uninitialised;
    int10               min_count_NEXT <:: min_count + 1;
    int10               active_x_NEXT <:: ARC.active_x + 1;
    int10               active_y = uninitialized;
    int10               active_y_NEXT <:: active_y - ( ~numerator[9,1] & |numerator );
    uint4               arc_NEXT <:: ARC.arc + 1;
    uint1               more_PIXELS <:: ( active_y >= ARC.active_x );
    uint1               more_FILL <:: ( ( filledcircle ? count_NEXT : min_count ) == min_count );

    arccoords ARC( xc <: xc, yc <: yc );

    bitmap_x_write := STATE[1,1] ? xc : ARC.bitmap_x_write;                                                                     // CENTREPIXEL OR PIXEL ON ARC  X
    bitmap_y_write := STATE[1,1] ? yc : ARC.bitmap_y_write;                                                                     //                              Y
    bitmap_write := ( STATE[1,1] & ARC.centrepixel & |draw_sectors ) |                                                          // DRAW IF CENTREPIXEL
                    ( STATE[2,1] & ~ARC.arc[3,1] & draw_sectors[ARC.arc,1] );                                                   //  OR ARC IS BEING DRAWN

    always {
        onehot( STATE ) {
            case 0: {                                                                                                           // STATE_CIRCLE_WAIT
                ARC.active_x = 0; ARC.count = radius;
                active_y = radius; min_count = (-1); numerator = start_numerator;
                busy = start; if( start ) { STATE = $STATE_CIRCLE_MOVE$; }
            }
            case 1: {                                                                                                           // STATE_CIRCLE_MOVE
                if( more_PIXELS ) {                                                                                             //  MOVE TO NEXT PIXEL ON THE FIRST ARC
                    ARC.arc = 0; STATE = ARC.centrepixel ? $STATE_CIRCLE_FILL$ : $STATE_CIRCLE_DRAW$;
                } else {
                    busy = 0; STATE = $STATE_CIRCLE_WAIT$;
                }
            }
            case 2: {                                                                                                           // STATE_CIRCLE_DRAW
                if( ~ARC.arc[3,1] ) {                                                                                           //  OUTPUT PIXELS IN THE 8 SEGMENTS/ARCS AS PER MASK
                    ARC.arc = arc_NEXT;
                } else {
                    STATE = $STATE_CIRCLE_FILL$;
                }
            }
            case 3: {                                                                                                           // STATE_CIRCLE_FILL
                if( more_FILL ) {                                                                                               //  FILL FROM ARC TO CENTRE
                    ( ARC.active_x, active_y ) = copycoordinates( active_x_NEXT, active_y_NEXT );
                    ARC.count = active_y; min_count = min_count_NEXT;
                    numerator = numerator_NEXT;
                } else {
                    ARC.count = filledcircle ? count_NEXT : min_count;
                }
                STATE = $STATE_CIRCLE_MOVE$;
            }
        }
    }
}
unit circle(
    input   uint1   start,
    output  uint1   busy,
    input   int10   x,
    input   int10   y,
    input   uint9   radius,
    input   uint8   sectormask,
    input   uint1   filledcircle,

    output  int10  bitmap_x_write,
    output  int10  bitmap_y_write,
    output  uint1  bitmap_write
) {
    drawcircle CIRCLE(
        xc <: x, yc <: y,
        radius <: radius,
        filledcircle <: filledcircle,
        bitmap_x_write :> bitmap_x_write, bitmap_y_write :> bitmap_y_write, bitmap_write :> bitmap_write,
        start <: start
    );

    CIRCLE.start_numerator := 3 - ( { radius, 1b0 } );
    CIRCLE.draw_sectors := { sectormask[5,1], sectormask[6,1], sectormask[1,1], sectormask[2,1], sectormask[4,1], sectormask[7,1], sectormask[0,1], sectormask[3,1] };
    busy := start | CIRCLE.busy;
}

// TRIANGLE - OUTPUT PIXELS TO DRAW A FILLED TRIANGLE
unit swaponcondition(                                                                                                           // SWAP (x1,y1) AND (x2,y2) IF CONDITION IS TRUE
    input   int10   x1,
    input   int10   x2,
    input   int10   y1,
    input   int10   y2,
    input   uint1   condition,
    output  int10   nx1,
    output  int10   nx2,
    output  int10   ny1,
    output  int10   ny2
) {
    nx1 := condition ? x2 : x1;
    nx2 := condition ? x1 : x2;
    ny1 := condition ? y2 : y1;
    ny2 := condition ? y1 : y2;
}
unit minmax3(                                                                                                                   // RETURN MIN AND MAX OF 3 NUMBERS
    input   int10   n1,
    input   int10   n2,
    input   int10   n3,
    output  int10   min,
    output  int10   max
) {
    int10_less N1N2( v1 <: n1, v2 <: n2 );                                                                                      // COMPARISONS FOR N1 < N2
    int10_less N1N3( v1 <: n1, v2 <: n3 );                                                                                      // COMPARISONS FOR N1 < N3
    int10_less N2N3( v1 <: n2, v2 <: n3 );                                                                                      // COMPARISONS FOR N2 < N3

    min := N1N2.less ? ( N1N3.less ? n1 : n3 ) : ( N2N3.less ? n2 : n3 );                                                       // RETURN MIN OF 3 NUMBERS
    max := N1N2.less ? ( N2N3.less ? n3 : n2 ) : ( N1N3.less ? n3 : n1 );                                                       // RETURN MAX OF 3 NUMBERS ( reverse results for MIN )
}
unit checkslope(                                                                                                                // CHECK SLOPE OF ( x1, y1 ) -> ( x2, y2 )
    input   int10   x1,                                                                                                         //            AND ( x1, y1 ) -> ( x3, y3 )
    input   int10   y1,
    input   int10   x2,
    input   int10   y2,
    input   int10   x3,
    input   int10   y3,
    output  uint1   needsswap                                                                                                   // SWAP IF ANTI-CLOCKWISE
) {
    int22               slope <:: ( ( y2 - y1 ) * ( x3 - x2 ) ) - ( ( y3 - y2 ) * ( x2 - x1 ) );

    needsswap := ~slope[21,1];                                                                                                  // SLOPE >= 0 ( not negative )
}
unit preptriangle(                                                                                                              // SORT COORDINATES SO (X1,Y1) ARE TOP LEFT THEN CLOCKWISE
    input   uint1   start,
    output  uint1   busy,
    input   int10   crop_left,
    input   int10   crop_right,
    input   int10   crop_top,
    input   int10   crop_bottom,
    input   int10   x,
    input   int10   y,
    input   int10   param0,
    input   int10   param1,
    input   int10   param2,
    input   int10   param3,
    output  int10   x1,
    output  int10   y1,
    output  int10   x2,
    output  int10   y2,
    output  int10   x3,
    output  int10   y3,
    output  uint9   min_x,
    output  uint8   min_y,
    output  uint9   max_x,
    output  uint8   max_y,
    output  uint1   todraw
) {
    uint2               STATE = 1;
                        $$ STATE_PREPTRI_WAIT   = 1
                        $$ STATE_PREPTRI_SORT   = 2

    minmax3 X( n1 <: x1, n2 <: x2, n3 <: x3 );      minmax3 Y( n1 <: y1, n2 <: y2, n3 <: y3 );                                  // DEFINE BOUNDING BOX BY TRIANGLE COORDINATES
    applycrop CROP( crop_left <: crop_left, crop_right <: crop_right, crop_top <: crop_top, crop_bottom <: crop_bottom,         // APPLY CROP TO TRIANGLE COORDINATES
                    x1 <: X.min, y1 <: Y.min, x2 <: X.max, y2 <: Y.max,
                    min_x :> min_x, min_y :> min_y, max_x :> max_x, max_y :> max_y );                                           // OUTPUT BOUNDING BOX
    istodraw TODRAW( crop_left <: crop_left, crop_right <: crop_right, crop_top <: crop_top, crop_bottom <: crop_bottom,        // DETERMINE IF ANY TRIANGLE PIXELS ARE IN RANGE
                     min_x <: CROP.min_x, min_y <: CROP.min_y, max_x <: CROP.max_x, max_y <: CROP.max_y );

    swaponcondition SWAP1( x1 <: param0, y1 <: param1, x2 <: param2, y2 <: param3, condition <: S1COND.less );                  // -> ( x2, y2 ) and ( x3, y3 )
    swaponcondition SWAP2( x1 <: x, y1 <: y, x2 <: SWAP1.nx1, y2 <: SWAP1.ny1, condition <: S2COND.less );                      // -> ( x1, y1 ) and ( x2, y2 )
    swaponcondition SWAP3( x1 <: SWAP2.nx1, y1 <: SWAP2.ny1, x2 <: SWAP1.nx2, y2 <: SWAP1.ny2, condition <: S3COND.less );      // -> ( x1, y1 ) and ( x3, y3 )
    swaponcondition SWAP4( x1 <: SWAP2.nx2, y1 <: SWAP2.ny2, x2 <: SWAP3.nx2, y2 <: SWAP3.ny2, condition <: S4COND.less );      // -> ( x2, y2 ) and ( x3, y3 )
    swaponcondition SWAP5( x1 <: SWAP3.nx1, y1 <: SWAP3.ny1, x2 <: SWAP4.nx1, y2 <: SWAP4.ny1,                                  // -> ( x1, y1 ) and ( x2, y2 )
                           nx1 :> x1, ny1 :> y1 );                                                                              //    FINAL ( x1, y1 )

    checkslope MAKECLOCKWISE( x1 <: SWAP5.nx1, y1 <: SWAP5.ny1,                                                                 // CHECK SLOPES TO ENSURE CLOCKWISE FROM TOP
                              x2 <: SWAP5.nx2, y2 <: SWAP5.ny2,
                              x3 <: SWAP4.nx2, y3 <: SWAP4.ny2 );

    swaponcondition SWAP6( x1 <: SWAP5.nx2, y1 <: SWAP5.ny2, x2 <: SWAP4.nx2, y2 <: SWAP4.ny2,                                  // FINAL ( x2, y2 ) and ( x3, y3 )
                           nx1 :> x2, ny1 :> y2, nx2 :> x3, ny2 :> y3, condition <: MAKECLOCKWISE.needsswap );                  // SWAP DETERMINED BY SLOPES TO ENSURE CLOCKWISE

    int10_less S1COND( v1 <: param3, v2 <: param1 );            // SWAP1.condition := ( param3 < param1 );                      // ( y3 < y2 )                  SORT SO AS ( x1, y1 ) AT TOP
    int10_less S2COND( v1 <: SWAP1.ny1, v2 <: y );              // SWAP2.condition := ( SWAP1.ny1 < y );                        // ( y2 < y1 )
    int10_less S3COND( v1 <: SWAP1.ny2, v2 <: SWAP2.ny1 );      // SWAP3.condition := ( SWAP1.ny2 < SWAP2.ny1 );                // ( y3 < y1 )
    int10_less S4COND( v1 <: SWAP3.ny2, v2 <: SWAP2.ny2 );      // SWAP4.condition := ( SWAP3.ny2 < SWAP2.ny2 );                // ( y3 < y2 )
    SWAP5.condition := ( SWAP4.ny1 == SWAP3.ny1 ) & ( SWAP4.nx1 < SWAP3.nx1 );                                                  // ( y2 == y1 ) & ( x2 < x1 )   SORT SO AS ( x1, y1 ) AT
                                                                                                                                // TOP LEFT if y1 == y2

    todraw := 0;

    always {
        uint12  DELAY = uninitialised;

        onehot( STATE ) {
            case 0: { busy = start; DELAY = -1; if( start ) { STATE = $STATE_PREPTRI_SORT$; } }                                 // ALLOW SORTING OF VERTICES
            case 1: { if( DELAY[0,1] ) { DELAY = DELAY[1,11]; } else { todraw = TODRAW.draw; STATE = $STATE_PREPTRI_WAIT$; } }  // START TRIANGLE DRAWING IF PIXELS TO DRAW
        }
    }
}
unit intriangle(                                                                                                                // DETERMINE IF A POINT IS INSIDE THE TRIANGLE OR A VERTEX
    input   int10   x0,                                                                                                         // REQUIRES POINTS TO BE CLOCKWISE FROM THE TOP LEFT POINT
    input   int10   y0,
    input   int10   x1,
    input   int10   y1,
    input   int10   x2,
    input   int10   y2,
    input   int10   px,
    input   int10   py,
    output  uint1   IN
) {
    IN := ~|{ ( ( x2 - x1 ) * ( py - y1 ) - ( y2 - y1 ) * ( px - x1 ) ) < 0,
                ( ( x0 - x2 ) * ( py - y2 ) - ( y0 - y2 ) * ( px - x2 ) ) < 0,
                ( ( x1 - x0 ) * ( py - y0 ) - ( y1 - y0 ) * ( px - x0 ) ) < 0 } |
                ( ( px == x0 ) & ( py == y0 ) ) | ( ( px == x1 ) & ( py == y1 ) ) | ( ( px == x2 ) & ( py == y2 ) );
}
unit drawtriangle(                                                                                                              // OUTPUT PIXELS FOR THE TRIANGLE
    input   uint1   start,                                                                                                      // TRIES TO SCAN THE MINIMUM NUMBER OF PIXELS POSSIBLE
    output  uint1   busy,
    input   uint9   min_x,
    input   uint8   min_y,
    input   uint9   max_x,
    input   uint8   max_y,
    input   int10   x0,
    input   int10   y0,
    input   int10   x1,
    input   int10   y1,
    input   int10   x2,
    input   int10   y2,
    output  uint9   bitmap_x_write,
    output  uint8   bitmap_y_write,
    output  uint1   bitmap_write
) {
    uint4               STATE = 1;
                        $$ STATE_TRIANGLE_WAIT      = 1
                        $$ STATE_TRIANGLE_SCAN      = 2
                        $$ STATE_TRIANGLE_REVERSE   = 4
                        $$ STATE_TRIANGLE_DOWN      = 8

    uint1               dx = uninitialized;                                                                                     // X DIRECTION, 1 == RIGHT, 0 == LEFT
    uint10              pxNEXT <:: IS.px + ( dx ? 1 : (-1) );
    uint10              pyNEXT <:: IS.py + 1;
    uint1               pyMORE <:: IS.py != max_y;
    uint1               eol <:: IS.px == ( dx ? max_x : min_x );                                                                // AT END OF LINE ( MIN_X OR MAX_X )
    int10               start_X <:: ( ( y0 == min_y ) & ( x0 > min_x ) & ( x0 <= max_x ) ) ? ( x0 - 1 ) : min_x;                // STARTING X COORDINATE ( top line 1 to left of x coordinate )
    uint10              sx = uninitialised;                                                                                     // SAVED COORDINATE WHEN DROPPING DOWN
    uint10              sx_SAVE <:: IS.px + ( dx ? (-1) : 1 );
    uint1               beenInTriangle = uninitialized;                                                                         // LOG IF BEEN IN TRIANGLE ON WORKING LINE

    intriangle IS( x0 <: x0, x1 <: x1, x2 <: x2, y0 <: y0, y1 <: y1, y2 <: y2 );                                                // DETERMINE IF WORKING POINT IS IN THE TRIANGLE


    bitmap_x_write := IS.px; bitmap_y_write := IS.py; bitmap_write := busy & IS.IN;                                             // OUTPUT IF ( PX, PY ) IS.IN THE TRIANGLE
    beenInTriangle := ( IS.IN | beenInTriangle ) &                                                                              // SET TO 1 IF EVER BEEN IN TRIANGLE ON THIS LINE
                      ~( STATE[3,1] | STATE[0,1] );                                                                             //  RESET IF NEW TRIANGLE OR MOVED DOWN A LINE

    always {
        onehot( STATE ) {                                                                                                       // STATE_TRIANGLE_WAIT
            case 0: {
                dx = 1; IS.px = start_X;                                                                                        // STARTING X COORDINATE
                IS.py = min_y; busy = start;                                                                                    //  GOING RIGHT
                if( start ) { STATE = $STATE_TRIANGLE_SCAN$; }                                                                  //  START SCANNING TRIANGLE LINE BY LINE
            }
            case 1: {                                                                                                           // STATE_TRIANGLE_SCAN
                if( pyMORE ) {
                    if( beenInTriangle ^ IS.IN ) {                                                                              //  SCAN LINE UNTIL BEEN IN THEN OUT OF TRIANGLE
                        IS.py = pyNEXT; STATE = $STATE_TRIANGLE_DOWN$;                                                          //  LEFT THE TRIANGLE, NEXT LINE
                    } else {
                        if( eol )  {                                                                                            //  END OF LINE?
                            dx = ~dx; beenInTriangle = 0; IS.py = pyNEXT;                                                       //      SWITCH DIRECTION AND MOVE TO THE NEXT LINE
                        } else {
                            IS.px = pxNEXT;                                                                                     //      MOVE TO THE NEXT PIXEL
                        }
                    }
                } else {
                    busy = 0; STATE = $STATE_TRIANGLE_WAIT$;
                }
            }
            case 2: {                                                                                                           // STATE_TRIANGLE_REVERSE ( MOVED DOWN AND WAS IN TRIANGLE )
                if( ( beenInTriangle ^ IS.IN ) | eol ) {                                                                        //  STILL IN TRIANGLE OR EOL?
                    IS.px = sx; dx = ~dx; STATE = $STATE_TRIANGLE_SCAN$;                                                        //      GO TO SAVED POSITION, SWITCH DIRECTION
                } else {
                    IS.px = pxNEXT;                                                                                             //      MOVE TO THE NEXT PIXEL
                }
            }
            case 3: {                                                                                                           // STATE_TRIANGLE_DOWN
                if( pyMORE ) {
                    if( IS.IN ) {                                                                                               //  STILL IN TRIANGLE?
                        sx = sx_SAVE; IS.px = pxNEXT;                                                                           //      SAVE AND MOVE TO NEXT PIXEL
                    } else {
                        dx = ~dx;                                                                                               //      SWITCH DIRECTION
                    }
                    STATE = IS.IN ? $STATE_TRIANGLE_REVERSE$ : $STATE_TRIANGLE_SCAN$;                                           //  OUTSIDE? SCAN WHOLE LINE, INSIDE? REVERSE UNTIL OUTSIDE
                } else {
                    busy = 0; STATE = $STATE_TRIANGLE_WAIT$;                                                                    //  FINISHED
                }
            }
        }
    }
}
unit triangle(
    input   uint1   start,
    output  uint1   busy,
    input   uint9   crop_left,
    input   uint9   crop_right,
    input   uint8   crop_top,
    input   uint8   crop_bottom,
    input   int10   x,
    input   int10   y,
    input   int10   x1,
    input   int10   y1,
    input   int10   x2,
    input   int10   y2,
    output  uint9   bitmap_x_write,
    output  uint8   bitmap_y_write,
    output  uint1   bitmap_write
) {
    preptriangle PREP(                                                                                                          // SORT THE COORDINATES AND FIND THE BOUNDING BOX
        start <: start,
        crop_left <: crop_left, crop_right <: crop_right, crop_top <: crop_top, crop_bottom <: crop_bottom,
        x <: x, y <: y, param0 <: x1, param1 <: y1, param2 <: x2, param3 <: y2
    );

    drawtriangle TRIANGLE(                                                                                                      // DRAW THE TRIANGLE IF ANY PIXELS TO DRAW
        min_x <: PREP.min_x, max_x <: PREP.max_x, min_y <: PREP.min_y, max_y <: PREP.max_y,
        x0 <: PREP.x1, y0 <: PREP.y1, x1 <: PREP.x2, y1 <: PREP.y2, x2 <: PREP.x3, y2 <: PREP.y3,
        bitmap_x_write :> bitmap_x_write, bitmap_y_write :> bitmap_y_write, bitmap_write :> bitmap_write,
        start <: PREP.todraw
    );

    busy := start | PREP.busy | PREP.todraw | TRIANGLE.busy;
}

// BLIT - ( tilecharacter == 0 ) OUTPUT PIXELS TO BLIT AN 8 x 8 CHARACTER ( PARAM1 == 0 as 8 x 8, == 1 as 16 x 16, == 2 as 32 x 32, == 3 as 64 x 64 )
// COLOURBLIT - OUTPUT PIXELS TO BLIT A 16 x 16 TILE ( PARAM1 == 0 as 16 x 16, == 1 as 32 x 32, == 2 as 64 x 64, == 3 as 128 x 128 )
unit blitscale(
    input   uint5   offset,
    input   uint2   scale,
    output  uint4   base,
    output  uint5   next,
    output  uint9   scaled
) {
    base := offset;
    next := offset + 1;
    scaled := offset << scale;
}
unit blit(
    input   uint2   start,
    output  uint2   busy,
    simple_dualport_bram_port0 blit1tilemap,
    simple_dualport_bram_port0 characterGenerator8x8,
    simple_dualport_bram_port0 colourblittilemap,

    input   int10   x,
    input   int10   y,
    input   uint9   tile,
    input   uint2   scale,
    input   uint3   action,

    output  int10   bitmap_x_write,
    output  int10   bitmap_y_write,
    output  uint1   bitmap_write,
    output  uint8   bitmap_colour_write,

    input   uint1   tilecharacter
) {
    uint4               STATE = 1;
                        $$ STATE_BLIT_WAIT          = 1
                        $$ STATE_BLIT_SCAN_TILE     = 2
                        $$ STATE_BLIT_MULT_PIXEL    = 4
                        $$ STATE_BLIT_SINGLE_PIXEL  = 8

    uint4               x2 = uninitialised;
    uint4               x2_NEXT <:: x2 + 1;
    uint4               y2 = uninitialised;
    uint4               y2_NEXT <:: y2 + 1;
    uint4               max_count <:: ( 1 << scale );                                                                           // NUMBER OF TIMES TO USE EACH PIXEL
    uint5               max_pixels <:: { tilecharacter, ~tilecharacter, 3b000 };                                                // NUMBER OF PIXELS WIDE 8 FOR CHARACTER, 16 FOR BLITTER TILES
    uint1               x2_MORE <:: ( x2 != max_count );
    uint1               y2_MORE <:: ( y2 != max_count );
    uint1               pxs_MORE <:: ( PXS.offset != max_pixels );
    uint1               pys_MORE <:: ( PYS.offset != max_pixels );
    uint3               action_FLAGS <:: { ( action[0,2] == 2b10 ), ( action[0,2] == 2b01 ), ~|action[0,2] };

    uint4               pixel_X <:: action[2,1] ? action_FLAGS[0,1] ? ~PXS.base :                                               // FIND X AND Y WITHIN THE TILE/CHARACTER BITMAP
                                                  action_FLAGS[1,1] ? PYS.base :                                                //  TAKING INTO ACCOUNT ROTATION AND REFLECTION
                                                  action_FLAGS[2,1] ? PXS.base : ~PYS.base :
                                    action[0,1] ? PXS.base : ~PXS.base;
    uint4               pixel_Y <:: action[2,1] ? action_FLAGS[0,1] ? PYS.base :
                                                  action_FLAGS[1,1] ? PXS.base :
                                                  action_FLAGS[2,1] ? ~PYS.base : ~PXS.base :
                                    action[1,1] ? ~PYS.base : PYS.base;

    blitscale PXS( scale <: scale ); blitscale PYS( scale <: scale );                                                           // SCALE FOR X AND Y

    blit1tilemap.addr0 := { tile[0,7], pixel_Y };                                                                               // SET TILE ADDRESSES
    characterGenerator8x8.addr0 := { tile, pixel_Y[0,3] };
    colourblittilemap.addr0 := { tile[0,7], pixel_Y, ~pixel_X };

    bitmap_x_write := x + PXS.scaled + ( max_count[0,1] ? 0 : x2 );                                                             // COPY THE OUTPUT COORDINATES
    bitmap_y_write := y + PYS.scaled + ( max_count[0,1] ? 0 : y2 );
    bitmap_colour_write := colourblittilemap.rdata0;                                                                            // COPY THE COLOUR BLITTER TILE COLOUR

    bitmap_write := ( STATE[3,1] | ( STATE[2,1] & y2_MORE & x2_MORE ) ) &
                    ( busy[0,1] ? tilecharacter ? blit1tilemap.rdata0[ pixel_X, 1] :                                            // OUTPUT BLIT TILE PIXEL
                                                  characterGenerator8x8.rdata0[ pixel_X, 1] :                                   // OUTPUT CHARACTER TILE PIXEL
                                                  colourblittilemap.rdata0 != 64 );                                             // OUTPUT COLOUR PIXEL

    always {
        onehot( STATE ) {
            case 0: {                                                                                                           // STATE_BLIT_WAIT
                busy = start; PYS.offset = 0; PXS.offset = 0;                                                                   //  SET TO TOP LEFT OF TILE
                if( |start ) { STATE = $STATE_BLIT_SCAN_TILE$; }                                                                //  START SCANNING THE TILE
            }
            case 1: {                                                                                                           // STATE_BLIT_SCAN_TILE
                if( pys_MORE ) {                                                                                                //  SCAN THROUGH TILE, LINE BY LINE
                    if( pxs_MORE ) {
                        x2 = 0; y2 = 0;
                        STATE = max_count[0,1] ? $STATE_BLIT_SINGLE_PIXEL$ : $STATE_BLIT_MULT_PIXEL$;                           //  OUTPUT SINGLE / MULTIPLE PIXELS
                    } else {
                        PXS.offset = 0; PYS.offset = PYS.next;
                    }
                } else {
                    busy = 0; STATE = $STATE_BLIT_WAIT$;
                }
            }
            case 2: {                                                                                                           // STATE_BLIT_MULT_PIXEL
                if( y2_MORE ) {                                                                                                 //  OUTPUT MULTIPLE PIXELS ( scale x scale )
                    if( x2_MORE ) {
                        x2 = x2_NEXT;
                    } else {
                        x2 = 0; y2 = y2_NEXT;
                    }
                } else {
                    PXS.offset = PXS.next; STATE = $STATE_BLIT_SCAN_TILE$;
                }
            }
            case 3: { PXS.offset = PXS.next; STATE = $STATE_BLIT_SCAN_TILE$; }                                                  // STATE_BLIT_SINGLE_PIXEL
        }


    }
}

// PIXELBLOCK - OUTPUT PIXELS TO RECTANGLE START AT X, Y WITH WIDTH PARAM0, PIXELS PROVIDED SEQUENTIALLY BY CPU, MOVE ALONG RECTANGLE UNTIL STOP RECEIVED
// CAN HANDLE 256 colours, with one defined as transparent or 24bit RGB colours, scaling to the PAWS colour map
unit pixelblock(
    input   uint1               start,
    output  uint1               busy,
    simple_dualport_bram_port0  colourmap,

    input   int10               x,
    input   int10               y,
    input   int10               width,
    input   uint8               ignorecolour,

    input   uint2               mode,
    input   uint8               colour,
    input   uint8               colour8r,
    input   uint8               colour8g,
    input   uint8               colour8b,
    input   uint2               newpixel,

    output  int10               bitmap_x_write,
    output  int10               bitmap_y_write,
    output  uint8               bitmap_colour_write,
    output  uint1               bitmap_write
) {
    uint2               STATE = 1;
                        $$ STATE_PB_WAIT    = 1
                        $$ STATE_PB_PROCESS = 2

    int10               x_START <:: x - 1;                                                                                      // START 1 PIXEL LEFT
    int10               bitmap_x_write_NEXT <:: bitmap_x_write + 1;                                                             // NEXT PIXEL ALONG LINE
    int10               bitmap_y_write_NEXT <:: bitmap_y_write + 1;                                                             // NEXT LINE
    uint1               EOL <:: ( bitmap_x_write == ( x - 1 + width ) );                                                        // AT END OF LINE?

    uint2               toprocess = uninitialised;                                                                              // OUTPUT AND PIXEL PROCESSING MODE ( latch for next cycle )
    uint8               thiscolour  = uninitialised;                                                                            //  COLOUR INPUT FROM CPU/DMA
    uint8               rrgggbbm  = uninitialised;                                                                              //  RGB -> RGBM
    uint8               grey  = uninitialised;                                                                                  //  RGB -> GREYSCALE

    bitmap_colour_write := ( toprocess == 1 ) ? mode[0,1] ? colourmap.rdata0 : thiscolour :                                     //  8 BIT COLOUR, REMAP?
                                                mode[0,1] ? ( grey == 64 ) ? 65 : grey :                                        //  RGB -> GREY ( map 64 to next grey level )
                                                            ( ( rrgggbbm == 64 ) & ~mode[1,1] ) ? 128 : rrgggbbm;               //  RGB -> RGBM ( map 64 to next red level )

    bitmap_write := STATE[1,1] & ( ( ( toprocess == 1 ) & ( mode[1,1] | ( thiscolour != ignorecolour ) ) ) |                    //  WRITE IF 8 BIT AND !ignore OR WRITEALL
                                     ( toprocess == 2 ) );                                                                      //  OR RGB

    always {
        onehot( STATE ) {
            case 0: {                                                                                                           // STATE_PB_WAIT
                bitmap_x_write = x_START; bitmap_y_write = y; busy = start;                                                     //  COPY STARTING COORDINATES ( -1 as moved before drawing )
                if( start ) { STATE = $STATE_PB_PROCESS$; }
            }
            case 1: {                                                                                                           // STATE_PB_PROCESS
                switch( toprocess ) {
                    case 0: {}
                    default: {                                                                                                  // PIXEL OUTPUT REQUEST
                        if( EOL ) {                                                                                             //  MOVE TO NEXT PIXEL ( check EOL )
                            bitmap_x_write = x; bitmap_y_write = bitmap_y_write_NEXT;                                           //      NEW LINE
                        } else {
                            bitmap_x_write = bitmap_x_write_NEXT;                                                               //      NEXT PIXEL
                        }
                    }
                    case 3: { busy = 0; STATE = $STATE_PB_WAIT$; }                                                              //  STOP SIGNAL RECEIVED
                }
            }
        }

        toprocess = newpixel;                                                                                                   // LATCH  NEW PIXEL REQUEST
        colourmap.addr0 = colour;                                                                                               //  LOOKUP THE COLOUR FROM THE REMAPPER
        thiscolour = colour;
        rrgggbbm = { colour8r[6,2], colour8g[5,3], colour8b[6,2], colour8r[5,1] & colour8b[5,1] };
        grey = ( ( colour8r * 3 + colour8g * 6 + colour8b ) * 205 ) >> 11;
    }
}
