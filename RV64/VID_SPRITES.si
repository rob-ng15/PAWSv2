// Sprite update flag ( NO LONGER APPLIED BY HARDWARE, IMPLEMENTED IN THE LIBRARY AS A COMPATIBILITY FUNCTION )
bitfield spriteupdate {
    uint1   y_act,                                                                                                              // 1 - kill when off screen, 0 - wrap
    uint1   x_act,                                                                                                              // 1 - kill when off screen, 0 - wrap
    uint1   tile_act,                                                                                                           // 1 - increase the tile number
    uint1   dysign,                                                                                                             // dy - 2's complement update for the y coordinate
    uint4   dy,
    uint1   dxsign,                                                                                                             // dx - 2's complement update for the x coordinate
    uint4   dx
}

// Sprite action flag
bitfield spriteaction {
    uint2   layer,                                                                                                              // layer number
    uint1   mode,                                                                                                               // == 0 8x16x16, == 1 2x32x32 Sprite display mode
    uint1   updown,                                                                                                             // == 0 shift up, == 1 shift down ( by next bitfield )
    uint2   scale,                                                                                                              // number of bits to shift left or right to scale the sprite
    uint1   refrot,                                                                                                             // == 0 reflect, == 1 rotate ( by next bitfield )
    uint2   action                                                                                                              // ( reflect { y, x } ) ( rotate { 270, 180, 90, 0 } )
}

unit sprite_max(
    input   int11   x,
    input   int11   y,
    input   uint8   size,
    output! int11   max_x,
    output! int11   max_y
) <reginputs> {
    max_x := x + size;
    max_y := y + size;
}

unit sprite_layer(
    input   uint10              pix_x,                                                                                          // DISPLAY INPUTS   X
    input   uint10              pix_x1,                                                                                         //                  X+1 FOR PRE-FETCHING
    input   uint9               pix_y,                                                                                          //                  Y
    input   uint1               pix_end,                                                                                        //                  ( 639, 479 )

    output! uint32              pixels,                                                                                        // DISPLAY OUTPUTS  PIXEL FOR SPRITE LAYERS
    output! uint4               sprite_display,                                                                                 //                  PIXELS TO DISPLAY?

    input   uint1               collision_bitmap_0,                                                                             // BITMAP 0 PIXEL?
    input   uint1               collision_bitmap_1,                                                                             // BITMAP 1 PIXEL?
    input   uint1               collision_layer_2,                                                                              // TILEMAP 0 PIXEL?
    input   uint1               collision_layer_3,                                                                              // TILEMAP 1 PIXEL?
    input   uint1               collision_layer_4,                                                                              // TILEMAP 2 PIXEL?
    input   uint1               collision_layer_5,                                                                              // TILEMAP 3 PIXEL?
    input   uint1               collision_layer_6,                                                                              // CHARACTER MAP PIXEL?

    dualport_bram_port1         sprite_active,                                                                                  // SPRITE REGISTERS FROM CPU
    dualport_bram_port1         sprite_actions,
    dualport_bram_port1         sprite_size,
    dualport_bram_port1         sprite_tile,
    dualport_bram_port1         sprite_x,
    dualport_bram_port1         sprite_y,
    simple_dualport_bram_port1  sprite_collision_memory,                                                                        // SPRITE COLLISION REGISTERS
    simple_dualport_bram_port1  sprite_layer_collision_memory,                                                                  // SPRITE COLLISION LAYER REGISTERS

    input   uint11  writerpixel,                                                                                                // FOR WRITING SPRITE TILEMAPS  PIXEL NUMBER
    input   uint8   WDATA,                                                                                                      //                              PIXEL
    input   uint32  wenable1                                                                                                    //                              WRITE ENDABLE FLAGS
) <reginputs> {
    uint2               STATE = 2;
                        $$ STATE_SPRITE_COPY    = 1
                        $$ STATE_SPRITE_DISPLAY = 2
    uint6               outputcount = -1;
    uint6               outputcount_NEXT <::outputcount + 1;

    $$for i=0,31 do
    dualport_bram uint8 tiles_$i$[2048] = uninitialised;                                                                        // Sprite Tiles - 16 x 16 x 8 in RRGGGBBM colour
    uint64  detect_collision_$i*2$ = uninitialised;                                                                             // Collision detection flag sprite to sprite ( 0-63 )
    uint7   detect_layer_$i*2$ = uninitialised;                                                                                 // Collision detection flag sprite to other layers ( 0-63 )
    uint64  detect_collision_$i*2+1$ = uninitialised;                                                                           // Collision detection flag sprite to sprite ( 0-63 )
    uint7   detect_layer_$i*2+1$ = uninitialised;                                                                               // Collision detection flag sprite to other layers ( 0-63 )

    sprite_generator SPRITE_$i*2$(                                                                                              // SPRITE GENERATORS, EVEN SPRITES, USING TILE0
        tiles <:> tiles_$i$,
        x <: pix_x,
        x1 <: pix_x1,
        y <: pix_y,
    );
    sprite1_generator SPRITE_$i*2+1$(                                                                                           // SPRITE GENERATORS, ODD SPRITES, USING TILE1
        tiles <:> tiles_$i$,
        x <: pix_x,
        x1 <: pix_x1,
        y <: pix_y,

        writerpixel <: writerpixel,
        WDATA <: WDATA,
        wenable1 <: wenable1[$i$,1]
    );
    $$end

    sprite_max MAX( x <: sprite_x.rdata1, y <: sprite_y.rdata1, size <: sprite_size.rdata1 );

    uint64  sprite_visible <: {                                                                                                 // SPRITE VISIBLE FLAGS AT EACH PIXEL
                                $$for i=0,62 do
                                SPRITE_$63-i$.pix_visible,
                                $$end
                                SPRITE_0.pix_visible
                              };
    uint7   layer_visible <: {
                                collision_layer_6,                                                                              //      CHARACTER MAP
                                collision_layer_5,                                                                              //      TILEMAP 3
                                collision_layer_4,                                                                              //      TILEMAP 2
                                collision_layer_3,                                                                              //      TILEMAP 1
                                collision_layer_2,                                                                              //      TILEMAP 0
                                collision_bitmap_1,                                                                             //      BITMAP 1
                                collision_bitmap_0                                                                              //      BITMAP 0
                             };

    sprite_collision_memory.wenable1 := STATE[0,1]; sprite_layer_collision_memory.wenable1 := STATE[0,1];
    sprite_display := 0;

    always {
        onehot( STATE ) {
            case 0: {                                                                                                           // COPY CPU INPUTS TO SPRITE GENERATORS
                sprite_collision_memory.addr1 = outputcount; sprite_layer_collision_memory.addr1 = outputcount;
                sprite_active.addr1 = outputcount_NEXT;
                sprite_tile.addr1 = outputcount_NEXT;
                sprite_actions.addr1 = outputcount_NEXT;
                sprite_size.addr1 = outputcount_NEXT;
                sprite_x.addr1 = outputcount_NEXT;
                sprite_y.addr1 = outputcount_NEXT;

                switch( outputcount ) {                                                                                         // CYCLE THROUGH EACH OF THE SPRITES
                    $$for i=0,63 do
                    case $i$: {
                        SPRITE_$i$.sprite_active = sprite_active.rdata1;
                        SPRITE_$i$.sprite_tile_number = sprite_tile.rdata1;
                        SPRITE_$i$.sprite_actions = sprite_actions.rdata1;
                        SPRITE_$i$.sprite_x = sprite_x.rdata1;
                        SPRITE_$i$.sprite_y = sprite_y.rdata1;
                        SPRITE_$i$.max_x = MAX.max_x;
                        SPRITE_$i$.max_y = MAX.max_y;
                        sprite_collision_memory.wdata1 = detect_collision_$i$; detect_collision_$i$ = 0;
                        sprite_layer_collision_memory.wdata1 = detect_layer_$i$; detect_layer_$i$ = 0;
                    }
                    $$end
                }

                if( &outputcount ) { STATE = $STATE_SPRITE_DISPLAY$; } else { outputcount = outputcount_NEXT; }                 // WHEN COMPLETED ALL SPRITES SWITCH TO DISPLAY STATE
            }
            case 1: {                                                                                                           // DISPLAY SPRITES
                $$for i=0,63 do
                if( SPRITE_$i$.pix_visible ) {                                                                                  // ARE SPRITES 0 TO 63 VISIBLE?
                    sprite_display[ spriteaction( SPRITE_$i$.sprite_actions ).layer, 1 ] = 1;                                   //      SET SPRITE LAYER VISIBLE FLAG
                    pixels[ { spriteaction( SPRITE_$i$.sprite_actions ).layer, 3b000 }, 8 ] = SPRITE_$i$.pixel;                 //      SET SPRITE LAYER PIXEL
                    detect_collision_$i$ = detect_collision_$i$ | sprite_visible;                                               //  UPDATE SPRITE TO SPRITE COLLISIONS
                    detect_layer_$i$ = detect_layer_$i$ | layer_visible;                                                        //  UPDATE SPRITE TO LAYER COLLISIONS
                }
                $$end

                if( pix_end ) { STATE = $STATE_SPRITE_COPY$; outputcount = 0; }                                                 // CHECK FOR START OF VBLANK
            }
        }
    }
}

unit sprite_transform(                                                                                                          // TRANSFORM X,Y FOR REFLECTION/ROTATION IN SPRITE TILE
    input   uint5   xspriteshift,                                                                                               // X COORDINATE IN SPRITE TILE
    input   uint5   yspriteshift,                                                                                               // Y COORDINATE IN SPRITE TILE
    input   uint3   actions,                                                                                                    // REFLECTION/ROTATION FLAGS
    output! uint5   x,                                                                                                          // TRANSFORMED X COORDINATE
    output! uint5   y                                                                                                           // TRANSFORMED Y COORDINATE
) <reginputs> {
    uint1   action00 <:: ( ~|actions[0,2] );                                                                                     // CHECK ACTION FLAGS FOR REFLECTION/ROTATION
    uint1   action01 <:: ( actions[0,2] == 2b01 );
    uint1   action10 <:: ( actions[0,2] == 2b10 );

    x := actions[2,1] ? action00 ? xspriteshift : action01 ?  yspriteshift : action10 ? ~xspriteshift : ~yspriteshift :         // CALCULATE X IN TILE FOR  ROTATION
                        actions[0,1] ? ~xspriteshift : xspriteshift;                                                            //                          REFLECTION
    y := actions[2,1] ? action00 ? yspriteshift : action01 ? ~xspriteshift : action10 ? ~yspriteshift :  xspriteshift :         // CALCULATE Y IN TILE FOR  ROTATION
                        actions[1,1] ? ~yspriteshift : yspriteshift;                                                            //                          REFLECTION
}

unit sprite_in(                                                                                                                 // SEE IF WITHIN THE SPRITE TILE
    input   uint11  pix_x,
    input   uint10  pix_y,
    input   int11   sprite_x,
    input   int11   sprite_y,
    input   int11   max_x,
    input   int11   max_y,
    output! uint1   IN
) <reginputs> {
    IN := ( __signed( pix_x ) >= __signed( sprite_x ) ) &                                                                       // ARE WE IN THE SPRITE?
          ( __signed( pix_x ) <  __signed( max_x ) ) &
          ( __signed( pix_y ) >= __signed( sprite_y ) ) &
          ( __signed( pix_y ) <  __signed( max_y ) );
}

unit sprite_shift(                                                                                                              // SCALE THE PIXEL
    input   int11   POS,
    input   uint1   DIR,
    input   uint2   NUM,
    output! uint5   SHIFT
) <reginputs> {
    SHIFT := DIR ? ( POS << NUM ) : ( POS >>> NUM );
}

unit pos_in(                                                                                                                    // FIND THE PIXEL POSITION WITHIN THE SPRITE
    input   int11   START,
    input   uint11  COORD,
    output! int11   WHERE
) <reginputs> {
    WHERE := ( COORD - START );
}
unit sprite_generator(
    input   uint11  x,
    input   uint11  x1,
    input   uint10  y,
    input   uint1   sprite_active,
    input   uint9   sprite_actions,
    input   int11   sprite_x,
    input   int11   sprite_y,
    input   int11   max_x,
    input   int11   max_y,
    input   uint3   sprite_tile_number,
    dualport_bram_port0 tiles,
    output! uint1   pix_visible,
    output! uint8   pixel
) <reginputs> {
    pos_in X_PIX( START <: sprite_x, COORD <: x1 );                                                                             // X PIXEL IN SPRITE TILE
    pos_in Y_PIX( START <: sprite_y, COORD <: y );                                                                              // Y PIXEL IN SPRITE TILE
    sprite_shift X( POS <: X_PIX.WHERE, DIR <: sprite_actions[5,1], NUM <: sprite_actions[3,2] );                               // SCALE X PIXEL
    sprite_shift Y( POS <: Y_PIX.WHERE, DIR <: sprite_actions[5,1], NUM <: sprite_actions[3,2] );                               // SCALE Y PIXEL
    sprite_transform TRANSFORM( actions <: sprite_actions, xspriteshift <: X.SHIFT, yspriteshift <: Y.SHIFT );                  // PERFORM ROTATION/REFLECTION
    sprite_in IS( pix_x <: x, pix_y <: y, sprite_x <: sprite_x, sprite_y <: sprite_y, max_x <: max_x, max_y <: max_y );         // IS SCREEN PIXEL WITHIN SPRITE TILE

    tiles.addr0 := sprite_actions[6,1] ? { sprite_tile_number[0,1], TRANSFORM.y,      TRANSFORM.x } :                           // 2 x 32x32 in tilemap
                                         { sprite_tile_number,      TRANSFORM.y[0,4], TRANSFORM.x[0,4] };                       // 8 x 16x16 in tilemap
    pixel := tiles.rdata0;                                                                                                      // OUTPUT PIXEL COLOUR ( current pixel )
    pix_visible := sprite_active & ( tiles.rdata0 != 64 ) & IS.IN;                                                              // IS THE PIXEL NOT TRANSPARENT AND WITHIN THE SPRITE TILE
}

unit sprite1_generator(
    input   uint11  x,
    input   uint11  x1,
    input   uint10  y,
    input   uint1   sprite_active,
    input   uint9   sprite_actions,
    input   int11   sprite_x,
    input   int11   sprite_y,
    input   int11   max_x,
    input   int11   max_y,
    input   uint3   sprite_tile_number,
    dualport_bram_port1 tiles,
    output! uint1   pix_visible,
    output! uint8   pixel,

    input   uint11  writerpixel,
    input   uint8   WDATA,
    input   uint1   wenable1
) <reginputs> {
    pos_in X_PIX( START <: sprite_x, COORD <: x1 );                                                                             // X PIXEL IN SPRITE TILE
    pos_in Y_PIX( START <: sprite_y, COORD <: y );                                                                              // Y PIXEL IN SPRITE TILE
    sprite_shift X( POS <: X_PIX.WHERE, DIR <: sprite_actions[5,1], NUM <: sprite_actions[3,2] );                               // SCALE X PIXEL
    sprite_shift Y( POS <: Y_PIX.WHERE, DIR <: sprite_actions[5,1], NUM <: sprite_actions[3,2] );                               // SCALE Y PIXEL
    sprite_transform TRANSFORM( actions <: sprite_actions, xspriteshift <: X.SHIFT, yspriteshift <: Y.SHIFT );                  // PERFORM ROTATION/REFLECTION
    sprite_in IS( pix_x <: x, pix_y <: y, sprite_x <: sprite_x, sprite_y <: sprite_y, max_x <: max_x, max_y <: max_y );         // IS SCREEN PIXEL WITHIN SPRITE TILE

    tiles.addr1 :=            wenable1 ? writerpixel :                                                                          // WRITE/READ ADDRESS ( next pixel ) FOR SPRITE TILE
                   sprite_actions[6,1] ? { sprite_tile_number[0,1], TRANSFORM.y,      TRANSFORM.x } :                           //  2 x 32x32 in tilemap
                                         { sprite_tile_number,      TRANSFORM.y[0,4], TRANSFORM.x[0,4] };                       //  8 x 16x16 in tilemap
    tiles.wdata1 := WDATA;                                                                                                      // PIXEL TO WRITE
    tiles.wenable1 := wenable1;                                                                                                 // PIXEL WRITE ENABLE

    pixel := tiles.rdata1;                                                                                                      // OUTPUT PIXEL COLOUR ( current pixel )
    pix_visible := sprite_active & ( tiles.rdata1 != 64 ) & IS.IN;                                                              // IS THE PIXEL NOT TRANSPARENT AND WITHIN THE SPRITE TILE
}

unit sprite_memmap(
    // Clocks
    input   uint1   video_clock,
    input   uint1   video_reset,

    // Pixels
    input   uint10  pix_x,
    input   uint10  pix_x1,
    input   uint9   pix_y,
    input   uint1   pix_end,
    output! uint32  pixels,
    output! uint4   sprite_display,

    // Memory access
    input   uint1   bitmapwriter,
    input   uint2   ADDR,
    input   uint8   WDATA,

    input   uint1   collision_bitmap_0,
    input   uint1   collision_bitmap_1,
    input   uint1   collision_layer_2,
    input   uint1   collision_layer_3,
    input   uint1   collision_layer_4,
    input   uint1   collision_layer_5,
    input   uint1   collision_layer_6,

    // For reading sprite characteristics
    dualport_bram_port1  sprite_active,
    dualport_bram_port1  sprite_actions,
    dualport_bram_port1  sprite_size,
    dualport_bram_port1  sprite_tile,
    dualport_bram_port1  sprite_x,
    dualport_bram_port1  sprite_y,
    simple_dualport_bram_port1 sprite_collision_memory,
    simple_dualport_bram_port1 sprite_layer_collision_memory
) <reginputs> {
    uint11  writerpixel_NEXT <:: sprites.writerpixel + 1;
    uint5   writerspritenumber = uninitialised;

    sprite_layer sprites <@video_clock,!video_reset> (
        pix_x <: pix_x, pix_x1 <: pix_x1, pix_y <: pix_y, pix_end <: pix_end,
        pixels :> pixels, sprite_display :> sprite_display,

        collision_bitmap_0 <: collision_bitmap_0,
        collision_bitmap_1 <: collision_bitmap_1,
        collision_layer_2 <: collision_layer_2,
        collision_layer_3 <: collision_layer_3,
        collision_layer_4 <: collision_layer_4,
        collision_layer_5 <: collision_layer_5,
        collision_layer_6 <: collision_layer_6,

        sprite_collision_memory <:> sprite_collision_memory,
        sprite_layer_collision_memory <:> sprite_layer_collision_memory,

        sprite_active <:> sprite_active,
        sprite_actions <:> sprite_actions,
        sprite_size <:> sprite_size,
        sprite_tile <:> sprite_tile,
        sprite_x <:> sprite_x,
        sprite_y <:> sprite_y,

        WDATA <: WDATA
    );

    always {
        uint1   latch = uninitialised;

        if( latch ) { latch = 0; } else { sprites.wenable1 = 0; }                                                               // LATCH WRITE FLAG FOR 50 -> 25MHz

        if( bitmapwriter ) {                                                                                                    //  WRITE TO BITMAP?
            switch( ADDR[1,1] ) {
                case 0: { writerspritenumber = WDATA; sprites.writerpixel = -1; }
                case 1: { sprites.wenable1[ writerspritenumber, 1 ] = 1; latch = 1; sprites.writerpixel = writerpixel_NEXT; }
            }
        }
    }
}
