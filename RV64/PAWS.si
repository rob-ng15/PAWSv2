$$if ICARUS or VERILATOR then
// PLL for simulation
unit pll(
  output  uint1 video_clock,
  output! uint1 sdram_clock,
  output! uint1 clock_decode,
  output  uint1 compute_clock
) {
  uint3 counter = 0;
  uint8 trigger = 8b11111111;
  sdram_clock   := clock;
  clock_decode   := clock;
  compute_clock := ~counter[0,1];   // x2 slower
  video_clock   := counter[1,1];    // x4 slower

  always { counter = counter + 1; trigger = trigger >> 1; }
}
$$end

unit main(
    // LEDS (8 of)
    output  uint8   leds,
$$if not SIMULATION then
    input   uint$NUM_BTNS$ btns,

    // UART
    output  uint1   uart_tx,
    input   uint1   uart_rx,

    // GPIO
    input   uint28  gn,
    output  uint28  gp,

    // USB PS/2
    input   uint1   us2_bd_dp,
    input   uint1   us2_bd_dn,
    output  uint1   usb_fpga_pu_dp(1),
    output  uint1   usb_fpga_pu_dn(1),

    // AUDIO
    output  uint4   audio_l,
    output  uint4   audio_r,

    // SDCARD
    output  uint1   sd_clk,
    output  uint1   sd_mosi,
    output  uint1   sd_csn,
    input   uint1   sd_miso,
$$end

$$if HDMI then
    // HDMI OUTPUT
    output! uint4   gpdi_dp,
$$end
$$if VGA then
    // VGA OUTPUT
    output! uint$color_depth$ video_r,
    output! uint$color_depth$ video_g,
    output! uint$color_depth$ video_b,
    output  uint1 video_hs,
    output  uint1 video_vs,
$$end
$$if VERILATOR then
    output  uint1 video_clock,
$$end
    // SDRAM
    output! uint1  sdram_cle,
    output! uint2  sdram_dqm,
    output! uint1  sdram_cs,
    output! uint1  sdram_we,
    output! uint1  sdram_cas,
    output! uint1  sdram_ras,
    output! uint2  sdram_ba,
    output! uint13 sdram_a,
$$if VERILATOR then
    output! uint1  sdram_clock, // sdram controller clock
    input   uint16 sdram_dq_i,
    output! uint16 sdram_dq_o,
    output! uint1  sdram_dq_en,
$$else
    output uint1  sdram_clk,  // sdram chip clock != internal sdram_clock
    inout  uint16 sdram_dq,
$$end
    inout   uint1   gpdi_sda,   // i2c for rtc
    inout   uint1   gpdi_scl
) <@clock_system,reginputs> {
    uint1   clock_system = uninitialized;
    uint1   clock_gpu = uninitialized;
    uint1   clock_cpu = uninitialized;
    uint1   clock_cache = uninitialized;
    uint1   clock_decode = uninitialized;
    uint1   clock_palette = uninitialized;
$$if VERILATOR then
    $$clock_25mhz = 'video_clock'
    // --- PLL
    pll clockgen<@clock,!reset>(
      video_clock   :> video_clock,
      sdram_clock   :> sdram_clock,
      clock_decode   :> clock_decode,
      compute_clock :> clock_system,
      compute_clock :> clock_gpu,
      compute_clock :> clock_cpu,
      clock_decode :> clock_cache,
      compute_clock :> clock_palette,
    );
$$else
    $$clock_25mhz = 'clock'
    // CLOCK/RESET GENERATION
    // CPU + MEMORY
    uint1   sdram_clock = uninitialized;
    uint1   pll_lock_SYSTEM = uninitialized;
    ulx3s_clk_PAWS_SYSTEM clk_gen_SYSTEM (
        clkin    <: $clock_25mhz$,
        clkSYSTEM  :> clock_system,
        clkSDRAM :> sdram_clock,
        clkGPU :> clock_gpu,
        clkSDRAMcontrol :> sdram_clk,
        locked   :> pll_lock_SYSTEM
    );
    uint1   pll_lock_CPU = uninitialized;
    ulx3s_clk_PAWS_CPU clk_gen_CPU (
        clkin    <: $clock_25mhz$,
        clkCPU :> clock_cpu,
        clkDECODE :> clock_decode,
        clkCACHE :> clock_cache,
        clkPAL :> clock_palette,
        locked   :> pll_lock_CPU
    );
$$end

    uint2   ACCESSSIZE <:: DMA_NEW.ACTIVE ? DMA_NEW.ACCESSSIZE : DMA_AUDIO.ACTIVE ? 2b10 : CPU.accesssize;                      // SELECT ACTIVE BUS, DMA OR CPU    MEMORY ACCESSSIZE
    uint32  WRITEDATA <:: DMA_NEW.ACTIVE ? DMA_NEW.WRITEDATA : CPU.writedata;                                                   //                                  WRITEDATA
    uint1   READFLAG <:: CPU.readmemory | DMA_NEW.READFLAG | DMA_AUDIO.READFLAG;                                                //                                  READFLAG
    uint1   WRITEFLAG <:: CPU.writememory | DMA_NEW.WRITEFLAG;                                                                  //                                  WRITEFLAG
    uint$addr_width$ ADDRESS <:: DMA_NEW.ACTIVE ? DMA_NEW.ADDRESS : DMA_AUDIO.ACTIVE ? DMA_AUDIO.ADDRESS : CPU.address;         //                                  ADDRESS
    uint$addr_width$  address2 <:: ( DMA_NEW.ACTIVE ? DMA_NEW.ADDRESS : DMA_AUDIO.ACTIVE ? DMA_AUDIO.ADDRESS : CPU.address ) + 2;   //                              + 2
    uint$addr_width$  address0 <:: ( DMA_NEW.ACTIVE ? DMA_NEW.ADDRESS : DMA_AUDIO.ACTIVE ? DMA_AUDIO.ADDRESS : CPU.address ) +      //                              ALIGN ON 16 BIUT BOUNDARY
                                   { ( DMA_NEW.ACTIVE ? DMA_NEW.ADDRESS[1,1] : DMA_AUDIO.ACTIVE ? DMA_AUDIO.ADDRESS[1,1] : CPU.address[1,1] ), 1b0 };

    uint1   SDRAM <:: ADDRESS[$addr_width-1$,1];                                                                                // CHIPSELECT   SDRAM
    uint1   BITMAPDIRECT <:: ADDRESS[$addr_width-2$,2] == 2b01;                                                                 //              FRAMEBUFFER(S)
    uint1   CMAPDIRECT <:: ADDRESS[$addr_width-3$,3] == 3b001;                                                                  //              CHARACTER MAP BUFFER
    uint1   TMAPDIRECT <:: ADDRESS[$addr_width-4$,4] == 4b0001;                                                                 //              TILE MAP BUFFER(S)
    uint1   BRAM <:: ~|ADDRESS[$addr_width-4$,4] & ~ADDRESS[15,1];                                                              //              BRAM / BIOS
    uint1   TIMERS <:: ~|ADDRESS[$addr_width-4$,4] & ( ADDRESS[12,4] == 4hc );                                                  //              TIMER REGISTERS
    uint1   VIDEO <:: ~|ADDRESS[$addr_width-4$,4] & ( ADDRESS[12,4] == 4hd );                                                   //              VIDEO BLOCKS REGISTERS
    uint1   AUDIO <:: ~|ADDRESS[$addr_width-4$,4] & ( ADDRESS[12,4] == 4he );                                                   //              AUDIO REGISTERS
    uint1   IO <:: ~|ADDRESS[$addr_width-4$,4] & ( ADDRESS[12,4] == 4hf );                                                      //              I/O + DMA + SMT REGISTERS

    // SDRAM chip controller by @sylefeb
    uint1   sdram_reset = uninitialized; clean_reset sdram_rstcond <@sdram_clock,!reset> ( out :> sdram_reset );                // SDRAM RESET SIGNAL GENERATOR
    sdram_r16w16_io sio_fullrate; sdram_r16w16_io sio_halfrate;                                                                 // SDRAM IS 16 BIT 100MHz SDRAM CLOCK, 50MHz SYSTEM CLOCK
    sdram_half_speed_access sdaccess <@sdram_clock,!sdram_reset> ( sd <:> sio_fullrate, sdh <:> sio_halfrate );                 // SDRAM RUNS AT 100MHZ, SYSTEM AT 50MHz
    sdram_controller_autoprecharge_r16_w16 sdram32MB <@sdram_clock,!sdram_reset> (                                              // SDRAM CONTROLLER
        sd        <:> sio_fullrate,                                                                                             // CONTROL SIGNALS GO THROUGH A CLOCK GATE
        sdram_cle :>  sdram_cle,
        sdram_dqm :>  sdram_dqm,
        sdram_cs  :>  sdram_cs,
        sdram_we  :>  sdram_we,
        sdram_cas :>  sdram_cas,
        sdram_ras :>  sdram_ras,
        sdram_ba  :>  sdram_ba,
        sdram_a   :>  sdram_a,
  $$if VERILATOR then
        dq_i       <: sdram_dq_i,
        dq_o       :> sdram_dq_o,
        dq_en      :> sdram_dq_en,
  $$else
        sdram_dq  <:> sdram_dq,
  $$end
    );

    cachecontroller DRAM <@clock_system,!reset> (                                                                               // SDRAM VIA CACHE ( controls 16 BIT <-> 32 BIT )
        sio <:> sio_halfrate,
        clock_cache <: clock_cache,

        CS <: SDRAM,
        RENABLE <: READFLAG,
        WENABLE <: WRITEFLAG,
        SIZE <: ACCESSSIZE,
        ADDR <: ADDRESS[0,$sdram_width$],
        ADDR0 <: address0[0,$sdram_width$],
        ADDR2 <: address2[0,$sdram_width$],
        WDATA <: WRITEDATA
    );

    bramcontroller RAM <@clock_system,!reset> (                                                                                 // BRAM CONTROLLER
        CS <: BRAM,
        SIZE <: ACCESSSIZE,
        ADDR <: ADDRESS,
        ADDR2 <: address2,
        WDATA <: WRITEDATA,
        WENABLE <: WRITEFLAG
    );

    io_memmap IO_Map <@clock_system,!reset> (                                                                                   // I/O REGISTERS CONTROLLER
        CS <: IO,
        ADDR <: ADDRESS,                                                                                                        //  MEMORY MAPPING
        WENABLE <: WRITEFLAG,
        RENABLE <: READFLAG,
        WDATA <: WRITEDATA,

        leds :> leds,                                                                                                           //  LEDS
$$if not SIMULATION then
        gn <: gn,                                                                                                               //  GPIO
        gp :> gp,
        btns <: btns,                                                                                                           //  ULX3S BUTTONS
        uart_tx :> uart_tx,                                                                                                     //  UART
        uart_rx <: uart_rx,
        us2_bd_dp <: us2_bd_dp,                                                                                                 //  USB OTG PORT, FOR PS/2 KEYBOARD
        us2_bd_dn <: us2_bd_dn,
        sd_clk :> sd_clk,                                                                                                       //  SDCARD
        sd_mosi :> sd_mosi,
        sd_csn :> sd_csn,
        sd_miso <: sd_miso,
$$end
        gpdi_sda <:> gpdi_sda,                                                                                                  //  RTC ACCESS
        gpdi_scl <:> gpdi_scl,

        DMAACTIVE <: DMA_NEW.ACTIVE
    );

    timers_memmap TIMERS_Map <@clock_system,!reset> (                                                                           // TIMERS REGISTERS CONTROLLER
        CS <: TIMERS,
        ADDR <: ADDRESS[0,6],
        RENABLE <: READFLAG,
        WENABLE <: WRITEFLAG,
        WDATA <: WRITEDATA
    );

    $$if SIMULATION then
        uint4 audio_l(0);
        uint4 audio_r(0);
    $$end
    audio_memmap AUDIO_Map <@clock_system,!reset> (                                                                             // AUDIO REGISTERS CONTROLLER
        CS <: AUDIO,
        ADDR <: ADDRESS[1,5],
        WDATA <: WRITEDATA,
        WENABLE <: WRITEFLAG,
        audio_l :> audio_l,
        audio_r :> audio_r,
        static8bit <: TIMERS_Map.static16bit[0,8],
        L_ADMA_ACTIVE <: DMA_AUDIO.L_ADMA_ACTIVE,
        L_SAMPLE <: DMA_AUDIO.L_AUDIO_DMA_SAMPLE,
        R_ADMA_ACTIVE <: DMA_AUDIO.R_ADMA_ACTIVE,
        R_SAMPLE <:  DMA_AUDIO.R_AUDIO_DMA_SAMPLE
    );

    video_memmap VIDEO_Map <@clock_system,!reset> (                                                                             // VIDEO REGISTERS AND MEMORY CONTROLLERS
        CS <: VIDEO,
        CS_BM <: BITMAPDIRECT,
        CS_CM <: CMAPDIRECT,
        CS_TM <: TMAPDIRECT,

        video_clock <: $clock_25mhz$,
        gpu_clock <: clock_gpu,
        palette_clock <: clock_palette,
        memoryAddress <: ADDRESS,
        memoryAddress0 <: address0,
        accesssize <: ACCESSSIZE,
        writeData <: WRITEDATA,
        memoryWrite <: WRITEFLAG,

$$if HDMI then
        gpdi_dp :> gpdi_dp,
$$end
$$if VGA then
        video_r  :> video_r,
        video_g  :> video_g,
        video_b  :> video_b,
        video_hs :> video_hs,
        video_vs :> video_vs,
$$end
        staticGenerator <: TIMERS_Map.static16bit[0,10],
        blink <: TIMERS_Map.cursor,

        sdcardlightcolour <: IO_Map.sdcardlightcolour,
$$if not SIMULATION then
        sdcarderror <: IO_Map.sd_error,
$$end
        JOYSTICK <: IO_Map.JOYSTICK,
        CAPSLOCK <: IO_Map.CAPSLOCK,
        NUMLOCK <: IO_Map.NUMLOCK,
        RESETSTATUS <: IO_Map.RESETSTATUS
    );

    uint1   MEMORYBUSY <:: DRAM.BUSY |                                                                                          // CPU MEMORY BUSY FLAG FROM    SDRAM
                           ( ( READFLAG | WRITEFLAG ) & SDRAM ) |                                                               //                              SDRAM READ/WRITE REQUEST
                           ( READFLAG & ( BRAM ) );                                                                             //                              BRAM READ REQUEST
    uint32  READDATA <::        SDRAM ? DRAM.RDATA :                                                                            // READ FROM SDRAM
                         BITMAPDIRECT ? VIDEO_Map.BITMAPreadDataDirect :                                                        // READ FROM FRAMEBUFFERS
                           CMAPDIRECT ? VIDEO_Map.CMAPreadDataDirect :                                                          // READ FROM CHARACTERMAP
                           TMAPDIRECT ? ADDRESS[15,1] ? VIDEO_Map.UTMAPreadDataDirect : VIDEO_Map.LTMAPreadDataDirect :         // READ FROM TILEMAPS
                                 BRAM ? RAM.RDATA :                                                                             // READ FROM BRAM
                               TIMERS ? TIMERS_Map.RDATA :                                                                      // READ FROM TIMERS
                                VIDEO ? VIDEO_Map.readData :                                                                    // READ FROM VIDEO
                                AUDIO ? AUDIO_Map.RDATA :                                                                       // READ FROM AUDIO
                                        IO_Map.RDATA;                                                                           // READ FROM I/O

    PAWSCPU CPU <@clock_cpu,!reset> (                                                                                           // PAWS CPU
        clock_CPUdecoder <: clock_decode,                                                                                       //  100MHz DECODE CLOCK
        clock_cache <: clock_cache,                                                                                             //  100MHz CACHE CLOCK
        memorybusy <: MEMORYBUSY,
        readdata <: READDATA,
        SMTRUNNING <: IO_Map.SMTRUNNING,                                                                                        //  SMT CONTROL FROM I/O
        SMTSTARTPC <: IO_Map.SMTSTARTPC[0,27],
        DMA_AUDIO_REQ <: DMA_AUDIO.REQUEST,
        DMAACTIVE <: DMA_NEW.ACTIVE, DMA_AUDIO_ACTIVE <: DMA_AUDIO.ACTIVE
     );

    dma_new DMA_NEW <@clock_cpu,!reset> (                                                                                       // MINI DMA CONTROLLER
        DMASTART <: CPU.DMASTART,
        MEMORYBUSY <: MEMORYBUSY,                                                                                               //  MEMORY BUSY FLAG
        READDATA <: READDATA,                                                                                                   //  READ RESULT
        DMASOURCE <: IO_Map.DMASOURCE,                                                                                          //  REGISTERS FROM IO MEMORY MAP
        DMASOURCEADD <: IO_Map.DMASOURCEADD,
        DMADEST <: IO_Map.DMADEST,
        DMADESTADD <: IO_Map.DMADESTADD,
        DMACOUNT <: IO_Map.DMACOUNT,
        DMACYCLES <: IO_Map.DMACYCLES,
        DMAMODE <: IO_Map.DMAMODE,
        DMASET <: IO_Map.DMASET
    );

    dma_digital_audio DMA_AUDIO <@clock_cpu,!reset> (                                                                           // ONDEMAND AUDIO DMA CONTROLLER
        START <: CPU.DMA_AUDIO_START,
        MEMORYBUSY <: MEMORYBUSY,                                                                                               //  MEMORY BUSY FLAG
        READDATA <: READDATA,                                                                                                   //  READ RESULT

        L_AUDIO_DMA_STATUS <: AUDIO_Map.L_AUDIO_DMA_STATUS,
        L_AUDIO_DMA_BASE <: AUDIO_Map.L_AUDIO_DMA_BASE,
        L_AUDIO_DMA_LENGTH <: AUDIO_Map.L_AUDIO_DMA_LENGTH,

        R_AUDIO_DMA_STATUS <: AUDIO_Map.R_AUDIO_DMA_STATUS,
        R_AUDIO_DMA_BASE <: AUDIO_Map.R_AUDIO_DMA_BASE,
        R_AUDIO_DMA_LENGTH <: AUDIO_Map.R_AUDIO_DMA_LENGTH,
    );

    CPU.DMAREQ := |IO_Map.DMAMODE;                                                                                              // DMA REQUESTED VIA IO FLAGS
}
